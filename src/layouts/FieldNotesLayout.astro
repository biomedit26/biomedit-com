---
// src/layouts/FieldNotesLayout.astro
// Field Notes homepage/pipeline/investors — see design_handoff_field_notes/README.md.
//
// Structural note: this is a two-tier header, not a single nav bar with
// extra styling. A thin masthead/utility bar sits above the main nav row;
// only the main nav row is sticky on scroll, the masthead scrolls away.
// See README.md "Structural note: Field Notes' nav is two-tier".

import '../styles/tokens.css';

interface Props {
  title: string;
  active?: 'home' | 'about' | 'science' | 'pipeline' | 'products' | 'investors' | 'news';
}
const { title, active } = Astro.props;

const nav = [
  { label: 'Company', href: '/about', key: 'about', enabled: true },
  { label: 'Science', href: '/science', key: 'science', enabled: true },
  { label: 'Pipeline', href: '/pipeline', key: 'pipeline', enabled: true },
  { label: 'Products', href: '/products', key: 'products', enabled: true },
  { label: 'Investors & Partners', href: '/investors-partners', key: 'investors', enabled: true },
  { label: 'News', href: '/news', key: 'news', enabled: true },
];

const year = new Date().getFullYear();
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} · BiomEdit</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=PT+Sans:ital,wght@0,400;0,700;1,400;1,700&family=Fraunces:ital,opsz,wght@1,9..144,500&display=swap"
    rel="stylesheet"
  />
  <style>
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: 'PT Sans', sans-serif;
      color: var(--text-primary);
      background: var(--bg-primary);
      -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; text-decoration: none; }

    /* ---------- masthead (not sticky) ---------- */
    .masthead { background: #FFFFFF; }
    .masthead-inner {
      max-width: 1280px;
      margin: 0 auto;
      padding: 0 40px;
    }
    .masthead-row {
      padding: 0.5rem 0;
      display: flex;
      justify-content: flex-end;
      gap: 28px;
      border-bottom: 1px solid var(--cool-200);
    }
    .masthead-row a {
      font-size: 12px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--text-secondary);
    }
    .masthead-row a:hover { color: var(--text-primary); }

    /* ---------- main nav (sticky) ---------- */
    .main-nav {
      position: sticky;
      top: 0;
      background: #FFFFFF;
      z-index: 10;
    }
    .nav-row {
      position: relative;
      max-width: 1280px;
      margin: 0 auto;
      padding: 1rem 40px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 40px;
    }
    .logo svg { height: 40px; width: auto; display: block; }
    .main-nav nav ul { display: flex; gap: 32px; list-style: none; margin: 0; padding: 0; }
    .main-nav nav li a, .main-nav nav li span {
      font-size: 16px;
      font-weight: 700;
      color: var(--text-primary);
    }
    .main-nav nav li a:hover { color: var(--color-navy); }
    .main-nav nav li a.active {
      color: var(--color-navy);
      text-decoration: underline;
      text-underline-offset: 6px;
      text-decoration-thickness: 2px;
    }
    .main-nav nav li span.disabled { color: var(--cool-400); cursor: not-allowed; }

    .nav-toggle-btn {
      display: none;
      flex-direction: column;
      justify-content: center;
      gap: 0.25rem;
      width: 28px;
      height: 20px;
      cursor: pointer;
    }
    .nav-toggle-line {
      display: block;
      width: 100%;
      height: 2px;
      background: var(--text-primary);
      transition: transform 0.2s ease;
    }

    @media (max-width: 900px) {
      .nav-toggle-btn { display: flex; }

      .main-nav nav {
        display: none;
        position: absolute;
        top: 100%;
        left: 0;
        right: 0;
        background: #FFFFFF;
        border-bottom: 1px solid var(--cool-400);
        padding: 1.5rem 40px;
      }
      .main-nav nav ul { flex-direction: column; align-items: flex-start; gap: 1.25rem; }

      .nav-toggle-input:checked ~ nav { display: flex; }
      .nav-toggle-input:checked ~ .nav-toggle-btn .nav-toggle-line:first-child {
        transform: translateY(3.5px) rotate(45deg);
      }
      .nav-toggle-input:checked ~ .nav-toggle-btn .nav-toggle-line:last-child {
        transform: translateY(-3.5px) rotate(-45deg);
      }
    }

    main { max-width: 1280px; margin: 0 auto; padding: 0 40px; position: relative; }

    /* ---------- footer (light, not the dark site footer) ---------- */
    footer {
      background: #FFFFFF;
      color: var(--cool-600);
      padding: 2.5rem 40px;
      border-top: 1px solid var(--cool-300);
    }
    .footer-inner { max-width: 1280px; margin: 0 auto; }
    .footer-top {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      padding-bottom: 2rem;
    }
    .footer-legal-links { display: flex; gap: 32px; flex-wrap: wrap; }
    .footer-legal-links a, .footer-social a {
      font-size: 13px;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--cool-600);
    }
    .footer-legal-links a:hover, .footer-social a:hover { color: var(--color-navy); }
    .footer-divider { border-top: 1px solid var(--cool-300); }
    .footer-bottom {
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
      padding-top: 2rem;
    }
    .footer-wordmark { height: 18px; width: auto; display: block; }
    .footer-copyright { font-size: 13px; color: var(--cool-600); }
  </style>
</head>
<body>
  <!-- Shared logo sprite (same mark used in src/layouts/SiteLayout.astro) —
       stands in for the handoff's assets/logo.svg, which isn't in this repo. -->
