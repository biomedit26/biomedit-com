  <header>
    <div class="masthead">
      <div class="masthead-inner">
        <div class="masthead-row">
          <a href="#">Careers</a>
          <a href="#">Contact Us</a>
        </div>
      </div>
    </div>
    <div class="main-nav">
      <div class="nav-row">
        <a href="/home" class="logo" aria-label="BiomEdit home">
          <svg viewBox="0 0 164 40"><use href="#fn-biomedit-logo" xlink:href="#fn-biomedit-logo"></use></svg>
        </a>
        <input type="checkbox" id="nav-toggle" class="nav-toggle-input" hidden />
        <label for="nav-toggle" class="nav-toggle-btn" aria-label="Toggle menu">
          <span class="nav-toggle-line"></span>
          <span class="nav-toggle-line"></span>
        </label>
        <nav aria-label="Primary">
          <ul>
            {nav.map((item) => (
              item.enabled ? (
                <li><a href={item.href} class={active === item.key ? 'active' : ''}>{item.label}</a></li>
              ) : (
                <li><span class="disabled">{item.label}</span></li>
              )
            ))}
          </ul>
        </nav>
      </div>
    </div>
  </header>
  <main>
    <slot />
  </main>
  <footer>
    <div class="footer-inner">
      <div class="footer-top">
        <div class="footer-legal-links">
          <a href="/privacy-policy">Privacy Policy</a>
          <a href="/legal">Legal</a>
          <a href="/cookies">Cookies</a>
          <a href="/faqs">FAQs</a>
        </div>
        <a href="https://www.linkedin.com/company/biomedit" target="_blank" rel="noopener">Follow on LinkedIn</a>
      </div>
      <div class="footer-divider"></div>
      <div class="footer-bottom">
        <svg class="footer-wordmark" viewBox="0 0 164 40" aria-label="BiomEdit"><use href="#fn-biomedit-logo" xlink:href="#fn-biomedit-logo"></use></svg>
        <span class="footer-copyright">Copyright {year}</span>
      </div>
    </div>
  </footer>
</body>
</html>
