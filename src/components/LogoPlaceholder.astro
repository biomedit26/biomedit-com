---
// Generic stand-in "logo" mark for partner/investor/launch-partner lockups
// before real logo assets are supplied — a bordered chip with an abstract
// colored mark + wordmark bars, not meant to resemble any real brand.
// One placeholder per category (color-coded), reused for every name in
// that category until real logos are dropped in.

interface Props {
  color: 'navy' | 'teal' | 'orange';
  size?: 'lg' | 'md' | 'sm';
}
const { color, size = 'md' } = Astro.props;
const dims = { lg: { w: 152, h: 52 }, md: { w: 124, h: 44 }, sm: { w: 104, h: 36 } }[size];
---
<svg
  class={`logo-placeholder is-${size}`}
  viewBox={`0 0 ${dims.w} ${dims.h}`}
  width={dims.w}
  height={dims.h}
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
>
  <rect x="0.5" y="0.5" width={dims.w - 1} height={dims.h - 1} rx="6" fill="var(--bg-secondary)" stroke="var(--border-color)" />
  <circle cx={dims.h / 2} cy={dims.h / 2} r={dims.h * 0.26} fill={`var(--color-${color})`} opacity="0.85" />
  <rect x={dims.h * 0.9} y={dims.h * 0.32} width={dims.w - dims.h * 1.15} height={dims.h * 0.14} rx={dims.h * 0.07} fill={`var(--color-${color})`} opacity="0.5" />
  <rect x={dims.h * 0.9} y={dims.h * 0.58} width={(dims.w - dims.h * 1.15) * 0.65} height={dims.h * 0.14} rx={dims.h * 0.07} fill={`var(--color-${color})`} opacity="0.3" />
</svg>
