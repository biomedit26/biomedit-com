---
// Usage:
// <StatBlock stats={[{ value: '23', label: 'Doctoral degrees' }, ...]} />
//
// 4-up horizontal stat bar, divided by hairlines — e.g. Field Notes homepage
// "Doctoral degrees / Patents / Publications / Years experience" row.

interface Stat {
  value: string;
  label: string;
}

interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---
<div class="stat-block">
  {stats.map((s) => (
    <div class="stat">
      <div class="stat-value">{s.value}</div>
      <div class="stat-label">{s.label}</div>
    </div>
  ))}
</div>

<style>
  .stat-block {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
  }
  .stat {
    padding: 0 24px;
    border-right: 1px solid var(--cool-400);
  }
  .stat:first-child { padding-left: 0; }
  .stat:last-child { padding-right: 0; border-right: none; }
  .stat-value { font-size: var(--text-h3); font-weight: 700; color: var(--text-primary); margin-bottom: 0.5rem; }
  .stat-label { font-size: 11px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--text-tertiary); }

  @media (max-width: 700px) {
    .stat-block { grid-template-columns: repeat(2, 1fr); gap: 1.5rem 0; }
    .stat { border-right: none; padding: 0 !important; }
  }
</style>
