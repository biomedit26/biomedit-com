---
// Shared "below the hero" content for both Field Notes homepage variants —
// identical on Homepage and Homepage Alt per design_handoff_field_notes/README.md,
// except the "Who we are" section's watermark/divider treatment, which
// differs based on whether it's sitting directly under a full-bleed dark
// hero (video variant, flowing-e watermark) or a light static one (alt
// variant, cool-600 divider only — its hero already carries the watermark).
//
// Photos: the handoff references real BiomEdit photography
// (pastured-poultry.jpg, lab-scientist-vertical.jpg, white-broiler-closeup.jpg)
// that isn't in this repo. Standing in with the existing sample images
// until the real assets are dropped in.

import { getCollection } from 'astro:content';
import ModuleDarkText from './modules/ModuleDarkText.astro';
import ModuleBlueText from './modules/ModuleBlueText.astro';
import FloatingCard from './modules/FloatingCard.astro';
import StatBlock from './StatBlock.astro';
import CTALink from './CTALink.astro';
import Badge from './Badge.astro';

interface Props {
  heroVariant: 'video' | 'alt';
}
const { heroVariant } = Astro.props;

const pipelineRows = [
  {
    category: 'Infectious Disease',
    codes: [
      { code: 'CPerf LLV*', href: '/products' },
      { code: 'BE-118' },
      { code: 'BE-119' },
      { code: 'BEX1 (BiomElix® One)' },
    ],
    color: 'teal' as const,
  },
  { category: 'Sustainability', codes: [{ code: 'BE-017' }, { code: 'BE-117' }], color: 'green' as const },
  { category: 'Chronic Disease', codes: [{ code: 'BE-105' }, { code: 'BE-122' }], color: 'amber' as const },
];

const stats = [
  { value: '20', label: 'Doctoral degrees' },
  { value: '9', label: 'Patents' },
  { value: '450+', label: 'Peer-reviewed publications' },
  { value: '200+', label: 'Years of combined leadership experience' },
];

const categoryLabels: Record<'press-release' | 'article' | 'event' | 'in-the-news' | 'videos-podcasts', string> = {
  'press-release': 'Press Release',
  article: 'Article',
  event: 'Event',
  'in-the-news': 'In the News',
  'videos-podcasts': 'Videos & Podcasts',
};
const categoryColors: Record<'press-release' | 'article' | 'event' | 'in-the-news' | 'videos-podcasts', 'teal' | 'green' | 'amber' | 'navy' | 'orange'> = {
  'press-release': 'teal',
  article: 'green',
  event: 'amber',
  'in-the-news': 'navy',
  'videos-podcasts': 'orange',
};
const news = (await getCollection('news'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

// Order matches the sequence partners appear in across the three groups
// on /investors-partners (Investors, then Partnerships & Grants, then
// Launch Partners) — just without the group labels. Nutreco appears in
// both groups there; shown once here, at its first-appearance position.
const partners = [
  { name: 'Anterra Capital', logo: '/images/investor-partner/anterra-capital.svg', href: 'https://anterracapital.com/' },
  { name: 'Viking', logo: '/images/investor-partner/viking.svg', href: 'https://vikingglobal.com/' },
  { name: 'Nutreco', logo: '/images/investor-partner/nutreco.svg', href: 'https://www.nutreco.com/en/' },
  { name: 'AgriZero', logo: '/images/investor-partner/agrizero.svg', href: 'https://www.agrizero.nz/' },
  { name: 'Betagro Ventures', logo: '/images/investor-partner/betagro-ventures.png', href: 'https://uat.betagroventures.com/en' },
  { name: 'Elevate Ventures', logo: '/images/investor-partner/elevate-ventures.png', href: 'https://elevateventures.com/' },
  { name: 'Bill & Melinda Gates Foundation', logo: '/images/investor-partner/bill-and-melinda-gates-foundation.svg', href: 'https://www.gatesfoundation.org/' },
  { name: 'Global Methane Hub', logo: '/images/investor-partner/global-methane-hub.png', href: 'https://www.globalmethanehub.org/' },
  { name: 'Bezos Earth Fund', logo: '/images/investor-partner/bezos-earth-fund.webp' },
  { name: 'USDA', logo: '/images/investor-partner/usda-icon.svg', href: 'https://www.usda.gov/' },
  { name: 'NIH', logo: '/images/investor-partner/nih-icon.png', href: 'https://www.nih.gov/' },
  { name: 'Elanco', logo: '/images/investor-partner/elanco.svg', href: 'https://www.elanco.com/us' },
  { name: 'Ginkgo Bioworks', logo: '/images/investor-partner/ginkgo-bioworks.svg', href: 'https://www.ginkgo.bio/' },
  { name: 'Ferment', logo: '/images/investor-partner/ferment.png', small: true, href: 'https://www.ferment.co/' },
];
---
<section class={`who-we-are ${heroVariant === 'video' ? 'no-divider' : ''}`}>
  {heroVariant === 'video' && (
    <img class="who-we-are-watermark" src="/images/flowing-e-background.svg" alt="" />
  )}
  <div class="who-we-are-grid">
    <div class="who-we-are-text">
      <h2>Who we are</h2>
      <p class="lead">At BiomEdit, we develop engineered microbial biologics for animal health. Located at 16Tech inside the laboratory facilities of the <a href="https://www.indianabiosciences.org/" target="_blank" rel="noopener">Indiana Biosciences Research Institute</a>, our experienced team works together to advance our <a href="/science">Programmable Veterinary Biologics<sup>&trade;</sup> platform</a>. From scientists and researchers to product developers and regulatory experts, we are building a new category in animal health.</p>
      <p class="lead"><strong>Our goal:</strong> better outcomes for animals, farmers, and veterinarians through precise, practical solutions.</p>
      <CTALink href="/science">Discover our science</CTALink>
    </div>
    <div class="who-we-are-image">
      <img src="/images/biomedit-scientists-in-lab.png" alt="BiomEdit scientists working in the lab" />
    </div>
  </div>
</section>

<section class="how-we-build">
  <div class="how-we-build-intro">
    <div class="how-we-build-label">
      <h2>What we do</h2>
    </div>
    <div class="how-we-build-body">
      <p>Our platform combines strain engineering, computational biology, and product development. We engineer beneficial bacterial strains to deliver specific biologic functions that address important animal health challenges. Our microbial strain library consists of strains selected from the species we intend to treat.</p>
      <p><strong>The result</strong>: products designed to fit into existing care and management practices in animal health.</p>
    </div>
  </div>

  <div class="how-we-build-grid">
    <div class="build-card">
      <div class="build-icon" style="--icon-color:var(--color-navy);">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="6"/><path d="M8.5 13.5L6.5 21l5.5-3 5.5 3-2-7.5"/></svg>
      </div>
      <h3>Strain Engineering</h3>
      <p><a href="/products">CPerf LLV* (formerly known as BE-101)</a>, is our lead product from our platform, developed for the prevention of necrotic enteritis in poultry. It establishes a regulatory and development path that can be applied to additional products.</p>
      <p>BiomElix&reg; One (BEX1) is a second proof point, acquired through Folium Science and approved for use in Brazil to reduce Salmonella in poultry.</p>
    </div>
    <div class="build-card">
      <div class="build-icon" style="--icon-color:var(--color-teal);">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="6" y="6" width="12" height="12" rx="2"/><rect x="10" y="10" width="4" height="4"/><path d="M9 3v3M15 3v3M9 18v3M15 18v3M3 9h3M3 15h3M18 9h3M18 15h3"/></svg>
      </div>
      <h3>Computational Biology</h3>
      <p>We use sequencing, computational biology and AI/ML to characterize microbial communities, identify candidate strains, design payloads, and inform product design and development.</p>
    </div>
    <div class="build-card">
      <div class="build-icon" style="--icon-color:var(--color-green);">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="9" width="10" height="6" rx="3"/><path d="M7 12H4M17 12h3M9 9V6M15 9V6M9 15v3M15 15v3"/></svg>
      </div>
      <h3>Proprietary Microbial Strain Library</h3>
      <p>Our microbial strain library spans a wide range of species, giving us a broad starting point for identifying and engineering strains suited to specific species, targets, and applications.</p>
    </div>
  </div>

  <div class="how-we-build-cta">
    <CTALink href="/science">Explore our science</CTALink>
  </div>
</section>

<div class={`pipeline-brief-wrap ${heroVariant === 'video' ? 'clears-watermark' : ''}`}>
  <FloatingCard>
    <div class="pipeline-brief-head">
      <div>
        <h2>Pipeline</h2>
        <p class="pipeline-subhead">From discovery to commercial launch.</p>
      </div>
      <CTALink href="/pipeline">View all programs</CTALink>
    </div>

    <div class="lead-program">
      <div class="lead-program-text">
        <p class="eyebrow">Lead Program — Infectious Disease</p>
        <h3>CPerf LLV*</h3>
        <p class="lead-p">Our lead Programmable Veterinary Biologic was developed to prevent necrotic enteritis in poultry through targeted delivery of nanobodies against C. perfringens toxins.</p>
        <CTALink href="/pipeline">Learn more</CTALink>
        <p class="lead-highlight">Conditional USDA licensure received. Commercial launch Q4 2026.</p>
      </div>
      <div class="lead-program-image">
        <img src="/images/boiler-hen-in-housing-single.jpg" alt="Pastured poultry raised without systemic antibiotics" />
      </div>
    </div>

    <div class="pipeline-rows">
      {pipelineRows.map((row) => (
        <div class="pipeline-row">
          <span class="row-category" style={`color:var(--color-${row.color});`}>{row.category}</span>
          <span class="row-codes">
            {row.codes.map((c, i) => (
              <>
                {i > 0 && ', '}
                {c.href ? <a href={c.href} class="row-code-link">{c.code}</a> : c.code}
              </>
            ))}
          </span>
          <CTALink href="/pipeline">Details</CTALink>
        </div>
      ))}
    </div>
  </FloatingCard>
</div>

<ModuleDarkText
  quote
  noDivider
  topDivider
  paragraphs={['"We believe engineered microbes will become an important therapeutic modality across species. Our job is to turn that potential into products that work in the real world."']}
  attribution="Aaron Schacht, CEO, BiomEdit"
  photos={[
    { src: '/images/istockphoto-1305316712-1024x1024.jpg', alt: 'Veterinarian using a stethoscope to examine a cat', ratio: '3/2' },
    { src: '/images/engin-akyurt-GBszMrOChZ8-unsplash.jpg', alt: 'Close-up of livestock', ratio: '2/3' },
  ]}
/>

<section class="investors-teaser">
  <div class="investors-card">
    <div class="investors-grid">
      <div class="investors-label">
        <h2>Backed by leaders in life sciences and animal health.</h2>
      </div>
      <div class="investors-body">
        <p>We work with investors, research organizations, funding agencies, and commercial partners to advance our Programmable Veterinary Biologics<sup>&trade;</sup> programs from discovery through commercialization.</p>
        <div class="logo-grid">
          {partners.map((p) => (
            p.href ? (
              <a class={`logo-cell ${p.small ? 'is-small' : ''}`} href={p.href} target="_blank" rel="noopener" aria-label={p.name}>
                <img src={p.logo} alt={p.name} loading="lazy" />
              </a>
            ) : (
              <div class={`logo-cell ${p.small ? 'is-small' : ''}`}>
                <img src={p.logo} alt={p.name} loading="lazy" />
              </div>
            )
          ))}
        </div>
        <CTALink href="/investors-partners">Partner with us</CTALink>
      </div>
    </div>
  </div>
</section>

<section class="mission">
  <h2>Our experience behind the science.</h2>
  <p>At BiomEdit, our team combines expertise in microbiology, computational biology, strain engineering, product development, regulatory affairs, and commercialization. Many have worked together for years, delivering results across human and animal health, multiple organizations, products, and species.</p>
</section>

<section class="stats-section">
  <StatBlock stats={stats} align="center" divider={false} />
  <div class="stats-cta"><CTALink href="/team">Meet our team</CTALink></div>
</section>

<section id="news" class="news-section">
  <div class="news-head">
    <h2>Latest from BiomEdit.</h2>
    <CTALink href="/news">View all news</CTALink>
  </div>
  <div class="news-list">
    {news.map((post) => (
      <a href={`/news/${post.slug}`} class="news-row">
        <Badge color={categoryColors[post.data.category]}>{categoryLabels[post.data.category]}</Badge>
        <span class="news-headline">{post.data.title}</span>
        <span class="news-date">
          {post.data.date.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' })}
        </span>
      </a>
    ))}
  </div>
</section>

<section class="footnote">
  <p>*Clostridium Perfringens Alpha Toxin and NetB Antibody Fragment, Live Limosilactobacillus Vector</p>
</section>

<ModuleBlueText
  heading="Interested in working with BiomEdit?"
  ctaLabel="Connect with us"
  ctaHref="/contact-us"
  noDivider
  image="/images/jonakoh-_-NPDRGf0w1lw-unsplash.jpg"
  zoom={1.05}
  imagePosition="50% 50%"
  blendMode="overlay"
  imageOpacity={0.45}
/>

<style>
  .who-we-are {
    position: relative;
    margin-top: 24px;
    padding-top: 24px;
    border-top: 1px solid var(--cool-500);
  }
  .who-we-are.no-divider { margin-top: 0; border-top: none; padding-top: 0; }
  .who-we-are-watermark {
    position: absolute;
    top: 4rem;
    left: 0;
    right: 0;
    bottom: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    opacity: 0.6;
    pointer-events: none;
    z-index: 0;
  }
  .who-we-are-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: center;
    padding-bottom: 4rem;
  }

  .how-we-build {
    padding: 24px 0 4rem;
    border-top: 1px solid var(--cool-500);
  }
  .how-we-build-intro {
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 48px;
    margin-bottom: 3rem;
  }
  .how-we-build-label h2 { font-size: var(--text-h5); margin: 0; }
  .how-we-build-body p { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0 0 1rem; max-width: 680px; }
  .how-we-build-body p:last-child { margin-bottom: 0; }

  .how-we-build-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 28px; margin-bottom: 2.5rem; }
  .build-card {
    background: #FFFFFF;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 2.25rem 28px;
    text-align: center;
  }
  .build-icon {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--icon-color) 12%, transparent);
    color: var(--icon-color);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem;
  }
  .build-icon svg { width: 32px; height: 32px; }
  .build-card h3 { font-size: 17px; margin: 0 0 0.75rem; }
  .build-card p { font-size: var(--text-body); line-height: 1.5; color: var(--text-secondary); margin: 0; }

  .how-we-build-cta { padding-top: 0.5rem; }

  @media (max-width: 860px) {
    .how-we-build-intro { grid-template-columns: 1fr; gap: 1.5rem; }
    .how-we-build-grid { grid-template-columns: 1fr; }
  }

  .investors-teaser {
    padding: 24px 0 2rem;
    border-top: 1px solid var(--cool-500);
  }
  .investors-card {
    background: #FFFFFF;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 3rem 40px;
  }
  .investors-grid { display: grid; grid-template-columns: 280px 1fr; gap: 48px; }
  .investors-label h2 { font-size: var(--text-h5); margin: 0; }
  .investors-body { min-width: 0; }
  .investors-body p { font-size: var(--text-body); line-height: 1.5; color: var(--text-secondary); margin: 0 0 1.75rem; max-width: 640px; }
  .logo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(110px, 1fr));
    gap: 28px 32px;
    align-items: center;
    margin-bottom: 2rem;
    animation: logos-fade-in 0.8s ease both;
  }
  .logo-cell { display: flex; align-items: center; justify-content: flex-start; height: 36px; text-decoration: none; }
  .logo-cell:hover img { opacity: 0.7; }
  .logo-cell img { display: block; max-width: 100%; max-height: 100%; object-fit: contain; }
  .logo-cell.is-small img { max-height: 50%; }
  @keyframes logos-fade-in {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @media (prefers-reduced-motion: reduce) {
    .logo-grid { animation: none; }
  }

  @media (max-width: 860px) {
    .investors-grid { grid-template-columns: 1fr; gap: 1.5rem; }
  }

  .who-we-are-text h2 { font-size: var(--text-h5); margin: 0 0 1.25rem; }
  .who-we-are-text .lead { font-weight: 500; font-size: 19px; line-height: 1.55; color: var(--text-primary); margin: 0 0 1.5rem; }
  .who-we-are-image img { display: block; width: 100%; height: auto; border-radius: 6px; }

  @media (max-width: 860px) {
    .who-we-are-grid { grid-template-columns: 1fr; gap: 2rem; }
  }

  .pipeline-brief-wrap { padding: 0 0 0.5rem; }
  .pipeline-brief-wrap.clears-watermark { margin-top: 4rem; }
  .pipeline-brief-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 2rem; gap: 16px; flex-wrap: wrap; }
  .pipeline-brief-head h2 { font-size: var(--text-h5); margin: 0; }
  .pipeline-subhead { font-size: var(--text-body); color: var(--text-secondary); margin: 0.35rem 0 0; }

  .lead-program {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: stretch;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-top: 4px solid var(--color-navy);
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 2.5rem;
  }
  .lead-program-text { padding: 2.5rem 40px; }
  .lead-program .eyebrow { font-size: var(--text-eyebrow); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-teal); margin: 0 0 0.5rem; }
  .lead-program h3 { font-size: var(--text-h4); line-height: 1.2; margin: 0 0 1rem; }
  .lead-p { font-size: var(--text-body); line-height: 1.5; color: var(--text-secondary); margin: 0 0 1rem; }
  .lead-p:last-of-type { margin-bottom: 1.5rem; }
  .lead-highlight {
    margin: 1.5rem 0 0;
    padding: 1rem 1.25rem;
    background: var(--bg-primary);
    border-left: 3px solid var(--color-teal);
    border-radius: 4px;
    font-weight: 700;
    font-size: var(--text-body);
    line-height: 1.5;
    color: var(--text-primary);
  }
  .lead-program-image img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .pipeline-rows { display: flex; flex-direction: column; }
  .pipeline-row {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    gap: 24px;
    align-items: center;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--cool-400);
  }
  .pipeline-row:last-child { border-bottom: none; }
  .row-category { font-size: 16px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
  .row-codes { font-size: 16px; font-weight: 700; color: var(--text-primary); }
  .row-code-link { color: var(--color-navy); text-decoration: underline; text-underline-offset: 2px; }
  .row-code-link:hover { opacity: 0.75; }

  .mission { text-align: center; padding: 1.5rem 40px 0; max-width: 820px; margin: 0 auto; }
  .mission h2 { font-size: var(--text-h4); margin: 0 0 1.5rem; }
  .mission p { font-size: var(--text-body); color: var(--text-primary); line-height: 1.75; margin: 0; }

  .stats-section { padding: 3.5rem 40px; border-bottom: 1px solid var(--cool-500); }
  .stats-section :global(.stat-label) { font-size: 16px; }
  .stats-cta { display: flex; justify-content: center; margin-top: 2.5rem; }

  .news-section { padding: 3.5rem 40px 4rem; }

  .footnote { padding: 0 40px 2rem; }
  .footnote p { font-size: 12px; line-height: 1.6; color: var(--text-secondary); margin: 0; }
  .news-head { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 2rem; gap: 16px; flex-wrap: wrap; }
  .news-head h2 { font-size: var(--text-h5); margin: 0; }
  .news-list { display: flex; flex-direction: column; }
  .news-row {
    display: grid;
    grid-template-columns: 140px 1fr auto;
    gap: 24px;
    align-items: baseline;
    padding: 1rem 0;
    border-bottom: 1px solid var(--cool-500);
    text-decoration: none;
  }
  .news-row:last-child { border-bottom: none; }
  .news-row:hover .news-headline { color: var(--color-navy); }
  .news-headline { font-size: 15px; font-weight: 700; color: var(--text-primary); }
  .news-date { font-size: 16px; color: var(--text-primary); white-space: nowrap; }

  @media (max-width: 860px) {
    .lead-program { grid-template-columns: 1fr; }
    .lead-program-image img { min-height: 220px; }
    .pipeline-row, .news-row { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
