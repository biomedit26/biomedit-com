---
import ModuleSection from './ModuleSection.astro';

interface Props {
  heading?: string;
  paragraphs: string[];
  ctaLabel?: string;
  ctaHref?: string;
  label?: string;
  // "quote" variant: renders paragraphs[0] as a large Fraunces-italic pull
  // quote instead of heading + body copy. Mirrors ModuleDarkText's quote
  // variant, sized for a light background.
  quote?: boolean;
  attribution?: string;
  noDivider?: boolean;
  // 'serif' (default): Fraunces italic, matching the site's other pull-quotes.
  // 'sans': PT Sans italic instead, for a lighter, less formal quote treatment.
  quoteFont?: 'serif' | 'sans';
  // Attribution byline size. 'sm' (default, 13px), 'md' (14px), or 'lg'
  // (--text-h6, two steps up the type scale from 'md').
  attributionSize?: 'sm' | 'md' | 'lg';
  // Quote text size. 'md' (default, --text-h6) or 'lg' (--text-h4, two
  // steps up the type scale) for a quote that needs more visual weight.
  quoteSize?: 'md' | 'lg';
}
const {
  heading, paragraphs, ctaLabel, ctaHref, label, quote = false, attribution, noDivider = false,
  quoteFont = 'serif', attributionSize = 'sm', quoteSize = 'md',
} = Astro.props;
---
<ModuleSection label={label} noDivider={noDivider}>
  <div class="text-wrap">
    <div class="text-col">
      {quote ? (
        <>
          <p class={`quote ${quoteFont === 'sans' ? 'is-sans' : ''} ${quoteSize === 'lg' ? 'is-lg' : ''}`} set:html={paragraphs[0]} />
          {attribution && <cite class={`quote-cite ${attributionSize === 'md' ? 'is-md' : ''} ${attributionSize === 'lg' ? 'is-lg' : ''} ${quoteFont === 'sans' ? 'is-sans' : ''}`}>{attribution}</cite>}
        </>
      ) : (
        <>
          {heading && <h2>{heading}</h2>}
          {paragraphs.map((p) => <p set:html={p} />)}
        </>
      )}
      {ctaLabel && ctaHref && (
        <a class="cta" href={ctaHref}>
          {ctaLabel}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      )}
    </div>
  </div>
</ModuleSection>

<style>
  .text-wrap { padding: 1.5rem 0 6rem; }
  .text-col { max-width: 640px; margin: 0 auto; text-align: center; }
  .text-col h2 { font-size: var(--text-h5); margin: 0 0 1.5rem; }
  .text-col p { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0 0 1.5rem; }
  .text-col p:last-of-type { margin-bottom: 2rem; }
  .cta {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 16px; font-weight: 700; color: var(--color-navy);
    text-decoration: none; border-bottom: 1px solid var(--color-navy); padding-bottom: 0.25rem;
  }
  .cta:hover { opacity: 0.75; }
  .cta svg { width: 14px; height: 14px; }

  .text-col p.quote {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-size: var(--text-h6);
    line-height: 1.5;
    color: var(--color-navy);
    margin: 0;
  }
  .text-col p.quote.is-lg { font-size: var(--text-h4); }
  .text-col p.quote.is-sans {
    font-family: 'PT Sans', sans-serif;
    font-style: italic;
    font-weight: 700;
  }
  .quote-cite {
    display: block;
    margin-top: 1.25rem;
    font-style: normal;
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text-tertiary);
  }
  .quote-cite.is-md { font-size: 14px; }
  .quote-cite.is-lg { font-size: var(--text-h6); }
  .quote-cite.is-sans { font-weight: 400; }

  @media (max-width: 860px) {
    .text-wrap { padding: 1rem 0 4.5rem; }
  }
</style>
