---
// Usage:
// <EntryList label="Key Awards & Honors" items={[{ title: '...', description: '...' }, ...]} />
//
// New pattern — title + description, repeated as a divided list within a
// labeled column. First used for Investors' Awards & Grants section
// (two of these side by side).

interface Item {
  title: string;
  description: string;
}

interface Props {
  label: string;
  items: Item[];
  tone?: 'default' | 'onDark';
}

const { label, items, tone = 'default' } = Astro.props;
---
<div class={`entry-list ${tone === 'onDark' ? 'is-on-dark' : ''}`}>
  <h3 class="entry-list-label">{label}</h3>
  <div class="entries">
    {items.map((item) => (
      <div class="entry">
        <div class="entry-title">{item.title}</div>
        <p class="entry-description">{item.description}</p>
      </div>
    ))}
  </div>
</div>

<style>
  .entry-list-label { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--text-tertiary); margin: 0 0 1rem; }
  .entries { display: flex; flex-direction: column; }
  .entry { padding: 1rem 0; border-bottom: 1px solid var(--cool-500); }
  .entry:last-child { border-bottom: none; }
  .entry-title { font-size: 14px; font-weight: 700; color: var(--text-primary); margin-bottom: 0.25rem; }
  .entry-description { font-size: 13px; line-height: 1.6; color: var(--text-primary); margin: 0; }

  .entry-list.is-on-dark .entry-list-label { color: var(--cool-400); }
  .entry-list.is-on-dark .entry { border-bottom-color: var(--cool-600); }
  .entry-list.is-on-dark .entry-title { color: #FFFFFF; }
  .entry-list.is-on-dark .entry-description { color: var(--cool-300); }
</style>
