---
import ModuleSection from './ModuleSection.astro';

interface Props {
  heading: string;
  paragraphs: string[];
  ctaLabel?: string;
  ctaHref?: string;
  // Omit to render a 3:2 gray placeholder box instead of a real image.
  image?: { src: string; alt: string };
  label?: string;
  // Grid column widths, e.g. "1fr 2fr" to narrow the image column to 1/3
  // width. Defaults to an even 1fr/1fr split.
  columns?: string;
}
const { heading, paragraphs, ctaLabel, ctaHref, image, label, columns = '1fr 1fr' } = Astro.props;
---
<ModuleSection label={label}>
  <div class="grid" style={`grid-template-columns:${columns};`}>
    <div class="image-col">
      {image ? <img src={image.src} alt={image.alt} /> : <div class="image-placeholder" aria-hidden="true"></div>}
    </div>
    <div class="text-col">
      <h2>{heading}</h2>
      {paragraphs.map((p) => <p set:html={p} />)}
      {ctaLabel && ctaHref && (
        <a class="cta" href={ctaHref}>
          {ctaLabel}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </a>
      )}
      <slot />
    </div>
  </div>
</ModuleSection>

<style>
  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: start;
    padding: 0 0 6rem;
  }
  .image-col img { display: block; width: 100%; height: auto; border-radius: 4px; }
  .image-placeholder { width: 100%; aspect-ratio: 3 / 2; background: var(--cool-300); border-radius: 4px; }
  .text-col h2 { font-size: var(--text-h5); margin: 0 0 1.5rem; }
  .text-col p { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0 0 1.5rem; }
  .cta {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 16px; font-weight: 700; color: var(--color-navy);
    text-decoration: none; border-bottom: 1px solid var(--color-navy); padding-bottom: 0.25rem;
  }
  .cta:hover { opacity: 0.75; }
  .cta svg { width: 14px; height: 14px; }

  @media (max-width: 860px) {
    .grid { grid-template-columns: 1fr; gap: 2rem; }
  }
</style>
