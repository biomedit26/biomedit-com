---
// Usage:
// <FactList items={[{ value: '1st', paragraph: '...', color: 'navy' }, ...]} />
//
// New pattern — big number/label (fixed-width column) + paragraph, repeated
// as a divided list. Distinct from StatBlock's 4-up horizontal layout.
// First used for Investors' "new category" fact list.

interface Item {
  value: string;
  paragraph: string;
  color?: 'navy' | 'teal' | 'orange' | 'green' | 'amber';
  valueSize?: 'h4' | 'h5' | 'text';
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---
<div class="fact-list">
  {items.map((item) => (
    <div class="fact-row">
      <div
        class={`fact-value is-${item.valueSize || 'h4'}`}
        style={item.color ? `color:var(--color-${item.color});` : ''}
      >
        {item.value}
      </div>
      <p class="fact-paragraph">{item.paragraph}</p>
    </div>
  ))}
</div>

<style>
  .fact-list { display: flex; flex-direction: column; }
  .fact-row {
    display: grid;
    grid-template-columns: 120px 1fr;
    gap: 24px;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--cool-500);
  }
  .fact-row:last-child { border-bottom: none; }
  .fact-value { font-weight: 700; color: var(--text-primary); line-height: 1; }
  .fact-value.is-h4 { font-size: var(--text-h4); }
  .fact-value.is-h5 { font-size: var(--text-h5); line-height: 1.3; }
  .fact-value.is-text { font-size: 16px; line-height: 1.3; }
  .fact-paragraph { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0; }

  @media (max-width: 700px) {
    .fact-row { grid-template-columns: 1fr; gap: 0.5rem; }
  }
</style>
