---
// Usage:
// <FloatingCard><h2>...</h2></FloatingCard>
//
// A white, 6px-radius card that floats on the page's grey background —
// distinct from a normal full-bleed section background. First formalized
// for Field Notes' "The pipeline, in brief" module; generic enough to
// reuse anywhere a module needs to visually lift off the page background
// rather than blend into it.

interface Props {
  label?: string;
}
const { label } = Astro.props;
---
<div class="floating-card">
  {label && <p class="overline card-label">{label}</p>}
  <slot />
</div>

<style>
  .floating-card {
    background: #FFFFFF;
    border-radius: 6px;
    padding: 2.5rem 40px;
  }
  .card-label {
    margin: 0 0 1.5rem;
  }

  @media (max-width: 700px) {
    .floating-card { padding: 1.5rem 24px; }
  }
</style>
