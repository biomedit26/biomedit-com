---
// Shared wrapper for any module that needs to break out of the page's
// max-width container and span the full viewport width with a solid
// background color — used by ModuleDark12, ModuleDarkText, and
// ModuleBlueText.

interface Props {
  background: string; // any CSS color value, e.g. "var(--cool-800)" or "var(--color-navy)"
  // Optional decorative background image, blended into `background` via
  // background-blend-mode rather than layered on top — this tints a
  // grayscale/white source graphic into the band's own color family
  // instead of showing its original colors, so it reads as a subtle
  // textural pattern rather than a separate image.
  image?: string;
  imageSize?: string; // e.g. "220% auto" to show a zoomed-in crop
  imagePosition?: string;
  blendMode?: string;
}
const { background, image, imageSize = '220% auto', imagePosition = 'center', blendMode = 'overlay' } = Astro.props;
const bandStyle = image
  ? `background-color:${background};background-image:url(${image});background-size:${imageSize};background-position:${imagePosition};background-repeat:no-repeat;background-blend-mode:${blendMode};`
  : `background:${background};`;
---
<div class="full-bleed" style={bandStyle}>
  <div class="full-bleed-inner">
    <slot />
  </div>
</div>

<style>
  .full-bleed {
    width: 100vw;
    position: relative;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
  }
  .full-bleed-inner {
    max-width: 1200px;
    margin: 0 auto;
    padding: 5rem 40px;
  }
  @media (max-width: 860px) {
    .full-bleed-inner {
      padding: 3.5rem 40px;
    }
  }
</style>
