---
// Usage:
// <Button color="navy" variant="filled" href="/platform">See the platform</Button>
// <Button color="teal" variant="outline">Request the deck</Button>

interface Props {
  color?: 'navy' | 'teal' | 'orange' | 'green' | 'amber';
  variant?: 'filled' | 'outline';
  shape?: 'default' | 'pill';
  href?: string;
}

const { color = 'navy', variant = 'filled', shape = 'default', href } = Astro.props;
const Tag = href ? 'a' : 'button';

const colorVar = `var(--color-${color})`;
---
<Tag
  href={href}
  class={`btn btn-${variant} btn-${color} ${shape === 'pill' ? 'btn-pill' : ''}`}
  style={
    variant === 'filled'
      ? `background:${colorVar};`
      : `border-color:${colorVar};color:${colorVar};`
  }
>
  <slot />
</Tag>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border-radius: 4px;
    padding: 1rem 24px;
    font-family: 'PT Sans', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    border: 1.5px solid transparent;
  }
  .btn-filled {
    color: #fff;
    border: none;
  }
  /* White fails AA contrast on amber's light background (2.15:1) — dark
     text is the only accessible option at this fill color. */
  .btn-filled.btn-amber {
    color: var(--text-primary);
  }
  .btn-outline {
    background: var(--bg-secondary);
    padding: calc(1rem - 1.5px) 22.5px; /* compensate for the 1.5px border so outline buttons match filled button height */
  }
  .btn-pill { border-radius: 9999px; }
</style>
