---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import Module11 from '../components/modules/Module11.astro';
import FactList from '../components/modules/FactList.astro';
import EntryList from '../components/modules/EntryList.astro';
import ModuleBlueText from '../components/modules/ModuleBlueText.astro';
import CTALink from '../components/CTALink.astro';

const lockups = [
  { label: 'Launch Partners', color: 'teal' as const, names: ['Elanco', 'Ginkgo Bioworks', 'Ferment'] },
  { label: 'Investors', color: 'navy' as const, names: ['Anterra Capital', 'Viking', 'Nutreco NuFrontiers', 'AgriZero', 'BetAgro Ventures', 'Elevate Ventures'] },
  { label: 'Partnerships & Grants', color: 'orange' as const, names: ['Nutreco', 'Bill &amp; Melinda Gates Foundation', 'Global Methane Hub', 'Bezos Earth Fund', 'USDA NIFA', 'NIH'] },
];

const newCategoryFacts = [
  { value: '1st', color: 'navy' as const, paragraph: 'BE-101 is the first engineered microbial therapeutic ever to achieve licensure, in any species, any geography, any regulatory pathway.' },
  { value: 'Our Platform', color: 'teal' as const, valueSize: 'text' as const, paragraph: 'A programmable biologics platform built on strain engineering, AI/ML, and a proprietary microbiome library — not a single product.' },
  { value: '2', color: 'orange' as const, paragraph: 'Foundational patents, announced April 21, 2026, protect the core delivery mechanism and the nanobody sequences behind BE-101. Our platform generates further IP across strain, delivery mechanism, indication, and process.' },
  { value: '$5.5–6M', color: 'green' as const, valueSize: 'h5' as const, paragraph: 'In non-dilutive capital raised to date, supporting sustainability-focused work alongside the core pipeline.' },
];

const awards = [
  { title: '2026 Deal of the Year, TechPoint Mira Awards', description: "Recognized for BiomEdit's $18.4M Series B round, led by Elanco Animal Health." },
  { title: '2023 Visionary CEO Award, S&P Global Animal Health', description: 'Aaron Schacht recognized for leadership and innovation in animal health.' },
  { title: '2022 Best Start-Up in Animal Health, S&P Global Animal Health', description: "Awarded shortly after BiomEdit's founding." },
];

const grants = [
  { title: '2025 Bezos Earth Fund AI Award', description: 'Nearly $2M to develop the Rumen Digital Twin, an AI model for reducing cattle methane emissions.' },
  { title: '2023 Bill & Melinda Gates Foundation Grant', description: '$4.5M to advance microbiome-based methane reduction for cattle in Africa and South Asia.' },
];
---
<FieldNotesLayout title="Investors & Partners" active="investors">
  <Module11
    variant="intro"
    headingLevel="h1"
    eyebrow="BiomEdit / Investors"
    heading="Backed by leaders in Agtech, lifesciences and sustainability."
    paragraphs={['BiomEdit is pioneering programmable veterinary biologics, with investors and partners who understand what it takes to bring this category to market. Our first product is on track for commercial launch in Q4 2026, as we continue to build new solutions on our proprietary platform.']}
    noDivider
  />

  <section class="lockups section-divider">
    <div class="lockup-grid">
      {lockups.map((col) => (
        <div class="lockup-col">
          <h3 style={`color:var(--color-${col.color});`}>{col.label}</h3>
          <div class="lockup-names">
            {col.names.map((name) => <div class="lockup-name" set:html={name} />)}
          </div>
        </div>
      ))}
    </div>
    <p class="lockup-footnote">Placeholder — sourced from June 2026 Series C deck; swap in real logos</p>
  </section>

  <section class="quote-section section-divider">
    <p class="pull-quote">&ldquo;[Placeholder &mdash; investor quote to be sourced from Series C round]&rdquo;</p>
  </section>

  <section class="new-category section-divider">
    <div class="new-category-grid">
      <div>
        <h2>A new category, built for what&rsquo;s next in animal health.</h2>
        <img src="/images/samples/lab-work.jpg" alt="BiomEdit scientist at work in the lab" />
      </div>
      <FactList items={newCategoryFacts} />
    </div>
  </section>

  <section class="awards section-divider">
    <h2>Recognized by the industry we&rsquo;re building for.</h2>
    <div class="awards-grid">
      <EntryList label="Key Awards & Honors" items={awards} />
      <EntryList label="Major Grants & Funding Awards" items={grants} />
    </div>
    <div class="awards-cta"><CTALink href="#">Explore our platform</CTALink></div>
  </section>

  <section class="partner-cta">
    <div class="partner-cta-grid">
      <div>
        <h2>How we work with partners and investors.</h2>
        <p>BiomEdit is a private venture funded biotechnology company that targets venture capital and non-dilutive grants. Venture capital typically supports advancement of the pipeline while non-dilutive grants have supported the exploration and establishment of new pipeline projects.</p>
        <CTALink href="#">Connect with us</CTALink>
      </div>
      <img src="/images/samples/chickens.jpg" alt="Broiler hen in housing" />
    </div>
  </section>

  <ModuleBlueText
    heading="Passionate about creating therapeutics that put animal&rsquo;s health and wellbeing first? We want to hear from you."
    ctaLabel="Connect with us"
    ctaHref="#"
  />
</FieldNotesLayout>

<style>
  .section-divider { border-top: 1px solid var(--cool-500); }

  .lockups { padding: 3rem 0; }
  .lockup-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0; }
  .lockup-col { padding-right: 28px; border-right: 1px solid var(--cool-500); }
  .lockup-col:last-child { border-right: none; padding-right: 0; }
  .lockup-col:not(:first-child) { padding-left: 28px; }
  .lockup-col h3 { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; margin: 0 0 1.5rem; }
  .lockup-names { display: flex; flex-direction: column; gap: 1rem; }
  .lockup-name { font-size: 16px; font-weight: 700; color: var(--text-primary); }
  .lockup-footnote { font-size: 11px; color: var(--text-tertiary); margin: 1.5rem 0 0; text-transform: uppercase; letter-spacing: 0.04em; }

  .quote-section { padding: 3rem 0; }
  .pull-quote { font-family: 'Fraunces', serif; font-style: italic; font-size: 24px; line-height: 1.5; color: var(--color-navy); margin: 0; max-width: 720px; }

  .new-category { padding: 3.5rem 0; }
  .new-category-grid { display: grid; grid-template-columns: 280px 1fr; gap: 64px; }
  .new-category-grid h2 { font-size: var(--text-h5); margin: 0; }
  .new-category-grid img { display: block; width: 100%; height: auto; border-radius: 6px; margin-top: 2rem; }

  .awards { padding: 3.5rem 0; }
  .awards h2 { font-size: var(--text-h5); margin: 0 0 2rem; }
  .awards-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; }
  .awards-cta { padding-top: 2rem; }

  .partner-cta { padding: 3.5rem 0 4rem; }
  .partner-cta-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 56px; align-items: center; }
  .partner-cta-grid h2 { font-size: var(--text-h5); margin: 0 0 1.5rem; }
  .partner-cta-grid p { font-size: 15px; line-height: 1.75; color: var(--text-primary); margin: 0 0 1.5rem; }
  .partner-cta-grid img { display: block; width: 100%; height: auto; border-radius: 6px; }

  @media (max-width: 860px) {
    .lockup-grid, .new-category-grid, .awards-grid, .partner-cta-grid { grid-template-columns: 1fr; }
    .lockup-col { border-right: none; padding: 0 !important; border-bottom: 1px solid var(--cool-500); padding-bottom: 1.5rem !important; margin-bottom: 1.5rem; }
    .lockup-col:last-child { border-bottom: none; margin-bottom: 0; }
  }
</style>
