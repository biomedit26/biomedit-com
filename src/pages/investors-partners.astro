---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import IntroLead from '../components/modules/IntroLead.astro';
import FullBleedBand from '../components/modules/FullBleedBand.astro';
import FactList from '../components/modules/FactList.astro';
import EntryList from '../components/modules/EntryList.astro';
import ModuleBlueText from '../components/modules/ModuleBlueText.astro';
import ModulePlainText from '../components/modules/ModulePlainText.astro';
import CTALink from '../components/CTALink.astro';
import LogoPlaceholder from '../components/LogoPlaceholder.astro';

// Emphasis split: Investors get the full left column at a larger logo
// scale; Partnerships & Grants and Launch Partners share the right column,
// stacked and sized down to reflect a roughly 50/30/20 weighting overall.
const investors = ['Anterra Capital', 'Viking', 'Nutreco NuFrontiers', 'AgriZero', 'BetAgro Ventures', 'Elevate Ventures'];
const partnershipsGrants = ['Nutreco', 'Bill &amp; Melinda Gates Foundation', 'Global Methane Hub', 'Bezos Earth Fund', 'USDA NIFA', 'NIH'];
const launchPartners = ['Elanco', 'Ginkgo Bioworks', 'Ferment'];

const newCategoryFacts = [
  { value: '1st', valueSize: 'h5' as const, paragraph: 'BE-101 is the first engineered microbial therapeutic ever to achieve licensure, in any species, any geography, any regulatory pathway.' },
  { value: 'Our Platform', valueSize: 'h5' as const, paragraph: 'A programmable biologics platform built on strain engineering, AI/ML, and a proprietary microbiome library — not a single product.' },
  { value: '2', valueSize: 'h5' as const, paragraph: 'Foundational patents, announced April 21, 2026, protect the core delivery mechanism and the nanobody sequences behind BE-101. Our platform generates further IP across strain, delivery mechanism, indication, and process.' },
  { value: '$5.5–6M', valueSize: 'h5' as const, paragraph: 'In non-dilutive capital raised to date, supporting sustainability-focused work alongside the core pipeline.' },
];

const awards = [
  { title: '2026 Deal of the Year, TechPoint Mira Awards', description: "Recognized for BiomEdit's $18.4M Series B round, led by Elanco Animal Health." },
  { title: '2023 Visionary CEO Award, S&P Global Animal Health', description: 'Aaron Schacht recognized for leadership and innovation in animal health.' },
  { title: '2022 Best Start-Up in Animal Health, S&P Global Animal Health', description: "Awarded shortly after BiomEdit's founding." },
];

const grants = [
  { title: '2025 Bezos Earth Fund AI Award', description: 'Nearly $2M to develop the Rumen Digital Twin, an AI model for reducing cattle methane emissions.' },
  { title: '2023 Bill & Melinda Gates Foundation Grant', description: '$4.5M to advance microbiome-based methane reduction for cattle in Africa and South Asia.' },
];
---
<FieldNotesLayout title="Investors & Partners" active="investors">
  <IntroLead
    eyebrow="BiomEdit / Investors"
    heading="Backed by leaders in Agtech, lifesciences and sustainability."
    paragraphs={['BiomEdit is pioneering programmable veterinary biologics, with investors and partners who understand what it takes to bring this category to market. Our first product is on track for commercial launch in Q4 2026, as we continue to build new solutions on our proprietary platform.']}
    variant="dark"
  />

  <section class="lockups">
    <div class="lockups-top">
      <div class="lockup-category is-lg">
        <h3 style="color:var(--color-navy);">Investors</h3>
        <div class="category-rule" style="background:var(--color-navy);"></div>
        <div class="logo-row">
          {investors.map((name) => (
            <div class="logo-chip">
              <LogoPlaceholder color="navy" size="lg" />
              <span class="logo-name" set:html={name} />
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="lockups-bottom">
      <div class="lockup-category is-md">
        <h3 style="color:var(--color-orange);">Partnerships &amp; Grants</h3>
        <div class="category-rule" style="background:var(--color-orange);"></div>
        <div class="logo-row">
          {partnershipsGrants.map((name) => (
            <div class="logo-chip">
              <LogoPlaceholder color="orange" size="md" />
              <span class="logo-name" set:html={name} />
            </div>
          ))}
        </div>
      </div>

      <div class="lockup-category is-sm">
        <h3 style="color:var(--color-teal);">Launch Partners</h3>
        <div class="category-rule" style="background:var(--color-teal);"></div>
        <div class="logo-row">
          {launchPartners.map((name) => (
            <div class="logo-chip">
              <LogoPlaceholder color="teal" size="sm" />
              <span class="logo-name" set:html={name} />
            </div>
          ))}
        </div>
      </div>
    </div>
    <p class="lockup-footnote">Placeholder logos — sourced from June 2026 Series C deck; swap in real marks</p>
  </section>

  <ModulePlainText
    quote
    paragraphs={['&ldquo;BiomEdit is creating a new category in animal health through Programmable Veterinary Biologics. Its differentiated platform brings together deep scientific expertise and the potential to change how the industry approaches disease prevention. We backed Aaron and the BiomEdit team early because they are building more than another product. They are creating an entirely new approach.&rdquo;']}
    attribution="Brett Wong, Partner, Anterra Capital"
    quoteFont="sans"
    attributionSize="md"
  />

  <section class="new-category section-divider">
    <div class="new-category-grid">
      <img src="/images/drew-tGYrlchfObE-unsplash.jpg" alt="Gloved hand holding a petri dish of cultured strain in the lab" />
      <div>
        <h2>A new category, built for what&rsquo;s next in animal health.</h2>
        <FactList items={newCategoryFacts} />
      </div>
    </div>
  </section>

  <section class="awards">
    <FullBleedBand background="var(--cool-800)">
      <h2>Recognized by the industry we&rsquo;re building for.</h2>
      <div class="awards-grid">
        <EntryList label="Key Awards & Honors" items={awards} tone="onDark" />
        <EntryList label="Major Grants & Funding Awards" items={grants} tone="onDark" />
      </div>
      <div class="awards-cta"><CTALink href="#" tone="onDark">Explore our platform</CTALink></div>
    </FullBleedBand>
  </section>

  <section class="partner-cta">
    <div class="partner-cta-text">
      <h2>How we work with partners and investors.</h2>
      <p>BiomEdit is a private venture funded biotechnology company that targets venture capital and non-dilutive grants. Venture capital typically supports advancement of the pipeline while non-dilutive grants have supported the exploration and establishment of new pipeline projects.</p>
      <CTALink href="#">Let&rsquo;s meet</CTALink>
    </div>
  </section>

  <ModuleBlueText
    heading="Passionate about creating therapeutics that put animal&rsquo;s health and wellbeing first? We want to hear from you."
    ctaLabel="Connect with us"
    ctaHref="#"
    noDivider
    image="/images/jonakoh-_-NPDRGf0w1lw-unsplash.jpg"
    zoom={1.05}
    imagePosition="50% 50%"
    blendMode="overlay"
    imageOpacity={0.45}
  />
</FieldNotesLayout>

<style>
  .section-divider { border-top: 1px solid var(--cool-500); }

  .lockups { padding: 3.5rem 0; }
  .lockups-top { margin-bottom: 2.5rem; }
  .lockups-bottom { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
  .lockups-top > .lockup-category, .lockups-bottom > .lockup-category { min-width: 0; }

  .lockup-category h3 { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; margin: 0 0 0.75rem; }
  .category-rule { height: 3px; border-radius: 2px; margin-bottom: 1.5rem; }

  .logo-row { display: flex; gap: 20px; overflow-x: auto; padding-bottom: 8px; scroll-snap-type: x proximity; }
  .logo-chip { flex: 0 0 auto; display: flex; flex-direction: column; align-items: center; gap: 8px; scroll-snap-align: start; }
  .logo-chip .logo-name { font-size: 12px; font-weight: 700; color: var(--text-secondary); text-align: center; max-width: 130px; }
  .is-lg .logo-chip .logo-name { font-size: 13px; max-width: 152px; }
  .is-sm .logo-chip .logo-name { font-size: 11px; max-width: 104px; }

  .lockup-footnote { font-size: 11px; color: var(--text-tertiary); margin: 2rem 0 0; text-transform: uppercase; letter-spacing: 0.04em; }

  .new-category { padding: 3.5rem 0; }
  .new-category-grid { display: grid; grid-template-columns: 280px 1fr; gap: 64px; }
  .new-category-grid h2 { font-size: var(--text-h5); margin: 0 0 2rem; }
  .new-category-grid img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 6px; }

  .awards :global(.full-bleed-inner) { text-align: center; }
  .awards h2 { font-size: var(--text-h5); color: #FFFFFF; margin: 0 0 2.5rem; }
  .awards-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; max-width: 760px; margin: 0 auto; text-align: left; }
  .awards-cta { padding-top: 2.5rem; }

  .partner-cta { padding: 3.5rem 0 4rem; }
  .partner-cta-text { max-width: 640px; margin: 0 auto; text-align: center; }
  .partner-cta-text h2 { font-size: var(--text-h5); margin: 0 0 1.5rem; }
  .partner-cta-text p { font-size: 15px; line-height: 1.75; color: var(--text-primary); margin: 0 0 1.5rem; }

  @media (max-width: 860px) {
    .lockups-bottom, .new-category-grid, .awards-grid { grid-template-columns: 1fr; }
    .lockups-bottom { gap: 2.5rem; }
  }
</style>
