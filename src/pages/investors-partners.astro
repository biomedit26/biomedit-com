---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import IntroLead from '../components/modules/IntroLead.astro';
import FullBleedBand from '../components/modules/FullBleedBand.astro';
import Module11 from '../components/modules/Module11.astro';
import EntryList from '../components/modules/EntryList.astro';
import ModuleBlueText from '../components/modules/ModuleBlueText.astro';
import ModulePlainText from '../components/modules/ModulePlainText.astro';
import CTALink from '../components/CTALink.astro';

// Emphasis split: Investors get the full-width top row at a larger logo
// scale; Partnerships & Grants and Launch Partners share the bottom row,
// stacked and sized down to reflect a roughly 50/30/20 weighting overall.
const investors = [
  { name: 'Anterra Capital', logo: '/images/investor-partner/anterra-capital.svg', href: 'https://anterracapital.com/' },
  { name: 'Viking', logo: '/images/investor-partner/viking.svg', href: 'https://vikingglobal.com/' },
  { name: 'Nutreco NuFrontiers', logo: '/images/investor-partner/nutreco.svg', href: 'https://www.nutreco.com/en/' },
  { name: 'AgriZero', logo: '/images/investor-partner/agrizero.svg', href: 'https://www.agrizero.nz/' },
  { name: 'Betagro Ventures', logo: '/images/investor-partner/betagro-ventures.png', href: 'https://uat.betagroventures.com/en' },
  { name: 'Elevate Ventures', logo: '/images/investor-partner/elevate-ventures.png', href: 'https://elevateventures.com/' },
];
const partnershipsGrants = [
  { name: 'Nutreco', logo: '/images/investor-partner/nutreco.svg', href: 'https://www.nutreco.com/en/' },
  { name: 'Bill & Melinda Gates Foundation', logo: '/images/investor-partner/bill-and-melinda-gates-foundation.svg', href: 'https://www.gatesfoundation.org/' },
  { name: 'Global Methane Hub', logo: '/images/investor-partner/global-methane-hub.png', href: 'https://www.globalmethanehub.org/' },
  { name: 'Bezos Earth Fund', logo: '/images/investor-partner/bezos-earth-fund.webp' },
  { name: 'USDA NIFA', logo: '/images/investor-partner/usda-icon.svg', href: 'https://www.usda.gov/' },
  { name: 'NIH', logo: '/images/investor-partner/nih-icon.png', href: 'https://www.nih.gov/' },
];
const launchPartners = [
  { name: 'Elanco', logo: '/images/investor-partner/elanco.svg', href: 'https://www.elanco.com/us' },
  { name: 'Ginkgo Bioworks', logo: '/images/investor-partner/ginkgo-bioworks.svg', href: 'https://www.ginkgo.bio/' },
  { name: 'Ferment', logo: '/images/investor-partner/ferment.png', small: true, href: 'https://www.ferment.co/' },
];

const newCategoryCards = [
  { color: 'teal', heading: 'A Series of Firsts', paragraph: 'CPerf LLV* is the first engineered microbial therapeutic ever to achieve licensure, in any species, any geography, any regulatory pathway.' },
  { color: 'navy', heading: 'Our Platform', paragraph: 'Our Programmable Veterinary Biologics<sup>&trade;</sup> platform is built on strain engineering, AI/ML, and a proprietary microbiome library — not a single product.' },
  { color: 'orange', heading: 'Durable IP', paragraph: 'Two patents, announced April 21, 2026, protect the core delivery mechanism and the nanobody sequences behind CPerf LLV*. Our platform generates further IP across strain, delivery mechanism, indication, and process.' },
  { color: 'green', heading: 'Capital efficiency', paragraph: '$5.5&ndash;6M in non-dilutive capital raised to date, supporting sustainability-focused work alongside the core pipeline.' },
];

const awards = [
  { title: '2026 Deal of the Year, TechPoint Mira Awards', description: "Recognized for BiomEdit's $18.4M Series B round, led by Elanco Animal Health." },
  { title: '2023 Visionary CEO Award, S&P Global Animal Health', description: 'Aaron Schacht recognized for leadership and innovation in animal health.' },
  { title: '2022 Best Start-Up in Animal Health, S&P Global Animal Health', description: "Awarded shortly after BiomEdit's founding." },
];

const grants = [
  { title: '2025 Bezos Earth Fund AI Award', description: 'Nearly $2M to develop the Rumen Digital Twin, an AI model for reducing cattle methane emissions.' },
  { title: '2023 Bill & Melinda Gates Foundation Grant', description: '$4.5M to advance microbiome-based methane reduction for cattle in Africa and South Asia.' },
];
---
<FieldNotesLayout title="Investors & Partners" active="investors">
  <IntroLead
    eyebrow="BiomEdit / Investors"
    heading="Backed by leaders in Agtech, lifesciences and sustainability"
    paragraphs={['BiomEdit is pioneering Programmable Veterinary Biologics<sup>&trade;</sup>, with investors and partners who understand what it takes to bring this category to market. Our first product is conditionally licensed and on track for commercial launch in Q4 2026, as we continue to build new solutions on our proprietary platform.']}
    variant="dark"
  />

  <section class="lockups">
    <div class="lockups-card">
      <div class="lockups-top">
        <div class="lockup-category is-lg">
          <h3 style="color:var(--color-navy);">Investors</h3>
          <div class="category-rule" style="background:var(--color-navy);"></div>
          <div class="logo-row">
            {investors.map((p) => (
              p.href ? (
                <a class="logo-chip" href={p.href} target="_blank" rel="noopener" aria-label={p.name}>
                  <img src={p.logo} alt={p.name} loading="lazy" />
                </a>
              ) : (
                <div class="logo-chip">
                  <img src={p.logo} alt={p.name} loading="lazy" />
                </div>
              )
            ))}
          </div>
        </div>
      </div>

      <div class="lockups-bottom">
        <div class="lockup-category is-md">
          <h3 style="color:var(--color-orange);">Partnerships &amp; Grants</h3>
          <div class="category-rule" style="background:var(--color-orange);"></div>
          <div class="logo-row">
            {partnershipsGrants.map((p) => (
              p.href ? (
                <a class="logo-chip" href={p.href} target="_blank" rel="noopener" aria-label={p.name}>
                  <img src={p.logo} alt={p.name} loading="lazy" />
                </a>
              ) : (
                <div class="logo-chip">
                  <img src={p.logo} alt={p.name} loading="lazy" />
                </div>
              )
            ))}
          </div>
        </div>

        <div class="lockup-category is-sm">
          <h3 style="color:var(--color-teal);">Launch Partners</h3>
          <div class="category-rule" style="background:var(--color-teal);"></div>
          <div class="logo-row">
            {launchPartners.map((p) => (
              p.href ? (
                <a class={`logo-chip ${p.small ? 'is-small' : ''}`} href={p.href} target="_blank" rel="noopener" aria-label={p.name}>
                  <img src={p.logo} alt={p.name} loading="lazy" />
                </a>
              ) : (
                <div class={`logo-chip ${p.small ? 'is-small' : ''}`}>
                  <img src={p.logo} alt={p.name} loading="lazy" />
                </div>
              )
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <ModulePlainText
    quote
    paragraphs={['&ldquo;BiomEdit is creating a new category in animal health through Programmable Veterinary Biologics<sup>&trade;</sup>. Its differentiated platform brings together deep scientific expertise and the potential to change how the industry approaches disease prevention. We backed Aaron and the BiomEdit team early because they are building more than another product. They are creating an entirely new approach.&rdquo;']}
    attribution="Brett Wong, Partner, Anterra Capital"
    attributionSize="md"
  />

  <section class="new-category section-divider">
    <h2>A new category, built for what&rsquo;s next in animal health.</h2>
    <div class="new-category-grid">
      <img src="/images/drew-tGYrlchfObE-unsplash.jpg" alt="Gloved hand holding a petri dish of cultured strain in the lab" />
      <div class="new-category-cards">
        {newCategoryCards.map((card) => (
          <div class="new-category-card" style={`border-top-color:var(--color-${card.color});`}>
            <h3>{card.heading}</h3>
            <p set:html={card.paragraph} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="awards">
    <FullBleedBand background="var(--cool-800)">
      <h2>Recognized by the industry we&rsquo;re building for.</h2>
      <div class="awards-grid">
        <EntryList label="Key Awards & Honors" items={awards} tone="onDark" />
        <EntryList label="Major Grants & Funding Awards" items={grants} tone="onDark" />
      </div>
      <div class="awards-cta"><CTALink href="/pipeline" tone="onDark">Explore our pipeline</CTALink></div>
    </FullBleedBand>
  </section>

  <div class="partner-module">
    <Module11
      heading="How we work with partners and investors."
      paragraphs={['BiomEdit is a private venture funded biotechnology company that targets venture capital and non-dilutive grants. Venture capital typically supports advancement of the pipeline while non-dilutive grants have supported the exploration and establishment of new pipeline projects.']}
      ctaLabel="Let&rsquo;s meet"
      ctaHref="#"
      image={{ src: '/images/woman-in-lab-dropper.jpg', alt: 'Scientist in the lab using a dropper' }}
    />
  </div>

  <section class="footnote">
    <p>*Clostridium Perfringens Alpha Toxin and NetB Antibody Fragment, Live Limosilactobacillus Vector</p>
  </section>

  <ModuleBlueText
    heading="Passionate about creating therapeutics that put animal&rsquo;s health and wellbeing first? We want to hear from you."
    ctaLabel="Connect with us"
    ctaHref="#"
    noDivider
    image="/images/jonakoh-_-NPDRGf0w1lw-unsplash.jpg"
    zoom={1.05}
    imagePosition="50% 50%"
    blendMode="overlay"
    imageOpacity={0.45}
  />
</FieldNotesLayout>

<style>
  .section-divider { border-top: 1px solid var(--cool-500); }

  .footnote { padding: 0 0 2rem; }
  .footnote p { font-size: 12px; line-height: 1.6; color: var(--text-secondary); margin: 0; }

  .lockups { padding: 3.5rem 0; }
  .lockups-card {
    background: #FFFFFF;
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 3rem 40px;
  }
  .lockups-top { margin-bottom: 2.5rem; }
  .lockups-bottom { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; align-items: start; }
  .lockups-top > .lockup-category, .lockups-bottom > .lockup-category { min-width: 0; }

  .lockup-category h3 { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; margin: 0 0 0.75rem; }
  .category-rule { height: 3px; border-radius: 2px; margin-bottom: 1.5rem; }

  .logo-row { display: flex; align-items: center; gap: 40px; flex-wrap: wrap; row-gap: 24px; }
  .logo-chip { flex: 0 0 auto; display: flex; align-items: center; text-decoration: none; }
  .logo-chip:hover img { opacity: 0.7; }
  .logo-chip img { display: block; height: 40px; width: auto; }
  .is-lg .logo-chip img { height: 44px; }
  .is-md .logo-chip img { height: 34px; }
  .is-sm .logo-chip img { height: 38px; }
  .is-sm .logo-chip.is-small img { height: 19px; }

  .new-category { padding: 24px 0 3.5rem; }
  .new-category h2 { font-size: var(--text-h5); margin: 0 0 2rem; }
  .new-category-grid { display: grid; grid-template-columns: 280px 1fr; gap: 64px; }
  .new-category-grid img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 6px; }
  .new-category-cards { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .new-category-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-top: 4px solid transparent;
    border-radius: 6px;
    padding: 1.75rem 28px;
  }
  .new-category-card h3 { font-size: var(--text-h6); color: var(--text-primary); margin: 0 0 0.75rem; }
  .new-category-card p { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0; }

  .partner-module { margin-top: 6rem; }
  .partner-module :global(.grid) { align-items: center; }

  .awards :global(.full-bleed-inner) { text-align: center; }
  .awards h2 { font-size: var(--text-body); color: #FFFFFF; margin: 0 0 2.5rem; }
  .awards-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 56px; max-width: 760px; margin: 0 auto; text-align: left; }
  .awards-cta { padding-top: 2.5rem; }
  .awards-cta :global(.cta-link) { font-size: var(--text-body); }

  @media (max-width: 860px) {
    .lockups-bottom, .new-category-grid, .awards-grid { grid-template-columns: 1fr; }
    .lockups-bottom { gap: 2.5rem; }
  }
  @media (max-width: 600px) {
    .new-category-cards { grid-template-columns: 1fr; }
  }
</style>
