---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import IntroLead from '../components/modules/IntroLead.astro';
import ModuleBlueText from '../components/modules/ModuleBlueText.astro';
import CTALink from '../components/CTALink.astro';

const focusAreas = [
  {
    title: 'Infectious Disease',
    description: 'Mitigating pathogenic outbreaks to protect herd health and pet populations.',
    color: 'teal' as const,
  },
  {
    title: 'Chronic Disease',
    description: 'Targeting long-term, metabolic, and inflammatory health degradation in pets and livestock.',
    color: 'amber' as const,
  },
  {
    title: 'Sustainability Challenges',
    description: 'Reducing the environmental footprint of production agriculture and animal care systems.',
    color: 'green' as const,
  },
];

const lifecycleStages = [
  {
    heading: 'Data-Driven Species & Chassis Matching',
    paragraph: 'We select bacterial strains suited to the target animal species and intended application. Drawing from our microbial strain library, we identify strains with the characteristics needed to survive, engraft or colonize, and perform the intended biological function in the target environment.',
  },
  {
    heading: 'Strain Engineering & Payload Design',
    paragraph: 'We use complementary approaches to modify microbial function. We engineer bacterial strains to produce specific biological payloads, such as nanobodies, peptides, or enzymes, and use our Guided Biotics&reg; technology to selectively target specific bacterial populations within the microbiome. Together, these capabilities allow us to design programs around the biology of the disease or challenge and the desired microbial effect.',
  },
  {
    heading: 'High-throughput Sequencing and Computational Biology',
    paragraph: 'High-throughput sequencing and computational biology help us characterize bacterial strains, select promising candidates, and guide strain and payload design. We use AI and machine learning where appropriate to analyze complex biological data and improve candidate selection. These capabilities support a more predictive approach to product development and have contributed to research supported by organizations including the Bezos Earth Fund and Gates Foundation.',
  },
  {
    heading: 'Regulatory Navigation & Product Development',
    paragraph: 'Our in-house regulatory and product development teams work alongside our scientists to translate new technologies into products that can be manufactured, approved, and used in animal health. Regulatory, safety, stability, and manufacturing requirements are considered early in development so that product candidates are designed with a practical path to commercialization. Our team has experience across multiple technologies and regulatory frameworks, including the USDA pathway for CPerf LLV* and MAPA approval in Brazil for BiomElix One.',
  },
  {
    heading: 'Seamless Veterinary & Farm Integration',
    paragraph: 'We develop biologics with practical manufacturing and use in mind. Our products are designed to work with established production processes and animal health delivery systems, including feed, drinking water, and standard veterinary administration. This approach minimizes the need for specialized infrastructure and supports adoption and deployment at commercial scale.',
  },
];
---
<FieldNotesLayout title="Our Platform" active="science">
  <IntroLead
    eyebrow="BiomEdit / Our Platform"
    heading="Engineering bacteria into Programmable Veterinary Biologics<sup>&trade;</sup>"
    paragraphs={['BiomEdit builds selected bacterial strains to produce and deliver biologic payloads, including nanobodies, peptides and enzymes, for targeted efficacy in animal health.']}
    variant="dark"
  />

  <section class="pvb-definition section-divider">
    <h2>A flexible platform addressing complex needs.</h2>
    <p class="pvb-intro">We develop microbiome-based solutions to specific animal health problems. Our Programmable Veterinary Biologics<sup>&trade;</sup> are engineered bacteria designed to perform defined biological functions, complemented by technology that selectively targets bacteria already present in the microbiome. We focus these capabilities on three areas of animal health where we believe they can have meaningful impact.</p>

    <div class="focus-grid">
      {focusAreas.map((f) => (
        <div class="focus-card" style={`--focus-color:var(--color-${f.color});`}>
          <h3>{f.title}</h3>
          <p>{f.description}</p>
        </div>
      ))}
    </div>
  </section>

  <section class="lifecycle section-divider">
    <h2>Our precision-engineered, living biologics lifecycle</h2>
    <p class="lifecycle-intro">We focus on unmet animal health challenges across different diseases and species, including poultry, cattle, swine, cats and dogs. Every program within our Programmable Veterinary Biologics<sup>&trade;</sup> platform moves systematically through a defined five-stage lifecycle.</p>
    <div class="lifecycle-body">
      <div class="lifecycle-image">
        <img src="/images/lifecycle-image.png" alt="BiomEdit scientist working with lab equipment in a biosafety cabinet" />
      </div>
      <div class="lifecycle-text">
        <div class="lifecycle-list">
          {lifecycleStages.map((stage, i) => (
            <div class="lifecycle-item">
              <span class="stage-number">{i + 1}</span>
              <div class="stage-content">
                <h3>{stage.heading}</h3>
                <p set:html={stage.paragraph} />
              </div>
            </div>
          ))}
        </div>
        <div class="lifecycle-cta"><CTALink href="/pipeline">View our pipeline</CTALink></div>
      </div>
    </div>
  </section>

  <section class="platform-action">
    <div class="platform-action-card">
      <div class="platform-action-text">
        <p class="eyebrow">Platform in Action</p>
        <h3>Proof in the pipeline.</h3>
        <p>CPerf LLV* (BE-101) is the first Programmable Veterinary Biologic<sup>&trade;</sup> to receive conditional USDA licensure. Developed to protect poultry from subclinical necrotic enteritis without systemic antibiotics, it demonstrates the translation of our platform from engineered strain design through regulatory approval and commercial-scale use.</p>
        <div class="platform-action-ctas">
          <CTALink href="https://www.nature.com/articles/s41522-026-00916-w" target="_blank">Read the research</CTALink>
        </div>
      </div>
      <img src="/images/Broilers-Feeding96-scaled.jpg" alt="Broiler chickens feeding in a commercial poultry house" />
    </div>
  </section>

  <section class="footnote">
    <p>*Clostridium Perfringens Alpha Toxin and NetB Antibody Fragment, Live Limosilactobacillus Vector</p>
  </section>

  <ModuleBlueText
    heading="See how the platform performs in the field."
    ctaLabel="Explore the pipeline"
    ctaHref="/pipeline"
    secondaryCtaLabel="Partner with us"
    secondaryCtaHref="/investors-partners"
    image="/images/jonakoh-_-NPDRGf0w1lw-unsplash.jpg"
    zoom={1.05}
    imagePosition="50% 50%"
    blendMode="overlay"
    imageOpacity={0.45}
    noDivider
  />
</FieldNotesLayout>

<style>
  .section-divider { border-top: 1px solid var(--cool-500); }

  .footnote { padding: 0 0 2rem; }
  .footnote p { font-size: 12px; line-height: 1.6; color: var(--text-secondary); margin: 0; }

  /* ---------- PVB definition ---------- */
  .pvb-definition { margin-top: 24px; padding: 1.5rem 0 4rem; }
  .pvb-definition h2 { font-size: var(--text-h5); margin: 0 0 1.5rem; max-width: 760px; }
  .pvb-definition .pvb-intro { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0 0 2rem; max-width: 760px; }

  .focus-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px; }
  .focus-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--focus-color);
    border-radius: 6px;
    padding: 2rem 28px;
  }
  .focus-card h3 { font-size: 17px; margin: 0 0 0.75rem; }
  .focus-card p { font-size: var(--text-body); line-height: 1.5; color: var(--text-secondary); margin: 0; }

  /* ---------- lifecycle ---------- */
  .lifecycle { padding: 1.5rem 0 4rem; }
  .lifecycle h2 { font-size: var(--text-h5); margin: 0 0 1.5rem; max-width: 760px; }
  .lifecycle-intro { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0 0 2rem; max-width: 760px; }

  .lifecycle-body { display: grid; grid-template-columns: 1fr 2fr; gap: 48px; align-items: start; }
  .lifecycle-image { position: sticky; top: 24px; }
  .lifecycle-image img { display: block; width: 100%; height: auto; border-radius: 6px; }

  .lifecycle-list { display: flex; flex-direction: column; }
  .lifecycle-item {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 32px;
    padding: 2rem 0;
    border-bottom: 1px solid var(--cool-400);
  }
  .lifecycle-item:first-of-type { border-top: 1px solid var(--cool-400); }
  .stage-number { font-size: var(--text-h3); font-weight: 700; color: var(--color-teal); line-height: 1; }
  .stage-content h3 { font-size: var(--text-h6); color: var(--text-primary); margin: 0 0 0.75rem; }
  .stage-content p { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0; max-width: 760px; }
  .lifecycle-cta { padding-top: 2.5rem; }

  /* ---------- platform in action ---------- */
  .platform-action { padding: 1.5rem 0 4rem; }
  .platform-action-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: stretch;
  }
  .platform-action-text { padding: 3rem 0 3rem 44px; display: flex; flex-direction: column; justify-content: center; }
  .platform-action-text .eyebrow { font-size: var(--text-eyebrow); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-teal); margin: 0 0 1rem; }
  .platform-action-text h3 { font-size: var(--text-h5); color: var(--text-primary); margin: 0 0 1rem; }
  .platform-action-text p { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0 0 1.5rem; }
  .platform-action-ctas { display: flex; gap: 28px; flex-wrap: wrap; }
  .platform-action-card img { display: block; width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 860px) {
    .focus-grid { grid-template-columns: 1fr; }
    .lifecycle-body { grid-template-columns: 1fr; gap: 1.5rem; }
    .lifecycle-image { position: static; }
    .lifecycle-item { grid-template-columns: 44px 1fr; gap: 20px; }
    .stage-number { font-size: var(--text-h5); }
    .platform-action-card { grid-template-columns: 1fr; gap: 1.5rem; }
    .platform-action-card img { order: -1; min-height: 260px; }
    .platform-action-text { padding: 0 28px 2.25rem; }
  }
</style>
