---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import IntroLead from '../components/modules/IntroLead.astro';
import ModuleBlueText from '../components/modules/ModuleBlueText.astro';
import CTALink from '../components/CTALink.astro';

const differentiators = [
  {
    title: 'Proprietary strain engineering',
    description: "We start every product from the same foundation, a beneficial bacterial strain we select, screen, and engineer to carry a specific payload, without relying on antibiotics alone. Strain engineering isn't a step in our process, it's the foundation of every product we build.",
    color: 'teal' as const,
  },
  {
    title: 'High-throughput sequencing and AI/ML',
    description: 'We identify and optimize candidate strains rapidly and at scale, cutting time, cost, and animal burden from discovery to market.',
    color: 'navy' as const,
  },
  {
    title: 'Programmable architecture',
    description: 'We adapt the same strain engineering across payloads, targets, species, and disease areas, spanning poultry, cattle, swine, dogs, and cats, so each new product builds on proven ground instead of starting over.',
    color: 'orange' as const,
  },
  {
    title: 'Durable IP across the full stack',
    description: "We generate protected intellectual property with every product across strain, delivery mechanism, indication, and process, compounding the platform's competitive advantage over time.",
    color: 'green' as const,
  },
];

const pillars = [
  {
    heading: 'We built it first',
    paragraphs: [
      'BiomEdit is the first company to receive USDA conditional licensure for a Programmable Veterinary Biologic&trade;, built on our proprietary strain engineering platform. This is a milestone no other company has reached in any species, any geography, or any regulatory pathway.',
      'CPerf LLV*, commercially known as Optavant&trade;, is proof that the engineered microbial therapeutics we build are real, licensed, and coming to market.',
    ],
  },
  {
    heading: 'We advance using the latest AI/ML technology',
    paragraphs: [
      'Our AI/ML infrastructure works hand-in-hand with our strain engineering platform, accelerating candidate selection and reducing the time, cost, and animal burden of bringing precision biologics to market.',
      'Our AI capabilities move the industry from reactive &ldquo;trial and error&rdquo; approaches toward predictive, programmable animal health. This approach has been a critical factor in earning grant support, most notably from Bezos Earth Fund and Gates Foundation.',
    ],
  },
  {
    heading: "We're powered by a proprietary gut microbiome library",
    paragraphs: [
      'Our proprietary strain library, built over years of sampling and characterization, gives BiomEdit access to novel strains and a deeper understanding of microbiome biology that others cannot easily replicate.',
      'Developed specifically for animal health, it enables our team to screen, identify, and engineer high-potential microbial candidates from a foundation built for precision targeting, including some designed as antibiotic alternatives.',
    ],
  },
];
---
<FieldNotesLayout title="Our Platform" active="science">
  <IntroLead
    eyebrow="BiomEdit / Our Platform"
    heading="Engineering beneficial bacteria into Programmable Veterinary Biologics<sup>&trade;</sup>."
    paragraphs={['BiomEdit engineers selected bacterial strains to produce and deliver biologic payloads, including nanobodies, peptides, and enzymes, for targeted efficacy in animal health.']}
    variant="dark"
  />

  <section class="pvb-definition section-divider">
    <h2>A precision-engineered, living biologics platform.</h2>
    <p class="pvb-intro">Programmable Veterinary Biologics are engineered beneficial bacteria designed to perform specific biological functions in an animal. Through strain engineering, each strain is selected for characteristics suited to the target species and application, then built to produce a payload, such as a nanobody, peptide, or enzyme, precisely where it&rsquo;s needed. The result is a flexible delivery approach where the organism, payload, and biological target can each be adapted for different diseases and species. That flexibility comes from our four core capabilities.</p>

    <div class="diff-grid">
      {differentiators.map((d) => (
        <div class="diff-card" style={`--diff-color:var(--color-${d.color});`}>
          <h3>{d.title}</h3>
          <p set:html={d.description} />
        </div>
      ))}
    </div>
  </section>

  <section class="pillars section-divider">
    <h2>How it works: three pillars.</h2>
    <div class="pillars-grid">
      {pillars.map((pillar, i) => (
        <div class="pillar">
          <div class="pillar-heading-row">
            <span class="pillar-number">{i + 1}</span>
            <h3>{pillar.heading}</h3>
          </div>
          {pillar.paragraphs.map((p) => <p set:html={p} />)}
        </div>
      ))}
    </div>
    <div class="pillars-cta"><CTALink href="/pipeline">Explore our pipeline</CTALink></div>
  </section>

  <section class="platform-action">
    <div class="platform-action-card">
      <div class="platform-action-text">
        <p class="eyebrow">Platform in Action</p>
        <h3>Proof in the pipeline.</h3>
        <p>CPerf LLV* (BE-101), is the first Programmable Veterinary Biologic to receive conditional USDA licensure. It was developed to protect poultry from sub-clinical necrotic enteritis without relying on systemic antibiotics. It&rsquo;s proof that the platform works, not just in the lab, but at commercial scale.</p>
        <div class="platform-action-ctas">
          <CTALink href="https://www.nature.com/articles/s41522-026-00916-w" target="_blank">Read the research</CTALink>
        </div>
      </div>
      <img src="/images/Broilers-Feeding96-scaled.jpg" alt="Broiler chickens feeding in a commercial poultry house" />
    </div>
  </section>

  <ModuleBlueText
    heading="See how the platform performs in the field."
    ctaLabel="Explore the pipeline"
    ctaHref="/pipeline"
    secondaryCtaLabel="Partner with us"
    secondaryCtaHref="/investors-partners"
    image="/images/jonakoh-_-NPDRGf0w1lw-unsplash.jpg"
    zoom={1.05}
    imagePosition="50% 50%"
    blendMode="overlay"
    imageOpacity={0.45}
    noDivider
  />
</FieldNotesLayout>

<style>
  .section-divider { border-top: 1px solid var(--cool-500); }

  /* ---------- PVB definition ---------- */
  .pvb-definition { margin-top: 24px; padding: 1.5rem 0 4rem; }
  .pvb-definition h2 { font-size: var(--text-h5); margin: 0 0 1.5rem; max-width: 760px; }
  .pvb-definition .pvb-intro { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0 0 2rem; max-width: 760px; }

  .diff-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .diff-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--diff-color);
    border-radius: 6px;
    padding: 2rem 28px;
  }
  .diff-card h3 { font-size: 17px; margin: 0 0 0.75rem; }
  .diff-card p:last-child { font-size: var(--text-body); line-height: 1.5; color: var(--text-secondary); margin: 0; }

  /* ---------- three pillars ---------- */
  .pillars { padding: 1.5rem 0 4rem; }
  .pillars h2 { font-size: var(--text-h5); margin: 0 0 2.5rem; }
  .pillars-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px; }
  .pillar-heading-row { display: flex; align-items: center; gap: 16px; margin: 0 0 1rem; }
  .pillar-number { font-size: var(--text-h3); font-weight: 700; color: var(--text-primary); line-height: 1; }
  .pillar h3 { font-size: var(--text-h6); color: var(--text-primary); margin: 0; }
  .pillar p { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0 0 1rem; }
  .pillar p:last-child { margin-bottom: 0; }
  .pillars-cta { padding-top: 2.5rem; }

  /* ---------- platform in action ---------- */
  .platform-action { padding: 1.5rem 0 4rem; }
  .platform-action-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: stretch;
  }
  .platform-action-text { padding: 3rem 0 3rem 44px; display: flex; flex-direction: column; justify-content: center; }
  .platform-action-text .eyebrow { font-size: var(--text-eyebrow); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-teal); margin: 0 0 1rem; }
  .platform-action-text h3 { font-size: var(--text-h5); color: var(--text-primary); margin: 0 0 1rem; }
  .platform-action-text p { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0 0 1.5rem; }
  .platform-action-ctas { display: flex; gap: 28px; flex-wrap: wrap; }
  .platform-action-card img { display: block; width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 860px) {
    .diff-grid, .pillars-grid { grid-template-columns: 1fr; }
    .platform-action-card { grid-template-columns: 1fr; gap: 1.5rem; }
    .platform-action-card img { order: -1; min-height: 260px; }
    .platform-action-text { padding: 0 28px 2.25rem; }
  }
</style>
