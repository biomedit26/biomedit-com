---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import IntroLead from '../components/modules/IntroLead.astro';
import FactList from '../components/modules/FactList.astro';
import ModuleBlueText from '../components/modules/ModuleBlueText.astro';
import CTALink from '../components/CTALink.astro';

const values = [
  {
    name: 'Lead With Science',
    color: 'teal' as const,
    description: 'Every decision starts with evidence. We are building something genuinely new, and rigorous science leads the way.',
  },
  {
    name: 'Execute With Clarity',
    color: 'navy' as const,
    description: 'We move with precision and execute to help animals, people and the world. We are clear about what we are building, how we are building it, and who is accountable for delivering it.',
  },
  {
    name: 'Build Together',
    color: 'orange' as const,
    description: 'Built on decades of working side by side through setbacks and breakthroughs, we trust one another deeply. As we grow, we continue to attract exceptional teammates, partners, and investors united by our shared mission in animal health.',
  },
  {
    name: 'Pioneer With Purpose',
    color: 'green' as const,
    description: 'We are true pioneers engineering a new platform category of Programmable Veterinary Biologics. Each new product we pursue helps solve unmet needs in animal health.',
  },
];

const milestones = [
  { value: 'Apr 2022', valueSize: 'text' as const, paragraph: 'BiomEdit established as an independent company in Fishers, Indiana.' },
  { value: 'Dec 2022', valueSize: 'text' as const, paragraph: 'S&P Global Animal Health names BiomEdit Best Start-Up in Animal Health.' },
  { value: 'Jan 2023', valueSize: 'text' as const, paragraph: '$37M Series A financing closed.' },
  { value: 'Feb 2023', valueSize: 'text' as const, paragraph: 'Chairman and Board of Directors appointed.' },
  { value: 'Aug 2023', valueSize: 'text' as const, paragraph: 'Research collaboration announced with the Indiana Biosciences Research Institute (IBRI).' },
  { value: 'Nov 2023', valueSize: 'text' as const, paragraph: '$4.5M grant awarded by the Bill & Melinda Gates Foundation for cattle methane reduction.' },
  { value: 'Dec 2023', valueSize: 'text' as const, paragraph: 'Aaron Schacht named S&P Global Visionary CEO.' },
  { value: 'Jul 2025', valueSize: 'text' as const, paragraph: 'Series B closed, raising $18.4M.' },
  { value: 'Oct 2025', valueSize: 'text' as const, paragraph: 'Bezos Earth Fund grant received (~$2M) for the Rumen Digital Twin.' },
  { value: 'Apr 2026', valueSize: 'text' as const, paragraph: "Two foundational US patents granted, protecting BE-101's core delivery mechanism and nanobody sequences." },
  { value: '2025–26', valueSize: 'text' as const, paragraph: 'USDA conditional licensure targeted for BE-101.' },
];
---
<FieldNotesLayout title="About" active="about">
  <IntroLead
    eyebrow="BiomEdit / About"
    heading="Engineering a new chapter in animal health."
    paragraphs={["BiomEdit engineers Programmable Veterinary Biologics&trade;, living therapeutics built from strains designed to prevent and treat disease across various species, including poultry, livestock, and companion animals. Our pipeline spans infectious disease, sustainability, and chronic disease programs, led by BE-101/Optavant, progressing toward conditional USDA licensure. We're engineering a new chapter in animal health."]}
    variant="dark"
  />

  <section class="mission section-divider">
    <p class="overline">Mission</p>
    <p class="statement">We engineer living biologics that prevent disease, treat conditions, and improve animal health.</p>
    <p class="statement-support">Traditional animal health relies on broad-spectrum antibiotics and generalized interventions. BiomEdit is building something different: Programmable Veterinary Biologics that target specific disease drivers at the source, engineered to work with the animal&rsquo;s own biology.</p>
  </section>

  <section class="vision section-divider">
    <p class="overline">Vision</p>
    <p class="statement is-vision">Transform animal health by creating programmable biologic solutions that redefine what is possible.</p>
  </section>

  <section class="values section-divider">
    <p class="overline">Values</p>
    <p class="values-intro">Our values are not aspirational. They describe how we work together every day.</p>
    <div class="values-grid">
      {values.map((value) => (
        <div class="value-card" style={`--value-color:var(--color-${value.color});`}>
          <h3>{value.name}</h3>
          <p>{value.description}</p>
        </div>
      ))}
    </div>
    <div class="values-cta"><CTALink href="/company">Meet the team</CTALink></div>
  </section>

  <section class="timeline section-divider">
    <p class="overline">Since 2022</p>
    <h2>Milestones on the way to licensure.</h2>
    <FactList items={milestones} />
  </section>

  <ModuleBlueText
    heading="Interested in what&rsquo;s next for BiomEdit?"
    ctaLabel="Explore our pipeline"
    ctaHref="/pipeline"
    secondaryCtaLabel="Partner with us"
    secondaryCtaHref="/investors-partners"
    image="/images/footer-cta-bg-3.jpg"
    zoom={1.05}
    imagePosition="50% 50%"
    blendMode="overlay"
    imageOpacity={0.7}
  />
</FieldNotesLayout>

<style>
  .section-divider { border-top: 1px solid var(--cool-500); }

  .mission { padding: 3.5rem 0 3rem; }
  .vision { padding: 3rem 0; }
  .statement {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 500;
    font-size: 32px;
    line-height: 1.35;
    color: var(--color-navy);
    margin: 1rem 0 1.5rem;
    max-width: 760px;
  }
  .statement-support { font-size: 15px; line-height: 1.75; color: var(--text-primary); margin: 0; max-width: 640px; }
  .statement.is-vision { font-size: 24px; color: var(--text-primary); margin: 1rem 0 0; max-width: 680px; }

  .values { padding: 3.5rem 0 4rem; }
  .values-intro { font-size: 15px; line-height: 1.75; color: var(--text-primary); margin: 1rem 0 2rem; max-width: 640px; }
  .values-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }
  .value-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-top: 3px solid var(--value-color);
    border-radius: 6px;
    padding: 1.75rem 22px;
  }
  .value-card h3 {
    font-size: 15px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
  }
  .value-card p { font-size: 14px; line-height: 1.7; color: var(--text-secondary); margin: 0; }
  .values-cta { padding-top: 2rem; }

  .timeline { padding: 3.5rem 0 4rem; }
  .timeline h2 { font-size: var(--text-h5); margin: 0.5rem 0 2rem; }

  @media (max-width: 860px) {
    .values-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .values-grid { grid-template-columns: 1fr; }
  }
</style>
