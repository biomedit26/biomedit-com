---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import IntroLead from '../components/modules/IntroLead.astro';
import ModuleBlueText from '../components/modules/ModuleBlueText.astro';
import CTALink from '../components/CTALink.astro';

const values = [
  {
    name: 'Lead With Science',
    color: 'teal' as const,
    description: 'Evidence comes first. We advance the science, test our assumptions, and let the data determine what we do next.',
  },
  {
    name: 'Execute With Clarity',
    color: 'navy' as const,
    description: 'We move with precision. We are clear about what we are trying to accomplish, what matters most, and who is accountable for delivering it.',
  },
  {
    name: 'Build Together',
    color: 'orange' as const,
    description: 'Complex problems require different disciplines and perspectives to solve them. We are collaborative, we challenge one another, and we share accountability as we work toward better outcomes.',
  },
  {
    name: 'Pioneer With Purpose',
    color: 'green' as const,
    description: 'We pioneer new approaches in Programmable Veterinary Biologics<sup>&trade;</sup>, where they can make a meaningful difference in animal health. New technology matters only when it delivers real, measurable impact.',
  },
];

// Grouped year -> month -> bullet items, newest first. `month: null` is
// for milestones tied to a year/target rather than a specific month.
const milestones = [
  {
    year: '2026',
    months: [
      { month: null, items: ['USDA conditional licensure targeted for BE-101.'] },
      { month: 'April', items: ["Two foundational US patents granted, protecting BE-101's core delivery mechanism and nanobody sequences."] },
    ],
  },
  {
    year: '2025',
    months: [
      { month: 'October', items: ['Bezos Earth Fund grant received (~$2M) for the Rumen Digital Twin.'] },
      { month: 'July', items: ['Series B closed, raising $18.4M.'] },
    ],
  },
  {
    year: '2024',
    months: [
      { month: 'May', items: ['Diamond Animal Health chosen as process development and manufacturing partner for BE-101.'] },
      { month: 'February', items: ['BiomEdit secures USDA conditional licensure pathway for BE-101.'] },
    ],
  },
  {
    year: '2023',
    months: [
      { month: 'November', items: ['$4.5M grant awarded by the Bill & Melinda Gates Foundation for cattle methane reduction.'] },
      { month: 'August', items: ['Research collaboration announced with the Indiana Biosciences Research Institute (IBRI).'] },
      { month: 'February', items: ['Chairman and Board of Directors appointed.'] },
      { month: 'January', items: ['$37M Series A financing closed.'] },
    ],
  },
  {
    year: '2022',
    months: [
      { month: 'December', items: ['S&P Global Animal Health names BiomEdit Best Start-Up in Animal Health.'] },
      { month: 'April', items: ['BiomEdit established as an independent company in Fishers, Indiana.'] },
    ],
  },
];
---
<FieldNotesLayout title="About" active="about">
  <IntroLead
    eyebrow="BiomEdit / About"
    heading="About BiomEdit"
    paragraphs={[
      "BiomEdit is an animal health biotechnology company developing Programmable Veterinary Biologics<sup>&trade;</sup>, beneficial bacteria engineered to deliver specific biologic functions. Our pipeline includes programs targeting important challenges in animal health focusing on infectious disease, chronic disease, and sustainability.",
      "<strong style=\"color:#FFFFFF;\">Engineering a new chapter in animal health.</strong>",
    ]}
    variant="dark"
  />

  <section class="mission section-divider">
    <div class="mission-grid">
      <div class="mission-text">
        <p class="overline">Mission</p>
        <h2 class="mission-heading">We engineer living biologics to prevent disease, treat conditions, and improve animal health.</h2>
        <p class="statement-support">Programmable Veterinary Biologics<sup>&trade;</sup> offer a new approach: engineered beneficial bacteria designed for specific biologic payloads to target disease mechanisms in a manner consistent with existing care and management practices for animal health.</p>
      </div>
      <div class="mission-image">
        <img src="/images/amari-shutters-JABi6GpktFM-unsplash.jpg" alt="BiomEdit scientist at work in the lab" />
      </div>
      <div class="mission-image">
        <img src="/images/woman-with-pig.jpg" alt="Farmer caring for livestock" />
      </div>
    </div>
  </section>

  <section class="vision-values section-divider">
    <div class="vision-values-grid">
      <div class="vision-col">
        <p class="overline">Vision</p>
        <h2 class="vision-heading">Transform animal health by creating programmable biologic solutions that advance care and well-being.</h2>
      </div>
      <div class="values-col">
        <p class="overline">Values</p>
        <p class="values-intro">Our values are not aspirational. They describe how we work together every day.</p>
        <div class="values-grid">
          {values.map((value) => (
            <div class="value-card" style={`--value-color:var(--color-${value.color});`}>
              <h3>{value.name}</h3>
              <p set:html={value.description} />
            </div>
          ))}
        </div>
        <div class="values-cta"><CTALink href="/team">Meet our team</CTALink></div>
      </div>
    </div>
  </section>

  <section class="timeline section-divider">
    <p class="overline">Since 2022</p>
    <h2>Milestones</h2>
    <div class="milestones">
      {milestones.map((yearGroup) => (
        <div class="milestone-year-group">
          <div class="milestone-year">{yearGroup.year}</div>
          <div class="milestone-months">
            {yearGroup.months.map((m) => (
              <div class="milestone-month-group">
                {m.month && <p class="milestone-month">{m.month}</p>}
                <ul class="milestone-list">
                  {m.items.map((text) => <li>{text}</li>)}
                </ul>
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </section>

  <ModuleBlueText
    heading="Discover more"
    paragraphs={['Join the conversation on LinkedIn.']}
    ctaLabel="View now"
    ctaHref="https://www.linkedin.com/company/biomedit"
    ctaTarget="_blank"
    ctaStyle="button"
    image="/images/jonakoh-_-NPDRGf0w1lw-unsplash.jpg"
    zoom={1.05}
    imagePosition="50% 50%"
    blendMode="overlay"
    imageOpacity={0.45}
    noDivider
  />
</FieldNotesLayout>

<style>
  .section-divider { border-top: 1px solid var(--cool-500); }

  .mission { margin-top: 3rem; padding: 24px 0 3rem; }
  .mission-grid { display: grid; grid-template-columns: 1fr 1fr 1fr; gap: 32px; align-items: start; }
  .mission-image img { display: block; width: 100%; height: auto; border-radius: 6px; }
  .mission-heading { font-size: var(--text-h5); color: var(--text-primary); margin: 1rem 0 1.5rem; }
  .statement-support { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0; max-width: 640px; }

  .vision-values { padding: 24px 0 4rem; }
  .vision-values-grid { display: grid; grid-template-columns: 1fr 2fr; gap: 56px; align-items: start; }
  .vision-heading { font-size: var(--text-h5); color: var(--text-primary); margin: 1rem 0 0; }
  .values-intro { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 1rem 0 2rem; max-width: 640px; }
  .values-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .value-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-top: 3px solid var(--value-color);
    border-radius: 6px;
    padding: 1.75rem 22px;
  }
  .value-card h3 {
    font-size: 15px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
  }
  .value-card p { font-size: var(--text-body); line-height: 1.5; color: var(--text-secondary); margin: 0; }
  .values-cta { padding-top: 2rem; }

  .timeline { padding: 3.5rem 0 4rem; }
  .timeline h2 { font-size: var(--text-h5); margin: 0.5rem 0 2rem; }

  .milestones { display: flex; flex-direction: column; text-align: left; }
  .milestone-year-group {
    padding: 2rem 0;
    border-bottom: 1px solid var(--cool-400);
  }
  .milestone-year-group:first-child { border-top: 1px solid var(--cool-400); }
  .milestone-year { font-size: var(--text-h4); font-weight: 700; line-height: 1.2; color: var(--text-primary); margin: 0 0 1rem; }
  .milestone-months { display: flex; flex-direction: column; gap: 1.5rem; }
  .milestone-month {
    font-size: 13px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--text-tertiary);
    margin: 0 0 0.5rem;
  }
  .milestone-list { margin: 0; padding: 0 0 0 1.1rem; max-width: 65ch; }
  .milestone-list li { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0 0 0.4rem; }
  .milestone-list li:last-child { margin-bottom: 0; }

  @media (max-width: 860px) {
    .mission-grid { grid-template-columns: 1fr; gap: 1.5rem; }
    .vision-values-grid { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 600px) {
    .values-grid { grid-template-columns: 1fr; }
  }
</style>
