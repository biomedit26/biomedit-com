---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import IntroLead from '../components/modules/IntroLead.astro';
import Button from '../components/Button.astro';
---
<FieldNotesLayout title="Contact Us">
  <IntroLead
    eyebrow="BiomEdit / Contact"
    heading="Let&rsquo;s start a conversation"
    paragraphs={['We believe lasting relationships, from partners and investors to fellow scientists and researchers, help bring our mission to life. We&rsquo;re always glad to hear from anyone curious about our work as we move our Programmable Veterinary Biologics<sup>&trade;</sup> platform forward to help improve animal health.']}
    variant="dark"
  />

  <section class="contact-body">
    <div class="contact-grid">
      <div class="contact-details">
        <h2>Our location</h2>
        <p>BiomEdit is headquartered at the Indiana Biosciences Research Institute, where our team of scientists and researchers engineer Programmable Veterinary Biologics<sup>&trade;</sup> to help prevent and treat disease across species.</p>

        <h2>Our address</h2>
        <address>
          Indiana Biosciences Research Institute<br />
          1210 Waterway Blvd., Suite 2000<br />
          Indianapolis, IN 46202
        </address>

        <div class="contact-map">
          <iframe
            src="https://www.google.com/maps?q=Indiana+Biosciences+Research+Institute,+1210+Waterway+Blvd,+Indianapolis,+IN+46202&output=embed"
            width="100%"
            height="240"
            style="border:0;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="Map showing BiomEdit&rsquo;s location at the Indiana Biosciences Research Institute"
          ></iframe>
        </div>

        <Button color="navy" variant="outline" href="https://www.linkedin.com/company/biomeditinc" target="_blank">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
          LinkedIn
        </Button>
      </div>
      <div class="contact-form">
        <h2>Send a message</h2>
        <form name="contact" method="POST" action="/contact-us/thank-you" data-netlify="true" data-netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="contact" />
          <p class="visually-hidden">
            <label>Don&rsquo;t fill this out if you&rsquo;re human: <input name="bot-field" /></label>
          </p>
          <div class="form-group">
            <label class="form-label" for="name">Name</label>
            <input class="form-input" type="text" id="name" name="name" placeholder="Your name" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="email">Email</label>
            <input class="form-input" type="email" id="email" name="email" placeholder="you@company.com" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="subject">Subject</label>
            <input class="form-input" type="text" id="subject" name="subject" placeholder="What&rsquo;s this about?" />
          </div>
          <div class="form-group">
            <label class="form-label" for="message">Message</label>
            <textarea class="form-input" id="message" name="message" rows="6" placeholder="Tell us more&hellip;" required></textarea>
          </div>
          <Button color="amber" variant="filled">Send message</Button>
        </form>
      </div>
    </div>
  </section>
</FieldNotesLayout>

<style>
  .contact-body { padding: 4rem 0 5rem; }
  .contact-grid { display: grid; grid-template-columns: 1fr 480px; gap: 64px; align-items: start; }

  .contact-details h2 { font-size: var(--text-h6); margin: 0 0 1rem; }
  .contact-details h2:first-child { margin-top: 0; }
  .contact-details h2:not(:first-child) { margin-top: 2.25rem; }
  .contact-details p {
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--text-primary);
    margin: 0;
  }
  .contact-details address {
    font-style: normal;
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--text-primary);
    margin: 0;
  }

  .contact-map {
    margin-top: 1.25rem;
    border-radius: 6px;
    overflow: hidden;
    line-height: 0;
  }
  .contact-map iframe { display: block; width: 100%; height: 240px; }

  .contact-details :global(.btn) { margin-top: 1.75rem; }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .contact-form h2 { font-size: var(--text-h6); margin: 0 0 1.25rem; }
  .contact-form form { display: flex; flex-direction: column; gap: 20px; max-width: 480px; }
  .contact-form .form-group { max-width: none; }
  .contact-form .form-input { font-size: var(--text-body); padding: 12px 14px; }
  .contact-form textarea.form-input { resize: vertical; font-family: inherit; }
  .contact-form :global(.btn) { align-self: flex-start; }

  @media (max-width: 700px) {
    .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
