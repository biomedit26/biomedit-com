---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import IntroLead from '../components/modules/IntroLead.astro';
import Button from '../components/Button.astro';
---
<FieldNotesLayout title="Contact Us">
  <IntroLead
    eyebrow="BiomEdit / Contact"
    heading="Contact us"
    paragraphs={['If you have a question or want to find out more about collaborations or partnerships, get in touch and one of our team will get back to you.']}
    variant="dark"
  />

  <section class="contact-body">
    <div class="contact-grid">
      <div class="contact-details">
        <h2>Contact details</h2>
        <address>
          BiomEdit<br />
          2710 Innovation Way<br />
          Greenfield, IN 46140
        </address>
      </div>
      <div class="contact-form">
        <h2>Send a message</h2>
        <form name="contact" method="POST" action="/contact-us/thank-you" data-netlify="true" data-netlify-honeypot="bot-field">
          <input type="hidden" name="form-name" value="contact" />
          <p class="visually-hidden">
            <label>Don&rsquo;t fill this out if you&rsquo;re human: <input name="bot-field" /></label>
          </p>
          <div class="form-group">
            <label class="form-label" for="name">Name</label>
            <input class="form-input" type="text" id="name" name="name" placeholder="Your name" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="email">Email</label>
            <input class="form-input" type="email" id="email" name="email" placeholder="you@company.com" required />
          </div>
          <div class="form-group">
            <label class="form-label" for="subject">Subject</label>
            <input class="form-input" type="text" id="subject" name="subject" placeholder="What&rsquo;s this about?" />
          </div>
          <div class="form-group">
            <label class="form-label" for="message">Message</label>
            <textarea class="form-input" id="message" name="message" rows="6" placeholder="Tell us more&hellip;" required></textarea>
          </div>
          <Button color="amber" variant="filled">Send message</Button>
        </form>
      </div>
    </div>
  </section>
</FieldNotesLayout>

<style>
  .contact-body { padding: 4rem 0 5rem; }
  .contact-grid { display: grid; grid-template-columns: 320px 1fr; gap: 64px; align-items: start; }

  .contact-details h2 { font-size: var(--text-h6); margin: 0 0 1.25rem; }
  .contact-details address {
    font-style: normal;
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--text-primary);
    margin: 0;
  }

  .visually-hidden {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  .contact-form h2 { font-size: var(--text-h6); margin: 0 0 1.25rem; }
  .contact-form form { display: flex; flex-direction: column; gap: 20px; max-width: 480px; }
  .contact-form .form-group { max-width: none; }
  .contact-form .form-input { font-size: var(--text-body); padding: 12px 14px; }
  .contact-form textarea.form-input { resize: vertical; font-family: inherit; }
  .contact-form :global(.btn) { align-self: flex-start; }

  @media (max-width: 700px) {
    .contact-grid { grid-template-columns: 1fr; gap: 2.5rem; }
  }
</style>
