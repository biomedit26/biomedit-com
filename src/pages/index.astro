---
// BiomEdit marketing homepage — built from the Field Notes concept
// (design_handoff_field_notes/README.md). Lives at the site root; the
// old /home route now redirects here (see public/_redirects).
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import FieldNotesHomeBody from '../components/FieldNotesHomeBody.astro';
import FullBleedBand from '../components/modules/FullBleedBand.astro';
import Button from '../components/Button.astro';
---
<FieldNotesLayout title="Home" active="home">
  <section class="hero">
    <FullBleedBand
      background="var(--cool-800)"
      image="/images/flowing-e-background.svg"
      imageFit="width"
      blendMode="screen"
      imageFilter="grayscale(1) sepia(1) hue-rotate(200deg) saturate(2.5)"
      imageOpacity={0.08}
    >
      <div class="hero-inner">
        <p class="eyebrow">Programmable Veterinary Biologics<sup>&trade;</sup></p>
        <h1>Engineering a new chapter in animal health.</h1>
        <p class="lead">BiomEdit engineers beneficial bacteria to deliver precise, targeted biologic activity. Our Programmable Veterinary Biologics<sup>&trade;</sup> platform aims to prevent and treat disease across animal species.</p>
        <Button color="amber" variant="filled" href="/pipeline">
          Explore our pipeline
          <svg viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </Button>
      </div>
    </FullBleedBand>
  </section>

  <FieldNotesHomeBody heroVariant="alt" />
</FieldNotesLayout>

<style>
  .hero :global(.full-bleed-inner) { text-align: center; }
  .hero-inner { position: relative; z-index: 1; max-width: 720px; margin: 0 auto; }
  .hero .eyebrow {
    font-size: var(--text-eyebrow); font-weight: 700; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--color-teal-dark); margin: 0 0 1.5rem;
  }
  .hero h1 { font-size: var(--text-h2); line-height: 1.2; margin: 0 0 1.5rem; color: #FFFFFF; }
  .hero .lead { font-weight: 500; font-size: 19px; line-height: 1.55; color: var(--cool-300); margin: 0 0 2rem; }
</style>
