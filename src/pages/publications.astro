---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import IntroLead from '../components/modules/IntroLead.astro';
import ModuleBlueText from '../components/modules/ModuleBlueText.astro';

const publications = [
  {
    title: 'Lactobacillus-vectored nanobodies improve broiler productivity under sub-clinical necrotic enteritis with associated microbiome and transcriptome changes',
    journal: 'npj Biofilms and Microbiomes',
    date: 'January 14, 2026',
    description: 'This study shows that Limosilactobacillus reuteri strains engineered to secrete nanobodies against Clostridium perfringens toxins improve feed conversion and weight gain in broiler chickens under sub-clinical necrotic enteritis, outperforming a conventional antibiotic. The paper also details how this treatment affects the jejunal microbiome and gene expression in the gut and liver.',
    link: 'https://doi.org/10.1038/s41522-026-00916-w',
    image: '/images/publications/cards/featured.jpg',
  },
  {
    title: 'Interactions between time on diet, antibiotic treatment, and liver abscess development on the fecal microbiome of beef cattle',
    journal: 'Animal Microbiome',
    date: 'May 12, 2025',
    description: 'Researchers analyzed the fecal microbiome of feedlot beef cattle across two studies to see whether microbial composition predicts liver abscess development, with and without antibiotic treatment (tylosin or narasin). The results show that fecal microbiome differences between abscessed and healthy cattle are subtle and mostly detectable early in the feeding period among antibiotic-treated animals.',
    link: 'https://doi.org/10.1186/s42523-025-00413-z',
    image: '/images/publications/cards/42523-2025-413.jpg',
  },
  {
    title: 'Designing host-associated microbiomes using the consumer/resource model',
    journal: 'mSystems',
    date: 'January 21, 2025',
    description: 'This paper introduces a generative model based on the consumer/resource framework for simulating and designing host-associated microbiomes, tested using rumen, chicken cecum, and human gut microbiome data. The model can predict which host phenotypes most constrain microbiome composition and generate microbial communities matching a desired host phenotype.',
    link: 'https://doi.org/10.1128/msystems.01068-24',
    image: '/images/publications/cards/msystems-01068-24.jpg',
  },
  {
    title: 'Effects of Limosilactobacillus reuteri strains PTA-126787 and PTA-126788 on intestinal barrier integrity and immune homeostasis in an alcohol-induced leaky gut model',
    journal: 'Scientific Reports',
    date: 'August 23, 2024',
    description: 'This study evaluates two Limosilactobacillus reuteri strains isolated from poultry (3630 and 3632) for phylogenetic similarity to human-associated strains, safety in a 28-day rat toxicity study, and efficacy against alcohol-induced leaky gut in mice. It also identifies a rare polyketide biosynthetic gene cluster in strain 3632 responsible for an AhR-activating orange pigment linked to its anti-inflammatory effects.',
    link: 'https://doi.org/10.1038/s41598-024-70549-6',
    image: '/images/publications/cards/41598-2024-70549.jpg',
  },
  {
    title: 'Evolving understanding of rumen methanogen ecophysiology',
    journal: 'Frontiers in Microbiology',
    date: 'November 6, 2023',
    description: 'This review summarizes current knowledge of rumen methanogen diversity, metabolism, and ecophysiology, covering how these archaea adapt to the rumen environment and contribute to enteric methane emissions in cattle. It outlines research gaps relevant to developing methane mitigation strategies for livestock.',
    link: 'https://doi.org/10.3389/fmicb.2023.1296008',
    image: '/images/publications/cards/fmicb-14-1296008.jpg',
  },
  {
    title: 'In silico, in vitro and in vivo characterization of host-associated Latilactobacillus curvatus strains for potential probiotic applications in farmed Atlantic salmon (Salmo salar)',
    journal: 'Scientific Reports',
    date: 'November 1, 2022',
    description: 'Researchers isolated and characterized Latilactobacillus curvatus strains from farmed Atlantic salmon intestines, using genomic, in vitro, and in vivo methods to evaluate them as potential probiotics for aquaculture. The paper covers safety screening and phylogenetic classification of these salmon-associated strains.',
    link: 'https://doi.org/10.1038/s41598-022-23009-y',
    image: '/images/publications/cards/41598-2022-23009.jpg',
  },
  {
    title: 'Transcriptome Analyses of Chicken Primary Macrophages Infected With Attenuated Salmonella Typhimurium Mutants',
    journal: 'Frontiers in Microbiology',
    date: 'May 3, 2022',
    description: 'This study profiles the intracellular survival and transcriptome response of chicken primary macrophages infected with attenuated Salmonella Typhimurium mutants related to the commercial MeganVac1 vaccine strain. The findings clarify how specific gene deletions affect bacterial metabolism and macrophage gene expression during infection.',
    link: 'https://doi.org/10.3389/fmicb.2022.857378',
    image: '/images/publications/cards/fmicb-13-857378.jpg',
  },
  {
    title: 'Growth promotion and antibiotic induced metabolic shifts in the chicken gut microbiome',
    journal: 'Communications Biology',
    date: 'April 1, 2022',
    description: "This paper compares how four different antimicrobial growth promoters (BMD, avilamycin, virginiamycin, and narasin) alter the cecal microbiome, gene function, and antimicrobial resistance gene profiles of broiler chickens. Metabolic modeling and metabolomics point to altered nitrogen utilization by core cecal microbes as a likely mechanism behind narasin's performance benefits.",
    link: 'https://doi.org/10.1038/s42003-022-03239-6',
    image: '/images/publications/cards/42003-2022-3239.jpg',
  },
  {
    title: 'Recombinant Limosilactobacillus (Lactobacillus) delivering nanobodies against Clostridium perfringens NetB and alpha toxin confers potential protection from necrotic enteritis',
    journal: 'MicrobiologyOpen',
    date: 'March 16, 2022',
    description: 'This study describes engineered Limosilactobacillus reuteri strains that deliver nanobodies neutralizing NetB and alpha toxin, two key virulence factors of Clostridium perfringens, as a strategy against necrotic enteritis in poultry. It covers nanobody generation, strain selection, and in vivo protection data.',
    link: 'https://doi.org/10.1002/mbo3.1270',
    image: '/images/publications/cards/mbo31270-gra-0001.jpg',
  },
  {
    title: 'In silico, in vitro and in vivo safety evaluation of Limosilactobacillus reuteri strains ATCC PTA-126787 & ATCC PTA-126788 for potential probiotic applications',
    journal: 'PLoS ONE',
    date: 'January 26, 2022',
    description: 'Researchers sequenced and safety-tested two novel Limosilactobacillus reuteri isolates (ATCC PTA-126787 and PTA-126788) using genomic, in vitro, and broiler chicken feeding studies. The strains showed no genetic markers of concern, susceptibility to relevant antibiotics, and safety profiles comparable to a commercial L. reuteri probiotic strain.',
    link: 'https://doi.org/10.1371/journal.pone.0262663',
    image: '/images/publications/cards/journal-pone-0262663.jpg',
  },
  {
    title: 'Multi-Omics Characterization of Host-Derived Bacillus spp. Probiotics for Improved Growth Performance in Poultry',
    journal: 'Frontiers in Microbiology',
    date: 'October 20, 2021',
    description: 'This paper presents a multi-omics characterization of host-derived, spore-forming Bacillus probiotic candidates for poultry, screening for genomic safety, metabolite production, and growth performance effects. One strain, Ba PTA84, significantly improved broiler growth performance in the study.',
    link: 'https://doi.org/10.3389/fmicb.2021.747845',
    image: '/images/publications/cards/fmicb-12-747845.jpg',
  },
];

const [featured, ...rest] = publications;

const patents = [
  { title: 'Genetically Modified Lactobacillus and Uses Thereof', number: 'U.S. Patent 12,599,637' },
  { title: 'Probiotic Compositions Comprising Lactobacillus reuteri Strains and Methods of Use', number: 'U.S. Patent 12,427,174' },
];

const patentCoverage = [
  'Engineered Lactobacillus reuteri strains capable of expressing therapeutic biomolecules in situ.',
  'Delivery systems enabling localized and sustained payload expression.',
  'Expression of biologically active proteins, including novel antibodies targeting Clostridium perfringens, a significant pathogen in animal health.',
  'Applications across multiple species, spanning livestock, pets and human health.',
];
---
<FieldNotesLayout title="Patents and Publications" active="publications">
  <IntroLead
    eyebrow="BiomEdit / Patents and Publications"
    heading="Peer-reviewed science behind the platform"
    paragraphs={['From strain engineering to field performance, our work is documented in peer-reviewed journals and protected by issued patents.']}
    variant="dark"
  />

  <section class="publications section-divider">
    <h2>Publications</h2>

    <a href={featured.link} target="_blank" rel="noopener" class="pub-featured">
      <div class="pub-featured-text">
        <p class="pub-featured-eyebrow">Latest Publication</p>
        <h3>{featured.title}</h3>
        <p class="pub-meta">{featured.journal} <span class="pub-meta-dash">&mdash;</span> {featured.date}</p>
        <p class="pub-featured-description">{featured.description}</p>
        <span class="pub-featured-cta">
          Read the paper
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
        </span>
      </div>
      <div class="pub-featured-image">
        <img src={featured.image} alt="" />
      </div>
    </a>

    <div class="pub-grid">
      {rest.map((p) => (
        <a href={p.link} target="_blank" rel="noopener" class="pub-card">
          <div class="pub-card-image">
            <img src={p.image} alt="" />
          </div>
          <div class="pub-card-text">
            <h3>{p.title}</h3>
            <p class="pub-meta">{p.journal} <span class="pub-meta-dash">&mdash;</span> {p.date}</p>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="patents section-divider">
    <h2>Patents</h2>
    <p class="patents-intro">BiomEdit has been issued several patents over the past four years, including two recent U.S. patents: &ldquo;Genetically Modified Lactobacillus and Uses Thereof&rdquo; (U.S. Patent 12,599,637) and &ldquo;Probiotic Compositions Comprising Lactobacillus reuteri Strains and Methods of Use&rdquo; (U.S. Patent 12,427,174). Each establishes protection for engineered Lactobacillus reuteri strains, including composition of matter and methods of use, and systems used to deliver biologically active molecules directly within the host. These patents are part of our Programmable Veterinary Biologics<sup>&trade;</sup> platform.</p>

    <div class="patent-grid">
      {patents.map((p) => (
        <div class="patent-card">
          <p class="patent-number">{p.number}</p>
          <h3>&ldquo;{p.title}&rdquo;</h3>
        </div>
      ))}
    </div>

    <div class="patent-coverage">
      <p class="patent-coverage-heading">These two patents cover:</p>
      <ul>
        {patentCoverage.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </section>

  <ModuleBlueText
    heading="Want to learn more about BiomEdit?"
    ctaLabel="View our pipeline"
    ctaHref="/pipeline"
    ctaStyle="button"
    image="/images/jonakoh-_-NPDRGf0w1lw-unsplash.jpg"
    zoom={1.05}
    imagePosition="50% 50%"
    blendMode="overlay"
    imageOpacity={0.45}
    noDivider
  />
</FieldNotesLayout>

<style>
  .section-divider { border-top: 1px solid var(--cool-500); }

  /* ---------- publications ---------- */
  .publications { margin-top: 24px; padding: 1.5rem 0 4rem; }
  .publications h2 { font-size: var(--text-h5); margin: 0 0 2rem; }

  .pub-featured {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 48px;
    align-items: stretch;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
    margin-bottom: 2.5rem;
  }
  .pub-featured-text { padding: 3rem 0 3rem 44px; display: flex; flex-direction: column; justify-content: center; }
  .pub-featured-eyebrow { font-size: var(--text-eyebrow); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-teal); margin: 0 0 1rem; }
  .pub-featured-text h3 { font-size: var(--text-h6); line-height: 1.3; color: var(--text-primary); margin: 0 0 0.75rem; }
  .pub-featured:hover .pub-featured-text h3 { color: var(--color-navy); }
  .pub-featured-description { font-size: var(--text-body); line-height: 1.5; color: var(--text-secondary); margin: 0.75rem 0 1.5rem; }
  .pub-featured-cta {
    display: inline-flex; align-items: center; gap: 6px;
    font-size: 16px; font-weight: 700; color: var(--color-navy);
    border-bottom: 1px solid var(--color-navy); padding-bottom: 0.25rem; align-self: flex-start;
  }
  .pub-featured-cta svg { width: 14px; height: 14px; }
  .pub-featured-image { position: relative; overflow: hidden; }
  .pub-featured-image img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .pub-featured-image::after { content: ''; position: absolute; inset: 0; background: rgba(28, 31, 40, 0.3); }

  .pub-meta { font-size: 16px; color: var(--text-secondary); margin: 0; }
  .pub-meta-dash { margin: 0 2px; }

  .pub-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .pub-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
    text-decoration: none;
  }
  .pub-card-image { position: relative; overflow: hidden; aspect-ratio: 16 / 10; }
  .pub-card-image img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .pub-card-image::after { content: ''; position: absolute; inset: 0; background: rgba(28, 31, 40, 0.3); }
  .pub-card-text { padding: 20px 20px 22px; display: flex; flex-direction: column; gap: 10px; }
  .pub-card-text h3 {
    font-size: 15px;
    font-weight: 700;
    line-height: 1.35;
    color: var(--text-primary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pub-card:hover .pub-card-text h3 { color: var(--color-navy); }

  /* ---------- patents ---------- */
  .patents { padding: 1.5rem 0 4rem; }
  .patents h2 { font-size: var(--text-h5); margin: 0 0 1.5rem; }
  .patents-intro { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0 0 2.5rem; max-width: 820px; }

  .patent-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; margin-bottom: 2.5rem; }
  .patent-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-left: 3px solid var(--color-navy);
    border-radius: 6px;
    padding: 2rem 28px;
  }
  .patent-number { font-size: 13px; font-weight: 700; letter-spacing: 0.04em; text-transform: uppercase; color: var(--color-navy); margin: 0 0 0.75rem; }
  .patent-card h3 { font-size: 18px; line-height: 1.4; color: var(--text-primary); margin: 0; }

  .patent-coverage-heading { font-size: 17px; font-weight: 700; color: var(--text-primary); margin: 0 0 1rem; }
  .patent-coverage ul { margin: 0; padding-left: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem; }
  .patent-coverage li { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); }

  @media (max-width: 900px) {
    .pub-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 860px) {
    .pub-featured { grid-template-columns: 1fr; gap: 0; }
    .pub-featured-image { order: -1; aspect-ratio: 16 / 9; }
    .pub-featured-text { padding: 2rem 28px; }
    .patent-grid { grid-template-columns: 1fr; }
  }
  @media (max-width: 600px) {
    .pub-grid { grid-template-columns: 1fr; }
  }
</style>
