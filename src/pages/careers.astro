---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import IntroLead from '../components/modules/IntroLead.astro';
import Button from '../components/Button.astro';

const values = [
  {
    name: 'Lead With Science',
    color: 'teal' as const,
    description: 'Evidence comes first. We advance the science, test our assumptions, and let the data determine what we do next.',
  },
  {
    name: 'Execute With Clarity',
    color: 'navy' as const,
    description: 'We move with precision. We are clear about what we are trying to accomplish, what matters most, and who is accountable for delivering it.',
  },
  {
    name: 'Build Together',
    color: 'orange' as const,
    description: 'Complex problems require different disciplines and perspectives to solve them. We are collaborative, we challenge one another, and we share accountability as we work toward better outcomes.',
  },
  {
    name: 'Pioneer With Purpose',
    color: 'green' as const,
    description: 'We pioneer new approaches in Programmable Veterinary Biologics<sup>&trade;</sup>, where they can make a meaningful difference in animal health. New technology matters only when it delivers real, measurable impact.',
  },
];
---
<FieldNotesLayout title="Careers">
  <IntroLead
    eyebrow="BiomEdit / Careers"
    heading="Careers at BiomEdit"
    paragraphs={[
      "We&rsquo;re a team of pioneers who care about the animals, the people who care for them, and the environment we all share. We come from diverse backgrounds, building together, challenging each other and science, to create something genuinely new. We&rsquo;re united by one mission: to engineer living biologics that prevent disease, treat conditions, and improve animal health.",
    ]}
    variant="dark"
  />

  <section class="careers-body">
    <div class="careers-columns">
      <div class="careers-content">
        <section class="vision-section">
          <p class="overline">Our Vision</p>
          <p class="vision-statement">Transform animal health by creating programmable biologic solutions that advance care and well-being.</p>
        </section>

        <section class="values-section">
          <p class="overline">Our Values</p>
          <div class="values-grid">
            {values.map((value) => (
              <div class="value-card" style={`--value-color:var(--color-${value.color});`}>
                <h3>{value.name}</h3>
                <p set:html={value.description} />
              </div>
            ))}
          </div>
        </section>
      </div>

      <div class="careers-image">
        <img src="/images/IMG_4407-careers.jpg" alt="BiomEdit team member at work" />
      </div>
    </div>

    <section class="careers-cta">
      <h2>If that speaks to you, we want to hear from you.</h2>
      <p>We&rsquo;re not actively hiring right now, but we&rsquo;re always glad to hear from people who believe in what we&rsquo;re building. Follow us on LinkedIn to stay close to what&rsquo;s next, or send us a note at <a href="mailto:info@biomedit.com">info@biomedit.com</a>.</p>
      <div class="careers-cta-buttons">
        <Button color="navy" variant="outline" href="https://www.linkedin.com/company/biomedit" target="_blank">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
          LinkedIn
        </Button>
        <Button color="amber" variant="filled" href="mailto:info@biomedit.com">Email us</Button>
      </div>
    </section>

    <section class="careers-address">
      <address>
        BiomEdit<br />
        Indiana Biosciences Research Institute<br />
        1210 Waterway Blvd., Suite 2000<br />
        Indianapolis, IN 46202
      </address>
    </section>
  </section>
</FieldNotesLayout>

<style>
  .careers-body { padding: 4rem 0 5rem; }

  .careers-body .overline { margin: 0 0 1.5rem; }

  .careers-columns { display: grid; grid-template-columns: 3fr 2fr; gap: 48px; align-items: stretch; padding-bottom: 4rem; }
  .careers-content { display: flex; flex-direction: column; gap: 3.5rem; }

  .careers-image img { display: block; width: 100%; height: 100%; min-height: 320px; object-fit: cover; border-radius: 6px; }

  .values-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .value-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-top: 3px solid var(--value-color);
    border-radius: 6px;
    padding: 1.75rem 22px;
  }
  .value-card h3 {
    font-size: 15px;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    margin: 0 0 0.75rem;
  }
  .value-card p { font-size: var(--text-body); line-height: 1.5; color: var(--text-secondary); margin: 0; }

  .vision-statement { font-size: var(--text-h5); line-height: 1.35; color: var(--text-primary); margin: 0; max-width: 640px; }

  .careers-cta { max-width: 840px; padding-bottom: 3.5rem; }
  .careers-cta h2 { font-size: var(--text-h5); line-height: 1.3; color: var(--text-primary); margin: 0 0 1.25rem; }
  .careers-cta p { font-size: var(--text-body); line-height: 1.6; color: var(--text-primary); margin: 0 0 2rem; max-width: 640px; }
  .careers-cta p a { color: var(--color-navy); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }
  .careers-cta-buttons { display: flex; gap: 16px; flex-wrap: wrap; }

  .careers-address address {
    font-style: normal;
    font-size: var(--text-body);
    line-height: 1.6;
    color: var(--text-secondary);
    margin: 0;
  }

  @media (max-width: 860px) {
    .careers-columns { grid-template-columns: 1fr; gap: 2rem; }
    .careers-image img { min-height: 240px; }
  }
  @media (max-width: 600px) {
    .values-grid { grid-template-columns: 1fr; }
    .careers-cta-buttons { flex-direction: column; align-items: flex-start; }
  }
</style>
