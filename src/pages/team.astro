---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import IntroLead from '../components/modules/IntroLead.astro';
import ModuleBlueText from '../components/modules/ModuleBlueText.astro';
import StatBlock from '../components/StatBlock.astro';
import { leaders } from '../data/leaders';

const teamStats = [
  { value: '20', label: 'Doctoral degrees' },
  { value: '4', label: 'MBAs' },
  { value: '9', label: 'Patents' },
  { value: '450+', label: 'Peer-reviewed publications' },
  { value: '200+', label: 'Years of combined leadership experience' },
];

// Alphabetical by first name.
const teamMembers = [
  { name: 'Aaron Cruz', title: 'Quality Manager', group: 'Regulatory', image: '/images/team-members/aaron-cruz.jpg', linkedin: 'https://www.linkedin.com/in/aaronjcruz/' },
  { name: 'Amy McMillan, PhD', title: 'Senior Director, Technical Development', group: 'Product Development', image: '/images/team-members/amy-mcmillan.jpg', linkedin: 'https://www.linkedin.com/in/amy-mcmillan-93477b144/' },
  { name: 'Ashley Hall, PhD', title: 'Research Scientist', group: 'Computational Sciences', image: '/images/team-members/ashley-hall.jpg', linkedin: 'https://www.linkedin.com/in/ashley-hall-wisc/' },
  { name: 'Bela Haifa Khairunisa, PhD', title: 'Research Scientist', group: 'Research', image: '/images/team-members/bela-khairunisa.jpg', linkedin: 'https://www.linkedin.com/in/bela-haifa-khairunisa-397781a7/' },
  { name: 'Brittany Weese', title: 'Operations Manager', group: 'Operations', image: '/images/team-members/brittany-weese.jpg', linkedin: 'https://www.linkedin.com/in/brittany-weese/' },
  { name: 'Casey Hooker, PhD', title: 'Research Scientist', group: 'Research', image: '/images/team-members/casey-hooker.jpg', linkedin: 'https://www.linkedin.com/in/casey-hooker-phd-218918219/' },
  { name: 'Desmond Adeniyi', title: 'Senior Scientist, Technical Development', group: 'Product Development', image: '/images/team-members/desmond-adeniyi.jpg', linkedin: 'https://www.linkedin.com/in/desmond-adeniyi-75382660/' },
  { name: 'Dharanesh Gangaiah, BVSc, MVSc, PhD', title: 'Executive Director, Head of Synthetic Biology and Bioprocess', group: 'Research', image: '/images/team-members/dharanesh-gangaiah.jpg', linkedin: 'https://www.linkedin.com/in/dharanesh-gangaiah-a00328125/' },
  { name: 'Dwi Susanti, PhD', title: 'Senior Director, Head of Microbial Discovery and Methane Emissions Reduction Research', group: 'Research', image: '/images/team-members/dwi-susanti.jpg', linkedin: 'https://www.linkedin.com/in/dwi-susanti/' },
  { name: 'Germán Plata, PhD', title: 'Senior Director, Computational Sciences', group: 'Computational Sciences', image: '/images/team-members/german-plata.jpg', linkedin: 'https://www.linkedin.com/in/german-plata-498a2835/' },
  { name: 'Isabel Danicich', title: 'Research Associate', group: 'Research', image: '/images/team-members/isabel-danicich.jpg', linkedin: 'https://www.linkedin.com/in/isabel-danicich/' },
  { name: 'Jacob Shields, PhD', title: 'Director & Lead Scientist, AI Research', group: 'Computational Sciences', image: '/images/team-members/jacob-shields.jpg', linkedin: 'https://www.linkedin.com/in/statshields/' },
  { name: 'Krishnakumar Vasudevan, PhD', title: 'Director & Lead Scientist, Strain Engineering', group: 'Research', image: '/images/team-members/krishnakumar-vasudevan.jpg', linkedin: 'https://www.linkedin.com/in/krishna-kumar-phd/' },
  { name: 'Kuldeep Gupta, PhD', title: 'Senior Scientist', group: 'Research', image: '/images/team-members/kuldeep-gupta.jpg', linkedin: 'https://www.linkedin.com/in/kuldeep-gupta-5643311a/' },
  { name: 'Lyvia Ebner', title: 'Director, R&D Project Management', group: 'Product Development', image: '/images/team-members/lyvia-ebner.jpg', linkedin: 'https://www.linkedin.com/in/lyvia-ferreira-ebner-msc-482b6748/' },
  { name: 'Michael Hicks', title: 'Research Scientist', group: 'Research', image: '/images/team-members/michael-hicks.jpg', linkedin: 'https://www.linkedin.com/in/michael-hicks-7a29b9195/' },
  { name: 'Neydis Moreno Morales, PhD', title: 'Postdoctoral Scientist', group: 'Research', image: '/images/team-members/neydis-moreno-morales.jpg', linkedin: 'https://www.linkedin.com/in/neydis-morenomorales/' },
  { name: 'Niel Baxter, PhD', title: 'Director, Market Analytics', group: 'Commercial', image: '/images/team-members/niel-baxter.jpg', linkedin: 'https://www.linkedin.com/in/niel-baxter-53318541/' },
  { name: 'Rhiannon Cecil, PhD', title: 'Microbiologist', group: 'Research', image: '/images/team-members/rhiannon-cecil.jpg', linkedin: 'https://www.linkedin.com/in/rhiannon-cecil-ph-d-b1962a203/' },
  { name: 'Roxanna Van Dorn', title: 'Director, Regulatory Affairs', group: 'Regulatory', image: '/images/team-members/roxanna-van-dorn.jpg', linkedin: 'https://www.linkedin.com/in/roxanna-van-dorn-rac-8115081/' },
  { name: 'Rupesh Kumar, PhD', title: 'Senior Research Scientist', group: 'Research', image: '/images/team-members/rupesh-kumar.jpg', linkedin: 'https://www.linkedin.com/in/organized-dna/' },
  { name: 'Ryan Blue', title: 'Lab Manager', group: 'Research', image: '/images/team-members/ryan-blue.jpg', linkedin: 'https://www.linkedin.com/in/ryan-blue-8878397/' },
  { name: 'Simmi Manuja, BVSc, MVSc, MSc, PhD', title: 'Senior Director, Clinical Development', group: 'Product Development', image: '/images/team-members/simmi-manuja.jpg', linkedin: 'https://www.linkedin.com/in/simmi-manuja-950a5228/' },
  { name: 'Troy Burtchett, PhD', title: 'Research Scientist', group: 'Research', image: '/images/team-members/troy-burtchett.jpg', linkedin: 'https://www.linkedin.com/in/troyburtchett/' },
];
---
<FieldNotesLayout title="Our Team" active="team">
  <IntroLead
    eyebrow="BiomEdit / Our Team"
    heading="Our scientists, researchers, product developers, and regulatory experts are building something new."
    paragraphs={['BiomEdit brings together scientists, engineers, and operators who have spent careers at the intersection of biology and commercial animal health. That combination of backgrounds is part of what makes this platform possible.']}
    variant="dark"
  />

  <section class="team-stats">
    <StatBlock stats={teamStats} align="center" />
  </section>

  <section class="leadership section-divider">
    <h2>Leadership</h2>
    <div class="leadership-grid">
      {leaders.map((leader) => (
        <div class="leader-card">
          <img class="leader-photo" src={leader.image} alt={`Portrait of ${leader.name}`} loading="lazy" />
          <div class="leader-info">
            <h3>{leader.name}</h3>
            <p class="leader-title">{leader.title}</p>
            {leader.linkedin && (
              <a class="leader-linkedin" href={leader.linkedin} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
                LinkedIn
              </a>
            )}
            <a class="leader-bio-link" href={`/leadership/${leader.slug}`}>Read full bio</a>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="team-members section-divider">
    <h2>Team Members</h2>
    <div class="member-grid">
      {teamMembers.map((member) => (
        <div class="member-card">
          <img class="member-photo" src={member.image} alt={`Headshot of ${member.name}`} loading="lazy" />
          <div class="member-info">
            <p class="member-group">{member.group}</p>
            <h3>{member.name}</h3>
            <p class="member-title">{member.title}</p>
            {member.linkedin && (
              <a class="member-linkedin" href={member.linkedin} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
                LinkedIn
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <ModuleBlueText
    heading="Discover more"
    paragraphs={['Join the conversation on LinkedIn.']}
    ctaLabel="View now"
    ctaHref="https://www.linkedin.com/company/biomedit"
    ctaTarget="_blank"
    ctaStyle="button"
    image="/images/jonakoh-_-NPDRGf0w1lw-unsplash.jpg"
    zoom={1.05}
    imagePosition="50% 50%"
    blendMode="overlay"
    imageOpacity={0.45}
    noDivider
  />
</FieldNotesLayout>

<style>
  .section-divider { border-top: 1px solid var(--cool-500); }

  .team-stats { padding: 3rem 0; }

  .leadership { padding: 3.5rem 0 4rem; }
  .leadership h2 { font-size: var(--text-h5); margin: 0 0 2rem; }

  .leadership-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }

  .leader-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
  }
  .leader-photo { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; }
  .leader-info { padding: 16px; }
  .leader-card h3 { font-size: 16px; margin: 0 0 0.25rem; }
  .leader-title { font-size: 16px; line-height: 1.4; color: var(--text-secondary); margin: 0 0 0.75rem; }

  .leader-linkedin {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-navy);
    text-decoration: none;
  }
  .leader-linkedin:hover { opacity: 0.75; }

  .leader-bio-link {
    display: block;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-navy);
    text-decoration: none;
    margin-top: 0.5rem;
  }
  .leader-bio-link:hover { opacity: 0.75; }

  @media (max-width: 900px) {
    .leadership-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 700px) {
    .leadership-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 420px) {
    .leadership-grid { grid-template-columns: 1fr; }
  }

  .team-members { padding: 3.5rem 0 4rem; }
  .team-members h2 { font-size: var(--text-h5); margin: 0 0 2rem; }

  .member-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 24px; }

  .member-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
  }
  .member-photo { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  .member-info { padding: 16px; }
  .member-group { font-size: 14px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-teal); margin: 0 0 0.5rem; }
  .member-card h3 { font-size: 16px; margin: 0 0 0.25rem; }
  .member-title { font-size: 16px; line-height: 1.4; color: var(--text-secondary); margin: 0 0 0.75rem; }

  .member-linkedin {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 14px;
    font-weight: 700;
    color: var(--color-navy);
    text-decoration: none;
  }
  .member-linkedin:hover { opacity: 0.75; }

  @media (max-width: 900px) {
    .member-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 700px) {
    .member-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 420px) {
    .member-grid { grid-template-columns: 1fr; }
  }
</style>
