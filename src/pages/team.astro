  { name: 'Kuldeep Gupta, PhD', title: 'Senior Scientist', group: 'Research', image: '/images/team-members/kuldeep-gupta.jpg', linkedin: 'https://www.linkedin.com/in/kuldeep-gupta-5643311a/' },
  { name: 'Lyvia Ebner', title: 'Director, R&D Project Management', group: 'Product Development', image: '/images/team-members/lyvia-ebner.jpg', linkedin: 'https://www.linkedin.com/in/lyvia-ferreira-ebner-msc-482b6748/' },
  { name: 'Michael Hicks', title: 'Research Scientist', group: 'Research', image: '/images/team-members/michael-hicks.jpg', linkedin: 'https://www.linkedin.com/in/michael-hicks-7a29b9195/' },
  { name: 'Neydis Moreno Morales, PhD', title: 'Postdoctoral Scientist', group: 'Research', image: '/images/team-members/neydis-moreno-morales.jpg', linkedin: 'https://www.linkedin.com/in/neydis-morenomorales/' },
  { name: 'Niel Baxter, PhD', title: 'Director, Market Analytics', group: 'Commercial', image: '/images/team-members/niel-baxter.jpg', linkedin: 'https://www.linkedin.com/in/niel-baxter-53318541/' },
  { name: 'Rhiannon Cecil, PhD', title: 'Microbiologist', group: 'Research', image: '/images/team-members/rhiannon-cecil.jpg', linkedin: 'https://www.linkedin.com/in/rhiannon-cecil-ph-d-b1962a203/' },
