---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import IntroLead from '../components/modules/IntroLead.astro';
import ModuleBlueText from '../components/modules/ModuleBlueText.astro';

const leaders = [
  {
    name: 'Aaron Schacht',
    title: 'Chief Executive Officer',
    image: '/images/leadership/aaron-schacht.jpg',
    linkedin: 'https://www.linkedin.com/in/aaronlschacht/',
    preview: 'Aaron Schacht is Chief Executive Officer, President, and a board member of BiomEdit, an animal health biotechnology company he founded in 2022 through a strategic carveout from Elanco Animal Health (NYSE: ELAN) and a strategic partnership with Ginkgo Bioworks (NYSE: DNA).',
    bio: [
      'Aaron Schacht is Chief Executive Officer, President, and a board member of BiomEdit, an animal health biotechnology company he founded in 2022 through a strategic carveout from Elanco Animal Health (NYSE: ELAN) and a strategic partnership with Ginkgo Bioworks (NYSE: DNA). With over 35 years in life sciences and animal health, Aaron believes in empowering his teams to create, innovate, and revolutionize products and solutions that can truly impact lives.',
      'Since founding BiomEdit, Aaron has built the company into a platform business developing Programmable Veterinary Biologics™, engineered living therapeutics addressing infectious disease, sustainability, and chronic disease across five animal species. Under his leadership, BiomEdit has successfully raised two rounds of capital exceeding $55M combined. Since BiomEdit’s founding in 2022 the company has advanced the first of its kind engineered bacterial therapeutic, Clostridium Perfringens Alpha Toxin and NetB Antibody Fragment, Live Limosilactobacillus Vector or CPerf LLV (aka BE-101), to USDA conditional licensure, targeting a novel non-antibiotic veterinary biologic to address necrotic enteritis in broiler chickens, a disease costing the industry an estimated $6 billion annually.',
      'Aaron’s leadership has earned industry recognition, including the 2023 Visionary CEO award from S&P Global Animal Health. BiomEdit was named Best Start-Up in Animal Health by S&P Global in 2022 and won Deal of the Year at the 2026 TechPoint Mira Awards for its Series B round. Under his leadership, BiomEdit has also secured significant non-dilutive funding from leading organizations, including the Bill & Melinda Gates Foundation, Global Methane Hub, Bezos Earth Fund, NIH, and USDA, capital that has extended the company’s R&D runway and accelerated its path toward commercialization.',
      'Before founding BiomEdit, Aaron spent six years at Elanco Animal Health leading research and development, regulatory affairs, and business development. He transformed Elanco’s innovation model, led the strategic acquisitions of Bayer Animal Health, Aratana Therapeutics, and Kindred Biosciences, and was part of the founding executive team that took Elanco public in 2018. His R&D teams brought more than a dozen products to market during his tenure, including Interceptor Plus, Credelio, Galliprant, Clynav, Experior, and Elura.',
      'Prior to Elanco, Aaron spent 25 years at Eli Lilly and Company, starting as a discovery research chemist and moving through roles in R&D, strategy, external innovation, and product development. His last role there was leading the late stage development program that resulted in the approval of Emgality, a CGRP neutralizing monoclonal antibody for migraine and cluster headache prevention.',
      'Aaron serves on the boards of Gallant, Mileutis, Ophirex, Purdue Research Foundation and Indiana Biosciences Research Institute. Aaron is also Chair Emeritus of Agrinovus Indiana. Aaron earned his bachelor’s degree in chemical sciences from the University of Illinois in 1990.',
    ],
  },
  {
    name: 'Eric Young, MBA',
    title: 'Chief Financial Officer and Chief Business Officer',
    image: '/images/leadership/eric-young.jpg',
    linkedin: 'https://www.linkedin.com/in/eric-young-48a74331/',
    preview: 'Eric serves as Chief Financial Officer and Chief Business Officer of BiomEdit, where he leads the company’s finance, business development, capital strategy, and strategic partnerships.',
    bio: [
      'Eric serves as Chief Financial Officer and Chief Business Officer of BiomEdit, where he leads the company’s finance, business development, capital strategy, and strategic partnerships. Since co-founding BiomEdit through its strategic carve-out from Elanco Animal Health, he has helped build the company’s financial and operational foundation, led its Series A and oversubscribed Series B financings totaling approximately $55 million, secured significant non-dilutive funding, and negotiated strategic collaborations that advance BiomEdit’s Programmable Veterinary Biologics™ platform.',
      'With more than 25 years of leadership experience across biotechnology, animal health, and life sciences, Eric has a proven track record of creating enterprise value through capital raising, M&A, licensing, strategic partnerships, and operational excellence. Prior to BiomEdit, he led strategic growth initiatives at Elanco Animal Health and held senior business development, corporate finance, and investment leadership roles at Eli Lilly and Company, where he executed transformative transactions across both human and animal health. Eric also serves on the Board of AgriNovus.',
      'Eric holds an MBA in Finance from the Indiana University Kelley School of Business.',
    ],
  },
  {
    name: 'Bruce Schelkopf, MS, MBA, JD, PhD/DBA',
    title: 'General Counsel, Chief IP Officer, & Company Secretary',
    image: '/images/leadership/bruce-schelkopf.jpg',
    linkedin: 'https://www.linkedin.com/in/bruceschelkopf/',
    preview: 'J. Bruce Schelkopf serves as BiomEdit’s Chief Legal Officer, Chief Administrative Officer, Company Secretary, and Chief Intellectual Property Officer.',
    bio: [
      'J. Bruce Schelkopf serves as BiomEdit’s Chief Legal Officer, Chief Administrative Officer, Company Secretary, and Chief Intellectual Property Officer. As a member of the executive leadership team, he provides strategic leadership across legal affairs, intellectual property, corporate governance, compliance, enterprise risk management, and administrative operations while supporting the Company’s growth strategy, financing initiatives, commercialization programs, strategic partnerships, and corporate development activities. With more than 25 years of experience spanning law, business, and innovation, he serves as a trusted advisor to the Board of Directors and executive leadership team on complex business, technology, intellectual property, and operational matters advancing BiomEdit’s mission to precisely engineer living biologics that prevent disease, treat conditions, and improve animal health.',
      'Bruce brings global experience spanning biotechnology, animal health, industrial technology, artificial intelligence, electronics, digital systems, and advanced manufacturing. Prior executive leadership roles include Elanco, ABB, Ingersoll Rand, and other global organizations, where he led initiatives involving intellectual property, legal operations, compliance, technology strategy, business transformation, and strategic growth.',
      'His multidisciplinary background integrates engineering, technology, business, and law, including a Doctorate in Management and Economics from SDA Bocconi, executive education from Stanford Graduate School of Business, Harvard, and IMD, and degrees in engineering and law. He also serves as a Distinguished Adjunct Professor at Indiana University Maurer School of Law, teaching technology, AI, cybersecurity, and innovation.',
    ],
  },
  {
    name: 'Arvind Kumar, BVSc, MVSc, MS, PhD',
    title: 'Vice President, Research',
    image: '/images/leadership/arvind-kumar.jpg',
    linkedin: 'https://www.linkedin.com/in/arvind-kumar-mahajan-7a7b4414/',
    preview: 'Dr. Arvind Kumar serves as Vice President of Research and Co-Founder of BiomEdit, where he leads the company’s scientific strategy, translational research programs, and global scientific partnerships.',
    bio: [
      'Dr. Arvind Kumar serves as Vice President of Research and Co-Founder of BiomEdit, where he leads the company’s scientific strategy, translational research programs, and global scientific partnerships. A pioneer in microbiome science and biotechnology innovation, Dr. Arvind architected the probiotic delivery platform and foundational microbiome research that underpin BiomEdit’s Programmable Veterinary Biologics™ technology.',
      'A recognized leader in microbial engineering, animal health, and vaccine innovation, Arvind has spearheaded the development of BiomEdit’s flagship platforms, including probiotic-vectored biologics (pvAb™), AI-powered Digital Twin models, and microbial solutions for methane mitigation. He has helped raise significant non-dilutive funding from leading organizations, including the Bill & Melinda Gates Foundation, Global Methane Hub, Bezos Earth Fund, NIH, and USDA, advancing and de-risking BiomEdit’s innovation pipeline while fostering strategic collaborations across academia, industry, and the public sector.',
      'A veterinarian by training, Arvind combines deep expertise in biologics research with a passion for translating breakthrough science into impactful products. With more than three decades of experience spanning academia, industry, and veterinary practice, he has held leadership roles at Elanco Animal Health, Lohmann Animal Health (Germany), the Roslin Institute, and the University of Edinburgh (UK) and College of Veterinary Sciences Palampur (India). Having built and led high-performing teams across Asia, Europe, and the United States, he brings a globally minded, culturally agile leadership style that fosters innovation, collaboration, and scientific excellence.',
      'Arvind holds degrees in Veterinary Medicine, Veterinary Microbiology from Agriculture University Palampur, Immunology from Imperial College London, and a PhD from the University of Edinburgh. He is passionate about translating breakthrough science into practical solutions that advance animal health, food security, and environmental sustainability. As the original inventor of Clostridium Perfringens Alpha Toxin and NetB Antibody Fragment, Live Limosilactobacillus Vector or CPerf LLV (aka BE-101), Arvind has helped translate an innovative concept into a product advancing toward commercial deployment. He is an inventor on more than 30 granted and pending patent families and has authored more than 70 peer-reviewed scientific publications spanning microbial engineering, synthetic biology, immunology, and animal health.',
    ],
  },
  {
    name: 'Kristin Bloink, DVM, MPH, DACVPM',
    title: 'Vice President, Product Development',
    image: '/images/leadership/kristin-bloink.jpg',
    linkedin: 'https://www.linkedin.com/in/kristin-bloink-b9597023/',
    preview: 'Kristin Bloink is Vice President of Development at BiomEdit. She is a seasoned leader in animal health innovation with nearly two decades of industry experience spanning biologics, small molecules, and nutritional projects/products across companion animals, farm species, and aquaculture.',
    bio: [
      'Kristin Bloink is Vice President of Development at BiomEdit. She is a seasoned leader in animal health innovation with nearly two decades of industry experience spanning biologics, small molecules, and nutritional projects/products across companion animals, farm species, and aquaculture. She began her industry career in clinical development, external innovation, and project leadership at Novartis Animal Health, ultimately advancing into multiple vice president roles overseeing research, external innovation, development, and regulatory/pharmacovigilance at Elanco.',
      'A practicing veterinarian for 20 years and former physician assistant in both private practice and the military, Kristin served in the U.S. Army Specialty Corps as a physician assistant and the U.S. Army Veterinary Corps as a veterinarian, bringing a rare depth of translational medicine expertise, as a clinician and a career-long commitment to moving breakthrough science from concept to patient, animal, or human.',
      'She joined BiomEdit in 2025 to reengage with the microbiome technology platform she helped build at Elanco. Today, she leads product development, driving Clostridium Perfringens Alpha Toxin and NetB Antibody Fragment, Live Limosilactobacillus Vector or CPerf LLV (aka BE-101), the company’s first registered product, toward market launch and establishing the foundations for sustained commercial success. Her work reflects both scientific rigor and a deep passion for innovation that meaningfully improves health and productivity outcomes.',
      'She holds a DVM from Michigan State University College of Veterinary Medicine.',
    ],
  },
  {
    name: 'Emily Helmes, MBA',
    title: 'Vice President, Regulatory',
    image: '/images/leadership/emily-helmes.jpg',
    linkedin: 'https://www.linkedin.com/in/emily-b-helmes/',
    preview: 'Emily Bulian Helmes is Vice President of Regulatory at BiomEdit, where she leads global regulatory strategy and quality management to support the commercialization of BiomEdit’s Programmable Veterinary Biologics™, engineered living therapeutics addressing infectious disease, sustainability, and chronic disease across five animal species.',
    bio: [
      'Emily Bulian Helmes is Vice President of Regulatory at BiomEdit, where she leads global regulatory strategy and quality management to support the commercialization of BiomEdit’s Programmable Veterinary Biologics™, engineered living therapeutics addressing infectious disease, sustainability, and chronic disease across five animal species. With more than 20 years of regulatory affairs experience, she brings a balanced perspective of technical expertise, business strategy, and executive leadership.',
      'With senior leadership experience spanning BiomEdit, Elanco Animal Health, and ChemGen Corp., Emily has built and led high-performing cross-functional teams across regulatory affairs and quality systems, and worked collaboratively with product development and global market access. She is recognized for aligning complex regulatory strategies with broader business objectives, fostering organizational agility, and driving innovation in highly regulated environments.',
      'At BiomEdit, Emily leads the regulatory strategy that resulted in the licensure of a first-in-class veterinary biologic for poultry health, Clostridium Perfringens Alpha Toxin and NetB Antibody Fragment, Live Limosilactobacillus Vector or CPerf LLV (aka BE-101), achieving approval on an accelerated timeline and positioning the company for commercial growth. As a trusted executive leader, she contributes to corporate strategy and industry advancement through active leadership roles with organizations including AFIA and ETA and as an industry advisor with AAFCO, helping shape policy and accelerate innovation across the animal health sector.',
      'Emily holds a degree in chemistry from Tufts University with an MBA from the University of California, Berkeley Haas School of Business.',
    ],
  },
  {
    name: 'Andrew Carlson, MBA',
    title: 'Chief Commercial Officer',
    image: '/images/leadership/andrew-carlson.jpg',
    linkedin: null,
    preview: 'Andrew Carlson is Chief Commercial Officer at BiomEdit, leading commercial strategy and go-to-market execution as the company launches Clostridium Perfringens Alpha Toxin and NetB Antibody Fragment, Live Limosilactobacillus Vector or CPerf LLV (aka BE-101).',
    bio: [
      'Andrew Carlson is Chief Commercial Officer at BiomEdit, leading commercial strategy and go-to-market execution as the company launches Clostridium Perfringens Alpha Toxin and NetB Antibody Fragment, Live Limosilactobacillus Vector or CPerf LLV (aka BE-101). He brings more than two decades of commercial, operations, and finance leadership across animal health and agribusiness, with a track record of leading M&A activity at two Fortune 100 companies alongside his commercial and operational roles.',
      'Before joining BiomEdit, Andrew served as Vice President of Business Operations at Aviagen North America. He previously held dual roles at Elanco Animal Health as Executive Director of Global Nutrition & Health and Executive Director of the U.S. Poultry Business Unit. As Vice President at Archer Daniels Midland, he built the company’s global Bioactives division from the ground up within a broader feed additives and ingredients business.',
      'Before that, Andrew held many positions in live production at Central Coast Farms, eventually leading the company as CEO.',
      'He holds a Master of Business Administration from Indiana University’s Kelley School of Business, a Master of Science in Agricultural Economics from Purdue University, and a Bachelor of Arts in Law & Society from the University of California, Santa Barbara.',
    ],
  },
];

// Alphabetical by first name.
const teamMembers = [
  { name: 'Aaron Cruz', title: 'Quality Manager', group: 'Regulatory', image: '/images/team-members/aaron-cruz.jpg', linkedin: 'https://www.linkedin.com/in/aaronjcruz/' },
  { name: 'Amy McMillan, PhD', title: 'Senior Director, Technical Development', group: 'Product Development', image: '/images/team-members/amy-mcmillan.jpg', linkedin: 'https://www.linkedin.com/in/amy-mcmillan-93477b144/' },
  { name: 'Ashley Hall, PhD', title: 'Research Scientist', group: 'Computational Sciences', image: '/images/team-members/ashley-hall.jpg', linkedin: 'https://www.linkedin.com/in/ashley-hall-wisc/' },
  { name: 'Bela Haifa Khairunisa, PhD', title: 'Research Scientist', group: 'Research', image: '/images/team-members/bela-khairunisa.jpg', linkedin: 'https://www.linkedin.com/in/bela-haifa-khairunisa-397781a7/' },
  { name: 'Brittany Weese', title: 'Operations Manager', group: 'Operations', image: '/images/team-members/brittany-weese.jpg', linkedin: 'https://www.linkedin.com/in/brittany-weese/' },
  { name: 'Casey Hooker, PhD', title: 'Research Scientist', group: 'Research', image: '/images/team-members/casey-hooker.jpg', linkedin: 'https://www.linkedin.com/in/casey-hooker-phd-218918219/' },
  { name: 'Desmond Adeniyi', title: 'Senior Scientist, Technical Development', group: 'Product Development', image: '/images/team-members/desmond-adeniyi.jpg', linkedin: 'https://www.linkedin.com/in/desmond-adeniyi-75382660/' },
  { name: 'Dharanesh Gangaiah, BVSc, MVSc, PhD', title: 'Executive Director, Head of Synthetic Biology and Bioprocess', group: 'Research', image: '/images/team-members/dharanesh-gangaiah.jpg', linkedin: 'https://www.linkedin.com/in/dharanesh-gangaiah-a00328125/' },
  { name: 'Dwi Susanti, PhD', title: 'Senior Director, Head of Microbial Discovery and Methane Emissions Reduction Research', group: 'Research', image: '/images/team-members/dwi-susanti.jpg', linkedin: 'https://www.linkedin.com/in/dwi-susanti/' },
  { name: 'Germán Plata, PhD', title: 'Senior Director, Computational Sciences', group: 'Computational Sciences', image: '/images/team-members/german-plata.jpg', linkedin: 'https://www.linkedin.com/in/german-plata-498a2835/' },
  { name: 'Isabel Danicich', title: 'Research Associate', group: 'Research', image: '/images/team-members/isabel-danicich.jpg', linkedin: 'https://www.linkedin.com/in/isabel-danicich/' },
  { name: 'Jacob Shields, PhD', title: 'Director & Lead Scientist, AI Research', group: 'Computational Sciences', image: '/images/team-members/jacob-shields.jpg', linkedin: 'https://www.linkedin.com/in/statshields/' },
