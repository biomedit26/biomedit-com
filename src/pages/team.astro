---
<FieldNotesLayout title="Our Team" active="team">
  <IntroLead
    eyebrow="BiomEdit / Our Team"
    heading="Scientists and experts building something new."
    paragraphs={['BiomEdit brings together scientists, engineers, and operators who have spent careers at the intersection of biology and commercial animal health. Many of us have worked together for decades. That shared history is part of what makes this platform possible.']}
    variant="dark"
  />

  <section class="leadership section-divider">
    <h2>Leadership Bios</h2>
    <div class="leadership-grid">
      {leaders.map((leader) => (
        <div class="leader-card">
          <img class="leader-photo" src={leader.image} alt={`Headshot of ${leader.name}`} loading="lazy" />
          <div class="leader-info">
            <h3>{leader.name}</h3>
            <p class="leader-title">{leader.title}</p>
            {leader.linkedin && (
              <a class="leader-linkedin" href={leader.linkedin} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
                LinkedIn
              </a>
            )}
            <p class="leader-preview">{leader.preview}</p>
          </div>
          <details class="leader-details">
            <summary>
              <span>Read full bio</span>
              <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M2.5 4.5L6 8L9.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path></svg>
            </summary>
            <div class="leader-bio">
              {leader.bio.map((p) => <p>{p}</p>)}
            </div>
          </details>
        </div>
      ))}
    </div>
  </section>

  <section class="team-members section-divider">
    <h2>Team Members</h2>
    <div class="member-grid">
      {teamMembers.map((member) => (
        <div class="member-card">
          <img class="member-photo" src={member.image} alt={`Headshot of ${member.name}`} loading="lazy" />
          <div class="member-info">
            <p class="member-group">{member.group}</p>
            <h3>{member.name}</h3>
            <p class="member-title">{member.title}</p>
            {member.linkedin && (
              <a class="member-linkedin" href={member.linkedin} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
                LinkedIn
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <ModuleBlueText
    heading="Discover more"
    paragraphs={['Join the conversation on LinkedIn.']}
    ctaLabel="View now"
    ctaHref="https://www.linkedin.com/company/biomedit"
    ctaTarget="_blank"
    ctaStyle="button"
    image="/images/jonakoh-_-NPDRGf0w1lw-unsplash.jpg"
    zoom={1.05}
    imagePosition="50% 50%"
    blendMode="overlay"
    imageOpacity={0.45}
    noDivider
  />
</FieldNotesLayout>

<style>
  .section-divider { border-top: 1px solid var(--cool-500); }

  .leadership { padding: 3.5rem 0 4rem; }
  .leadership h2 { font-size: var(--text-h5); margin: 0 0 2rem; }

  .leadership-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 32px; }

  .leader-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 24px;
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 8px 24px;
    align-items: start;
  }
  .leader-photo { grid-column: 1; grid-row: 1; display: block; width: 100%; aspect-ratio: 2 / 3; object-fit: cover; border-radius: 6px; }
  .leader-info { grid-column: 2; grid-row: 1; }
  .leader-card h3 { font-size: var(--text-h6); margin: 0 0 0.35rem; }
  .leader-title { font-size: var(--text-body); line-height: 1.4; color: var(--text-secondary); margin: 0 0 1rem; }

  .leader-linkedin {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 16px;
    font-weight: 700;
    color: var(--color-navy);
    text-decoration: none;
    margin-bottom: 1rem;
  }
  .leader-linkedin:hover { opacity: 0.75; }

  .leader-preview { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0; }

  .leader-details { grid-column: 1 / -1; grid-row: 2; margin-top: 0.75rem; }
  .leader-details summary {
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 16px;
    font-weight: 700;
    color: var(--color-navy);
    cursor: pointer;
    list-style: none;
  }
  .leader-details summary::-webkit-details-marker { display: none; }
  .leader-details summary::marker { content: ''; }
  .leader-details .chevron { transition: transform 0.18s ease; }
  .leader-details[open] .chevron { transform: rotate(180deg); }

  .leader-bio { padding-top: 1rem; max-width: 720px; }
  .leader-bio p { font-size: var(--text-body); line-height: 1.55; color: var(--text-primary); margin: 0 0 1rem; }
  .leader-bio p:last-child { margin-bottom: 0; }

  @media (max-width: 700px) {
    .leadership-grid { grid-template-columns: 1fr; }
    .leader-card { grid-template-columns: 120px 1fr; }
  }
  @media (max-width: 480px) {
    .leader-card { grid-template-columns: 1fr; }
    .leader-info { grid-column: 1; grid-row: 2; }
    .leader-details { grid-row: 3; }
    .leader-photo { max-width: 220px; }
  }

  .team-members { padding: 3.5rem 0 4rem; }
