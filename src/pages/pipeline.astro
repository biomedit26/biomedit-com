---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import IntroLead from '../components/modules/IntroLead.astro';
import ModulePlainText from '../components/modules/ModulePlainText.astro';
import PipelineTracker from '../components/modules/PipelineTracker.astro';
import ModuleBlueText from '../components/modules/ModuleBlueText.astro';
import CTALink from '../components/CTALink.astro';

const stages = [
  { eyebrow: 'Stage 1', label: 'Discovery / Design' },
  { eyebrow: 'Stage 2', label: 'Candidate Optimization' },
  { eyebrow: 'Stage 3', label: 'Proof of Concept' },
  { eyebrow: 'Stage 4', label: 'Pivotal Studies' },
  { eyebrow: 'Stage 5', label: 'Regulatory Approval / Launch Readiness' },
  { eyebrow: 'Stage 6', label: 'Commercial' },
];

// Species coverage note: the sitemap indicates humans will be added as a
// future species — not reflected here or in the footnote below yet.
const candidates = [
  {
    id: 'CPerf LLV*/(BE-101)',
    category: 'teal' as const,
    species: 'Poultry',
    speciesKey: 'poultry' as const,
    mechanism: 'Nanobody',
    stage: 5,
    stageNote: 'Regulatory / Launch Readiness. Conditional USDA licensure. Commercial launch Q4 2026.',
    description: 'A best-in-class engineered probiotic that secretes nanobodies neutralizing Clostridium perfringens toxins in the broiler gut, protecting chickens from necrotic enteritis without antibiotics. Reduces mortality and supports flock performance.',
    ctaLabel: 'Read more',
    ctaHref: '/products',
  },
  {
    id: 'BEX1 (BiomElix® One)',
    category: 'teal' as const,
    species: 'Poultry',
    speciesKey: 'poultry' as const,
    mechanism: 'CRISPR-based editing (Guided Biotic)',
    stage: 5,
    stageNote: "Regulatory Approval / Launch Readiness. Approved by Brazil's MAPA.",
    description: "A non-GMO feed additive built on CRISPR-based technology that selectively targets harmful bacteria, including Salmonella, while preserving beneficial microbes in the poultry gut microbiome. Approved by Brazil's Ministry of Agriculture (MAPA) as part of BiomEdit's acquisition of Folium Science.",
  },
  {
    id: 'BE-118',
    category: 'teal' as const,
    species: 'Poultry',
    speciesKey: 'poultry' as const,
    mechanism: 'Nanobody',
    stage: 2,
    stageNote: 'Candidate Optimization / In Vivo Study',
    description: 'Probiotic vectored antibodies targeting HA antigens on the avian influenza (HPAI) virus, designed to reduce viral burden and shedding in poultry as a complement or alternative to conventional HPAI prevention.',
  },
  {
    id: 'BE-119',
    category: 'teal' as const,
    species: 'Swine',
    speciesKey: 'swine' as const,
    mechanism: 'Enzyme',
    stage: 2,
    stageNote: 'Candidate Optimization / In Vivo Study',
    description: 'A probiotic vectored enzyme therapeutic that aims to reduce E. coli-driven diarrhea in piglets and scours in calves, supporting gut health and growth without relying on antibiotics.',
  },
  {
    id: 'BE-017',
    category: 'green' as const,
    species: 'Cattle',
    speciesKey: 'cattle' as const,
    mechanism: 'Microbial Consortia',
    stage: 2,
    stageNote: 'Candidate Optimization',
    description: 'A tailored microbial consortium that reshapes the rumen microbiome to lower methane emissions in dairy and beef cattle, improving productivity with potential for infrequent dosing in grazing herds.',
  },
  {
    id: 'BE-117',
    category: 'green' as const,
    species: 'Cattle',
    speciesKey: 'cattle' as const,
    mechanism: 'Nanobody & Peptide',
    stage: 2,
    stageNote: 'Candidate Optimization',
    description: 'A first-in-class engineered rumen strain that continuously delivers anti-methanogen peptide and nanobody biomolecules directly in the rumen of dairy and beef cattle, reducing enteric methane emissions while improving feed efficiency and productivity.',
  },
  {
    id: 'BE-105',
    category: 'amber' as const,
    species: 'Feline',
    speciesKey: 'feline' as const,
    mechanism: 'Peptide',
    stage: 2,
    stageNote: 'Candidate Optimization / In Vivo Study',
    description: 'A first-in-class engineered oral biologic that delivers a sustained GLP-1 receptor agonist directly in the gut, supporting chronic weight management in cats, with obesity as the initial target and diabetes and canine applications as future extensions.',
  },
  {
    id: 'BE-122',
    category: 'amber' as const,
    species: 'Canine',
    speciesKey: 'canine' as const,
    mechanism: 'Nanobody',
    stage: 1,
    stageNote: 'Discovery / Design',
    description: 'Probiotic vectored antibodies designed to treat inflammatory bowel disease (IBD) in dogs, offering a potential alternative or complement to chronic corticosteroid therapy, with possible extension to cats.',
  },
];
---
<FieldNotesLayout title="Pipeline" active="pipeline">
  <IntroLead
    eyebrow="BiomEdit / Pipeline"
    heading="Making biology programmable for animal health"
    paragraphs={[
      "We&rsquo;re innovators. We look for measurable gaps in animal health and build the Programmable Veterinary Biologics<sup>&trade;</sup> to close them.",
    ]}
    variant="dark"
  />

  <section class="spotlight-section">
    <div class="spotlight">
      <div class="spotlight-text">
        <p class="eyebrow">Featured Program — Infectious Disease</p>
        <h3>CPerf LLV* (BE-101) granted USDA Conditional Licensure.</h3>
        <div class="spotlight-facts">
          <div class="spotlight-fact">
            <svg class="fact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><polyline points="8 12 11 15 16 9"></polyline></svg>
            <p>First Programmable Veterinary Biologic&trade; to reach commercial launch (Q4 2026)</p>
          </div>
          <div class="spotlight-fact">
            <svg class="fact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><polyline points="8 12 11 15 16 9"></polyline></svg>
            <p>First engineered bacterial biologic to achieve licensure for poultry.</p>
          </div>
          <div class="spotlight-fact">
            <svg class="fact-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><polyline points="8 12 11 15 16 9"></polyline></svg>
            <p>A new non-antibiotic approach designed to give producers an option for managing necrotic enteritis.</p>
          </div>
        </div>
        <CTALink href="/products">Learn about CPerf LLV*</CTALink>
      </div>
      <img src="/images/selective-focus-shot-of-indoors-chicken-farm-chic-2023-11-27-05-20-42-utc.png" alt="Close-up of broiler chickens" />
    </div>
  </section>

  <div class="focus-text">
    <ModulePlainText
      heading="Three focus areas. One BiomEdit platform."
      paragraphs={[
        'Our Programmable Veterinary Biologics<sup>&trade;</sup> platform spans three focus areas: <strong>infectious disease</strong>, <strong>sustainability</strong>, and <strong>chronic disease</strong>. We engineer beneficial bacteria to perform specific biological functions, including producing nanobodies, peptides, or enzymes, or working together as microbial consortia. Our platform also incorporates technology acquired from Folium Science that selectively targets specific bacterial populations already present in the microbiome. These complementary approaches can be applied across livestock and companion animals, with in-house capabilities spanning discovery, development, regulatory, and commercialization.',
      ]}
    />
  </div>

  <section class="tracker-section">
    <PipelineTracker
      stages={stages}
      candidates={candidates}
      footnote="Our programs address the needs of poultry, cattle, swine, dogs, and cats."
    />
  </section>

  <section class="footnote">
    <p>*Clostridium Perfringens Alpha Toxin and NetB Antibody Fragment, Live Limosilactobacillus Vector</p>
  </section>

  <ModuleBlueText
    heading="Interested in what&rsquo;s next for BiomEdit?"
    ctaLabel="Partner with us"
    ctaHref="/investors-partners"
    noDivider
    image="/images/jonakoh-_-NPDRGf0w1lw-unsplash.jpg"
    zoom={1.05}
    imagePosition="50% 50%"
    blendMode="overlay"
    imageOpacity={0.45}
  />
</FieldNotesLayout>

<style>
  .footnote { padding: 0 0 2rem; }
  .footnote p { font-size: 12px; line-height: 1.6; color: var(--text-secondary); margin: 0; }

  .focus-text :global(.text-wrap) { padding-bottom: 2rem; }
  .focus-text :global(.text-col) { text-align: left; margin: 0; max-width: 760px; }

  .tracker-section { padding: 0 0 4rem; }

  .spotlight-section { padding: 3.5rem 0 4rem; }
  .spotlight {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }
  .spotlight-text { padding: 2.5rem 40px; display: flex; flex-direction: column; justify-content: center; }
  .spotlight-text .eyebrow { font-size: var(--text-eyebrow); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-teal); margin: 0 0 1rem; }
  .spotlight-text h3 { font-size: var(--text-h4); margin: 0 0 1rem; color: var(--text-primary); line-height: 1.2; }
  .spotlight-text h3 sup { font-size: 0.4em; }
  .spotlight-facts { display: flex; flex-direction: column; gap: 1rem; margin: 0 0 1.5rem; }
  .spotlight-fact { display: flex; align-items: flex-start; gap: 12px; }
  .fact-icon { flex-shrink: 0; width: 20px; height: 20px; margin-top: 2px; color: var(--color-teal); }
  .spotlight-fact p { font-size: var(--text-body); line-height: 1.5; color: var(--text-primary); margin: 0; }
  .spotlight-text :global(.cta-link) { align-self: flex-start; }
  .spotlight img { display: block; width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 860px) {
    .spotlight { grid-template-columns: 1fr; }
    .spotlight img { min-height: 260px; }
  }
</style>
