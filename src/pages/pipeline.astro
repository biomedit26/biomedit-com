---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import Module11 from '../components/modules/Module11.astro';
import PipelineTracker from '../components/modules/PipelineTracker.astro';
import ModuleBlueText from '../components/modules/ModuleBlueText.astro';
import Button from '../components/Button.astro';
import CTALink from '../components/CTALink.astro';

const stages = [
  { eyebrow: 'Stage 1', label: 'Discovery / Design' },
  { eyebrow: 'Stage 2', label: 'Candidate Optimization' },
  { eyebrow: 'Stage 3', label: 'Proof of Concept' },
  { eyebrow: 'Stage 4', label: 'Pivotal Studies' },
  { eyebrow: 'Stage 5', label: 'Regulatory Approval / Launch Readiness' },
  { eyebrow: 'Stage 6', label: 'Commercial' },
];

const candidates = [
  { id: 'BE-117', category: 'green' as const, focus: 'AMR', stage: 1, description: "Exploratory research into non-antibiotic pathways for resistant-pathogen control, building on lessons from the platform's lead antimicrobial programs." },
  { id: 'BE-17', category: 'green' as const, focus: 'Metabolic Disease', stage: 1, description: "A next-generation approach to metabolic health, building on early signals from the platform's foundational research." },
  { id: 'BE-07', category: 'teal' as const, focus: 'AMR', stage: 2, description: "Early trial data testing whether the platform's approach can reduce reliance on antibiotics for resistant-pathogen control." },
  { id: 'BE-102', category: 'navy' as const, focus: 'Metabolic Disease', stage: 2, description: 'Initial trials evaluating impact on metabolic health markers tied to feed conversion efficiency in production animals.' },
  { id: 'BE-106', category: 'navy' as const, focus: 'Gut Health', stage: 2, description: 'Advancing through pivotal studies to confirm gut health outcomes at the scale required for commercial production settings.' },
  { id: 'BE-105', category: 'green' as const, focus: 'Methane Reduction', stage: 2, description: 'Tuning a microbiome-based approach to enteric methane reduction in cattle, balancing emissions impact against feed efficiency.' },
  { id: 'BE-01', category: 'teal' as const, focus: 'Gut Health', stage: 4, description: 'Refining strain performance to improve gut barrier integrity and nutrient absorption ahead of formal proof-of-concept trials.' },
  { id: 'BE-101', category: 'teal' as const, focus: 'Pathogen Protection', stage: 4, description: "The platform's most advanced candidate, progressing through final regulatory review ahead of commercial launch." },
  { id: 'BE-02', category: 'teal' as const, focus: 'Pathogen Protection', stage: 5, description: 'Early-stage work identifying microbial candidates that can neutralize pathogen-associated toxins before symptoms take hold in the herd or flock.' },
];
---
<FieldNotesLayout title="Pipeline" active="pipeline">
  <Module11
    variant="intro"
    headingLevel="h1"
    eyebrow="BiomEdit / Pipeline"
    heading="Making biology programmable for animal health."
    noDivider
    paragraphs={[
      "We&rsquo;re innovators. We look for measurable gaps in animal health and build the programmable biologics to close them.",
      'Every program starts with strain engineering, the foundation of our proprietary platform, and spans infectious disease, sustainability, and chronic disease therapeutics. We apply AI/ML to target selection, accelerate payload and candidate design, and we draw on our proprietary microbiome library to identify high-potential strains as starting points.',
      'The result: novel veterinary biologics that address important animal health challenges in a safe, sustainable and economically relevant manner &mdash; healthier animals, fewer antibiotics, and new tools for what matters most to protein producers and pet owners.',
    ]}
  >
    <div class="header-ctas">
      <Button color="navy" variant="filled" href="/pipeline">Explore BE-101</Button>
      <CTALink href="#">Explore Our Platform</CTALink>
    </div>
  </Module11>

  <Module11
    variant="intro"
    eyebrow="Placeholder — pending sign-off"
    heading="Our proof is in our execution."
    paragraphs={['Our lead program, BE-101, has already shown what the BiomEdit platform can do. In controlled trials, engineered strains outperformed both prophylactic antibiotics and wild-type probiotics on feed conversion and weight gain for broiler chickens, with mechanistic evidence behind the result, not just an observed outcome.']}
  >
    <CTALink href="#">Read the Research</CTALink>
  </Module11>

  <Module11 variant="intro" heading="Three focus areas. One BiomEdit platform.">
    <p>Our programmable veterinary biologics platform spans infectious disease, sustainability, and chronic disease therapeutics. We engineer bacteria to:</p>
    <ul>
      <li>deliver nanobodies, peptides, or enzymes (like the strains behind BE-101), or</li>
      <li>work together as a microbial consortium.</li>
    </ul>
    <p class="no-margin">One platform, built to pivot based on what we&rsquo;re solving for.</p>
  </Module11>

  <section class="tracker-section">
    <PipelineTracker
      stages={stages}
      candidates={candidates}
      footnote="Our programs address the needs of poultry, cattle, swine, dogs, and cats."
    />
  </section>

  <section class="spotlight-section">
    <div class="spotlight">
      <div class="spotlight-text">
        <p class="eyebrow">Featured Program — Infectious Disease</p>
        <h3>BE-101 (Optavant&trade;) is a series of firsts.</h3>
        <ul>
          <li>First programmable veterinary biologic to reach commercial launch (Q4 2026)</li>
          <li>First engineered microbial therapeutic ever to achieve licensure &mdash; in any species, in any geography, in any regulatory path</li>
        </ul>
        <CTALink href="#" tone="onDark">Learn About BE-101</CTALink>
      </div>
      <img src="/images/samples/chickens.jpg" alt="Pastured poultry raised without systemic antibiotics" />
    </div>
  </section>

  <ModuleBlueText
    heading="Interested in what&rsquo;s next for BiomEdit?"
    ctaLabel="Explore Our Platform"
    ctaHref="/home"
    secondaryCtaLabel="Partner With Us"
    secondaryCtaHref="/investors-partners"
  />
</FieldNotesLayout>

<style>
  .header-ctas { display: flex; align-items: center; gap: 28px; flex-wrap: wrap; margin-top: 0.25rem; }

  .tracker-section { padding: 0 0 4rem; }
  :global(.tracker-section p),
  :global(.tracker-section ul) { font-size: 15px; line-height: 1.75; color: var(--text-primary); }
  :global(.tracker-section ul) { padding-left: 20px; margin: 0 0 1rem; }
  :global(.tracker-section .no-margin) { margin: 0; }

  .spotlight-section { padding: 0 0 4rem; }
  .spotlight {
    background: var(--cool-800);
    border-radius: 6px;
    padding: 2.5rem 40px;
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .spotlight-text .eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-teal-dark); margin: 0 0 1rem; }
  .spotlight-text h3 { font-size: var(--text-h4); margin: 0 0 1rem; color: #FFFFFF; line-height: 1.15; }
  .spotlight-text ul { font-size: 15px; line-height: 1.75; color: var(--cool-300); margin: 0 0 1.5rem; padding-left: 20px; }
  .spotlight img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 6px; }

  @media (max-width: 860px) {
    .spotlight { grid-template-columns: 1fr; }
  }
</style>
