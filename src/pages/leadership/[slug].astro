---
import FieldNotesLayout from '../../layouts/FieldNotesLayout.astro';
import { leaders } from '../../data/leaders';

export function getStaticPaths() {
  return leaders.map((leader) => ({
    params: { slug: leader.slug },
    props: { leader },
  }));
}

const { leader } = Astro.props;
---
<FieldNotesLayout title={leader.name} active="team">
  <section class="leader-page">
    <a class="back-link" href="/team">&larr; Back to team</a>

    <div class="leader-page-grid">
      <div class="leader-page-media">
        <img src={leader.image} alt={`Portrait of ${leader.name}`} />
        {leader.linkedin && (
          <a class="leader-page-linkedin" href={leader.linkedin} target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
            LinkedIn
          </a>
        )}
      </div>
      <div class="leader-page-text">
        <h1>{leader.name}</h1>
        <p class="leader-page-title">{leader.title}</p>
        {leader.bio.map((p) => <p set:html={p} />)}
      </div>
    </div>
  </section>
</FieldNotesLayout>

<style>
  .leader-page { padding: 3rem 0 5rem; }

  .back-link {
    display: inline-flex;
    align-items: center;
    font-size: 14px;
    font-weight: 700;
    color: var(--text-secondary);
    text-decoration: none;
    margin-bottom: 2.5rem;
  }
  .back-link:hover { color: var(--color-navy); }

  .leader-page-grid { display: grid; grid-template-columns: 320px 1fr; gap: 56px; align-items: start; }

  .leader-page-media img { display: block; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: 6px; }

  .leader-page-linkedin {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 15px;
    font-weight: 700;
    color: var(--color-navy);
    text-decoration: none;
    margin-top: 1rem;
  }
  .leader-page-linkedin:hover { opacity: 0.75; }

  .leader-page-text { max-width: 65ch; }
  .leader-page-text h1 { font-size: var(--text-h5); line-height: 1.15; color: var(--text-primary); margin: 0 0 0.5rem; }
  .leader-page-title { font-size: var(--text-body); line-height: 1.4; color: var(--text-secondary); margin: 0 0 1.75rem; }
  .leader-page-text p:not(.leader-page-title) { font-size: var(--text-body); line-height: 1.6; color: var(--text-primary); margin: 0 0 1.25rem; }
  .leader-page-text p:last-child { margin-bottom: 0; }

  @media (max-width: 780px) {
    .leader-page-grid { grid-template-columns: 1fr; gap: 2rem; }
    .leader-page-media img { max-width: 320px; }
  }
</style>
