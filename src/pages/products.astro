---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import IntroLead from '../components/modules/IntroLead.astro';
import Module11 from '../components/modules/Module11.astro';
import Module21 from '../components/modules/Module21.astro';
import ModuleCards2 from '../components/modules/ModuleCards2.astro';
import ModuleSection from '../components/modules/ModuleSection.astro';
import ModuleDarkText from '../components/modules/ModuleDarkText.astro';
import ModuleBlueText from '../components/modules/ModuleBlueText.astro';
import FactList from '../components/modules/FactList.astro';
import CTALink from '../components/CTALink.astro';

const evidencePoints = [
  '<strong>+76g</strong> weight gain vs. antibiotic (p = 0.025)',
  '<strong>+81g</strong> weight gain vs. wild-type probiotic (p = 0.017)',
  '<strong>6- to 7-point improvement</strong> in feed conversion ratio at key time points',
  '<strong>Increased finished weight</strong> compared with challenged controls.',
  '<strong>Up 48% reduction in mortality</strong> according to an earlier <a href="https://www.nature.com/articles/s41522-026-00916-w" target="_blank" rel="noopener">clinical challenge model</a>.',
];

const flockFacts = [
  { value: 'Performance', valueSize: 'text' as const, paragraph: 'Better feed conversion and weight gain than prophylactic antibiotics in controlled trial conditions.' },
  { value: 'Compliance', valueSize: 'text' as const, paragraph: 'Fits antibiotic-free and no-antibiotics-ever programs.' },
  { value: 'Mechanism', valueSize: 'text' as const, paragraph: "Targets <em>C. perfringens</em> toxins directly in the gut, so broilers spend less energy on immune response and more on growth." },
  { value: 'Outcomes', valueSize: 'text' as const, paragraph: 'Improved performance, healthier birds, and reduced mortality from necrotic enteritis.' },
];
---
<FieldNotesLayout title="Products" active="products">
  <!-- How CPerf LLV* Works video (similar to the one on YouTube today) is a
       Phase 2 addition to this section — not built yet. -->
  <IntroLead
    eyebrow="BiomEdit / Products"
    heading="CPerf LLV* (BE-101) &mdash;The first-of-its-kind engineered bacteria biologic"
    paragraphs={[
      "Clostridium Perfringens Alpha Toxin and NetB Antibody Fragment, Live Limosilactobacillus Vector or CPerf LLV (BE-101) is an engineered probiotic that protects poultry from necrotic enteritis, one of the industry&rsquo;s most costly diseases. It is the first conditionally licensed product from our <a href=\"/science\">Programmable Veterinary Biologics<sup>&trade;</sup></a> platform.",
    ]}
    variant="dark"
  />

  <ModuleSection noDivider>
    <div class="problem-solution">
      <div class="problem-card">
        <p class="card-eyebrow">The problem</p>
        <div class="problem-stat">$6B</div>
        <p>Necrotic enteritis costs the poultry industry an <a href="https://www.poultryworld.net/poultry/the-true-cost-of-necrotic-enteritis/" target="_blank" rel="noopener">estimated $6B annually</a>.</p>
        <p>The shift to antibiotic-free production has made necrotic enteritis harder to control, and costlier to ignore.</p>
      </div>
      <div class="solution-card">
        <p class="card-eyebrow is-teal">The solution</p>
        <p class="solution-lead">CPerf LLV* helps protect broilers from necrotic enteritis (NE) without systemic antibiotics by neutralizing Clostridium perfringens toxins, a primary driver of NE-related disease, managing mortality and productivity losses.</p>
        <div class="solution-highlight">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"></circle><polyline points="8 12 11 15 16 9"></polyline></svg>
          <p>Now available to U.S. producers under USDA conditional license.</p>
        </div>
        <div class="solution-fact">
          <span class="fact-number">1st</span>
          <p>The first-of-its-kind engineered bacteria biologic for poultry to achieve USDA licensure.</p>
        </div>
      </div>
    </div>
  </ModuleSection>

  <Module11
    heading="What it means for broiler production."
    image={{ src: '/images/boiler-hen-in-housing-single.jpg', alt: 'Pastured poultry raised without systemic antibiotics' }}
  >
    <FactList items={flockFacts} />
  </Module11>

  <Module21
    heading="How CPerf LLV* is administered"
    columns="1fr 2fr"
    paragraphs={[
      'Two applications, and no daily protocol to manage.',
      'CPerf LLV* is applied as a spray at the hatchery. Chicks ingest the strains during natural preening, and the strains colonize the intestinal tract from there. A second dose is delivered through the water system at 14 days, maintaining protection through the growth cycle, with no continuous in-feed program to manage.',
      'The colonized strains produce and secrete protective nanobodies that neutralize C. perfringens toxins before they damage the gut wall, so healthier guts mean birds spend energy growing instead of fighting infection.',
    ]}
    image={{ src: '/images/CPerfLLV_Illustration4.png', alt: 'Diagram of the CPerf LLV mechanism in the gut' }}
  />

  <Module11
    heading="The Evidence"
    paragraphs={['In a controlled 43-day trial, poultry treated with CPerf LLV*&rsquo;s engineered strains outperformed both prophylactic antibiotics and wild-type probiotics on feed conversion and weight gain, with mechanistic evidence of reduced immune activation and oxidative stress.']}
    image={{ src: '/images/healthy-chicken.jpg', alt: 'Healthy broiler protected by CPerf LLV' }}
  >
    <div class="evidence-grid">
      {evidencePoints.map((point) => (
        <div class="evidence-card">
          <p set:html={point} />
        </div>
      ))}
    </div>
    <div class="evidence-cta"><CTALink href="https://www.nature.com/articles/s41522-026-00916-w" target="_blank">Read the full study</CTALink></div>
  </Module11>

  <!-- NEW quote, sourced from Aaron's public remarks in BiomEdit's Series B
       funding announcement (July 2025) &mdash; distinct from the homepage's
       "engineered microbial therapeutics in all species" quote. Confirm with
       Aaron that this remains accurate given where CPerf LLV* has progressed
       since the original announcement. -->
  <ModuleDarkText
    quote
    noDivider
    topDivider
    paragraphs={['&ldquo;This is an exciting chapter for BiomEdit. We are bringing a transformational poultry solution to U.S. broiler producers and pushing the frontiers of sustainable livestock production.&rdquo;']}
    attribution="Aaron Schacht, CEO, BiomEdit"
    photos={[
      { src: '/images/082626_BiomEdit_121.jpg', alt: 'BiomEdit scientists examining lab equipment', ratio: '3/2' },
      { src: '/images/082626_BiomEdit_011.jpg', alt: 'Automated pipetting system processing samples in the lab', ratio: '2/3' },
    ]}
  />

  <Module11 variant="intro" heading="Other products in our pipeline">
    <ModuleCards2
      bare
      headingLevel="h3"
      cardLeft={{
        heading: 'BE-105 | Obesity & Diabetes (Cats)',
        paragraphs: ['Oral biologic for chronic weight management and metabolic health and first demonstration that microbial biologics can potentially deliver systemic peptide pharmacology.'],
        image: { src: '/images/reinis-bruzitis-aR0nwx0b950-unsplash.jpg', alt: 'Cat' },
      }}
      cardRight={{
        heading: 'BE-122 | Inflammatory Bowel Disease (Dogs)',
        paragraphs: ['Oral biologic to help treat inflammatory bowel disease (IBD) in dogs, offering a potential alternative or complement to chronic corticosteroid therapy.'],
        image: { src: '/images/pauline-loroy-U3aF7hgUSrk-unsplash.jpg', alt: 'Dog' },
      }}
    />
    <CTALink href="/pipeline">Explore our pipeline</CTALink>
  </Module11>

  <section class="legal-disclaimer section-divider">
    <p>The subject product is licensed conditionally by USDA for the passive immunity of healthy chicks against Clostridium perfringens. Conditional licensure permits commercialization while additional effectiveness data continue to be developed in accordance with USDA requirements. Product use is limited to the approved label and indications. The subject product is covered by one or more U.S. patents, including U.S. Patent Nos. 12,599,637 and 12,427,174. Additional U.S. and foreign patents may be pending. BiomEdit&trade; and Optavant&trade; are trademarks of BiomEdit, Inc.</p>
  </section>

  <section class="footnote">
    <p>*Clostridium Perfringens Alpha Toxin and NetB Antibody Fragment, Live Limosilactobacillus Vector</p>
  </section>

  <ModuleBlueText
    heading="Curious what&rsquo;s next after CPerf LLV*?"
    ctaLabel="View our full pipeline"
    ctaHref="/pipeline"
    secondaryCtaLabel="Learn about our science"
    secondaryCtaHref="/science"
    noDivider
    image="/images/jonakoh-_-NPDRGf0w1lw-unsplash.jpg"
    zoom={1.05}
    imagePosition="50% 50%"
    blendMode="overlay"
    imageOpacity={0.45}
  />
</FieldNotesLayout>

<style>
  .section-divider { border-top: 1px solid var(--cool-500); }

  .legal-disclaimer { padding: 2rem 0 3rem; }
  .legal-disclaimer p { font-size: 12px; line-height: 1.6; color: var(--text-secondary); margin: 0; }

  .footnote { padding: 0 0 2rem; }
  .footnote p { font-size: 12px; line-height: 1.6; color: var(--text-secondary); margin: 0; }

  .evidence-grid { display: flex; flex-direction: column; gap: 1rem; margin-top: 2rem; }
  .evidence-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 1.25rem 1.75rem;
    text-align: left;
  }
  .evidence-card p { font-size: var(--text-body); line-height: 1.5; color: var(--text-secondary); margin: 0; }
  .evidence-card p strong { color: var(--text-primary); }

  .evidence-cta { margin-top: 2.5rem; }

  .problem-solution { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; align-items: stretch; padding: 0 0 4rem; }

  .card-eyebrow { font-size: var(--text-eyebrow); font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-navy-dark); margin: 0 0 1rem; }
  .card-eyebrow.is-teal { color: var(--color-teal); }

  .problem-card {
    background: var(--color-navy);
    border-radius: 6px;
    padding: 2.5rem 36px;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
  }
  .problem-stat { font-size: var(--text-h3); font-weight: 700; line-height: 1; color: #FFFFFF; margin: 0 0 1rem; }
  .problem-card p { font-size: var(--text-body); line-height: 1.5; color: var(--cool-300); margin: 0 0 1rem; }
  .problem-card p a { color: inherit; }
  .problem-card p:last-child { margin-bottom: 0; }

  .solution-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    padding: 2.5rem 36px;
    display: flex;
    flex-direction: column;
    justify-content: center;
  }
  .solution-lead { font-size: 19px; font-weight: 500; line-height: 1.55; color: var(--text-primary); margin: 0 0 1.5rem; }
  .solution-highlight, .solution-fact { display: flex; align-items: flex-start; gap: 12px; }
  .solution-highlight {
    background: var(--bg-tertiary);
    border-radius: 6px;
    padding: 14px 18px;
    margin: 0 0 1.25rem;
  }
  .solution-highlight svg { flex-shrink: 0; width: 20px; height: 20px; margin-top: 2px; color: var(--color-green); }
  .solution-highlight p { font-weight: 700; color: var(--text-primary); margin: 0; }
  .fact-number {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--color-navy);
    color: #FFFFFF;
    font-size: 12px;
    font-weight: 700;
    text-transform: uppercase;
  }
  .solution-fact p { color: var(--text-secondary); margin: 0; }

  @media (max-width: 860px) {
    .problem-solution { grid-template-columns: 1fr; gap: 1.5rem; }
  }
</style>
