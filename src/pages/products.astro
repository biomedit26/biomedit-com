---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import Module11 from '../components/modules/Module11.astro';
import Module21 from '../components/modules/Module21.astro';
import ModuleBlueText from '../components/modules/ModuleBlueText.astro';
import CTALink from '../components/CTALink.astro';
---
<FieldNotesLayout title="Products" active="products">
  <Module11
    variant="intro"
    headingLevel="h1"
    eyebrow="BiomEdit / Products"
    heading="The first of any kind."
    noDivider
    paragraphs={[
      'BE-101 (Optavant&trade;) is the first engineered microbial therapeutic to achieve licensure, in any species, any geography, any regulatory pathway.',
      "BE-101 is an engineered probiotic strain that protects poultry from necrotic enteritis, one of the industry's most costly diseases, without systemic antibiotics.",
    ]}
  />

  <section class="stat-callout section-divider">
    <p class="stat-value">$6B</p>
    <p class="stat-label">Estimated annual cost of necrotic enteritis to the poultry industry.</p>
  </section>

  <Module21
    heading="How BE-101 works"
    paragraphs={['The strain is engineered to produce and secrete nanobodies that neutralize the C. perfringens toxins responsible for necrotic enteritis, delivered directly in the gut.']}
    image={{ src: '/images/boiler-hen-in-housing-single.jpg', alt: 'Pastured poultry raised without systemic antibiotics' }}
  />

  <section class="evidence section-divider">
    <div class="evidence-card">
      <div class="evidence-text">
        <p class="eyebrow">The Evidence</p>
        <p class="evidence-body">In a controlled 43-day trial, poultry treated with BE-101&rsquo;s engineered strains outperformed both prophylactic antibiotics and wild-type probiotics on feed conversion and weight gain, with mechanistic evidence of reduced immune activation and oxidative stress.</p>
        <blockquote class="pull-quote">
          <p>&ldquo;This is an exciting chapter for BiomEdit. We are bringing a transformational poultry solution to U.S. broiler producers and pushing the frontiers of sustainable livestock production.&rdquo;</p>
          <cite>Aaron Schacht, CEO, BiomEdit</cite>
        </blockquote>
        <CTALink href="#" tone="onDark">Read the Full Study</CTALink>
      </div>
      <div class="evidence-image">
        <img src="/images/samples/lab-work.jpg" alt="BiomEdit scientist at work in the lab" />
      </div>
    </div>
  </section>

  <ModuleBlueText
    heading="Curious what&rsquo;s next after BE-101?"
    ctaLabel="Explore the Pipeline"
    ctaHref="/pipeline"
    secondaryCtaLabel="Explore Our Science"
    secondaryCtaHref="/science"
  />
</FieldNotesLayout>

<style>
  .section-divider { border-top: 1px solid var(--cool-500); }

  /* ---------- stat callout ---------- */
  .stat-callout { padding: 3rem 0; text-align: center; }
  .stat-value { font-size: var(--text-h2); font-weight: 700; color: var(--color-amber); line-height: 1; margin: 0 0 1rem; }
  .stat-label { font-size: 15px; color: var(--text-primary); margin: 0 auto; max-width: 420px; }

  /* ---------- evidence / pull quote ---------- */
  .evidence { padding: 0 0 4rem; }
  .evidence-card {
    background: var(--cool-800);
    border-radius: 6px;
    overflow: hidden;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: stretch;
  }
  .evidence-text { padding: 3.5rem 48px; display: flex; flex-direction: column; justify-content: center; }
  .evidence-text .eyebrow { font-size: 11px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; color: var(--color-teal-dark); margin: 0 0 1.25rem; }
  .evidence-body { font-size: 15px; line-height: 1.75; color: var(--cool-300); margin: 0 0 2rem; }
  .pull-quote { margin: 0 0 2rem; padding: 0; border: none; }
  .pull-quote p {
    font-family: 'Fraunces', serif;
    font-style: italic;
    font-weight: 500;
    font-size: 26px;
    line-height: 1.45;
    color: #FFFFFF;
    margin: 0 0 1rem;
  }
  .pull-quote cite { font-size: 13px; font-style: normal; color: var(--cool-400); }
  .evidence-image { height: 100%; min-height: 420px; }
  .evidence-image img { display: block; width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 860px) {
    .evidence-card { grid-template-columns: 1fr; }
    .evidence-image { min-height: 260px; order: -1; }
    .evidence-text { padding: 2.5rem 28px; }
  }
</style>
