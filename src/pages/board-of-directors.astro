---
import FieldNotesLayout from '../layouts/FieldNotesLayout.astro';
import IntroLead from '../components/modules/IntroLead.astro';
import ModuleBlueText from '../components/modules/ModuleBlueText.astro';

const board = [
  {
    name: 'Paul Casady',
    title: 'Brakke Consulting. Former executive at Merial (Boehringer Ingelheim) and Intervet/Schering-Plough (Merck).',
    image: '/images/bod/paul-casady.jpg',
    linkedin: 'https://www.linkedin.com/in/paul-casady-28931245/',
  },
  {
    name: 'Patrick James',
    title: 'Chairman. Former Chairman and CEO of Micronutrients at The Heritage Group.',
    image: '/images/bod/patrick-james.jpg',
    linkedin: 'https://www.linkedin.com/in/patrick-james-a24569b5/',
  },
  {
    name: 'Aaron Schacht',
    title: 'CEO, BiomEdit. Former executive at Eli Lilly and Company, Elanco Animal Health.',
    image: '/images/bod/aaron-schacht.jpg',
    linkedin: 'https://www.linkedin.com/in/aaronlschacht/',
  },
  {
    name: 'Barbara Bodem',
    title: 'Former CFO, Dentsply Sirona and Hillrom.',
    image: '/images/bod/barbara-bodem.jpg',
    linkedin: 'https://www.linkedin.com/in/barbara-bodem/',
  },
  {
    name: 'Brett Wong',
    title: 'Principal, Anterra Capital.',
    image: '/images/bod/brett-wong.jpg',
    linkedin: 'https://www.linkedin.com/in/brett-wong-41279225/',
  },
];
---
<FieldNotesLayout title="Board of Directors" active="board">
  <IntroLead
    eyebrow="BiomEdit / Board of Directors"
    heading="Experienced leadership guiding a new category"
    paragraphs={['BiomEdit’s board brings together decades of experience in animal health, life sciences, investment, and executive leadership. Their guidance helps translate our Programmable Veterinary Biologics<sup>&trade;</sup> platform into meaningful impact for animals, farmers and veterinarians.']}
    variant="dark"
  />

  <section class="board-roster section-divider">
    <div class="board-grid">
      {board.map((member) => (
        <div class="board-card">
          <img class="board-photo" src={member.image} alt={`Headshot of ${member.name}`} loading="lazy" />
          <div class="board-info">
            <h3>{member.name}</h3>
            <p class="board-title">{member.title}</p>
            {member.linkedin && (
              <a class="board-linkedin" href={member.linkedin} target="_blank" rel="noopener">
                <svg viewBox="0 0 24 24" width="14" height="14" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.446-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"></path></svg>
                LinkedIn
              </a>
            )}
          </div>
        </div>
      ))}
    </div>
  </section>

  <ModuleBlueText
    heading="Interested in what&rsquo;s next for BiomEdit?"
    ctaLabel="Explore our pipeline"
    ctaHref="/pipeline"
    ctaStyle="button"
    secondaryCtaLabel="Partner with us"
    secondaryCtaHref="/contact-us"
    image="/images/jonakoh-_-NPDRGf0w1lw-unsplash.jpg"
    zoom={1.05}
    imagePosition="50% 50%"
    blendMode="overlay"
    imageOpacity={0.45}
    noDivider
  />
</FieldNotesLayout>

<style>
  .section-divider { border-top: 1px solid var(--cool-500); }

  .board-roster { padding: 3.5rem 0 4rem; }

  .board-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 24px; }

  .board-card {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 6px;
    overflow: hidden;
  }
  .board-photo { display: block; width: 100%; aspect-ratio: 1 / 1; object-fit: cover; }
  .board-info { padding: 16px; }
  .board-card h3 { font-size: 15px; margin: 0 0 0.35rem; }
  .board-title { font-size: 13px; line-height: 1.45; color: var(--text-secondary); margin: 0 0 0.75rem; }

  .board-linkedin {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 13px;
    font-weight: 700;
    color: var(--color-navy);
    text-decoration: none;
  }
  .board-linkedin:hover { opacity: 0.75; }

  @media (max-width: 900px) {
    .board-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 600px) {
    .board-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 420px) {
    .board-grid { grid-template-columns: 1fr; }
  }
</style>
